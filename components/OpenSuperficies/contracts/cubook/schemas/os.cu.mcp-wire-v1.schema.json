    "jsonrpc",
    "result"
   ],
   "type": "object"
  },
  {
   "additionalProperties": false,
   "properties": {
    "error": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "enum": [
        -32700,
        -32600,
        -32601
       ]
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "message"
     ],
     "type": "object"
    },
    "id": {},
    "jsonrpc": {
     "const": "2.0"
    }
   },
   "required": [
    "error",
    "id",
    "jsonrpc"
   ],
   "type": "object"
  }
 ]
}
