{
  "schema": "os.cu.astallow/v1",
  "nodes": ["Module", "Expr", "Assign", "AugAssign", "For", "If", "Pass", "Break", "Continue", "Import", "ImportFrom", "alias",
    "Name", "Load", "Store", "Constant", "Attribute", "Call", "keyword", "Tuple", "List", "Dict", "BinOp", "UnaryOp", "BoolOp",
    "Compare", "Subscript", "Slice", "Index", "IfExp", "ListComp", "comprehension",
    "Add", "Sub", "Mult", "Div", "FloorDiv", "Mod", "MatMult", "USub", "UAdd", "Not", "And", "Or",
    "Eq", "NotEq", "Lt", "LtE", "Gt", "GtE", "Is", "IsNot", "In", "NotIn"],
  "modules": ["bpy", "math", "mathutils"],
  "from_import": {"mathutils": ["Vector", "Euler", "Matrix", "Quaternion"], "math": ["*"]},
  "builtins": ["range", "len", "min", "max", "abs", "round", "int", "float", "bool", "tuple", "list", "dict"],
  "chain_any": ["bpy.data", "bpy.context", "math", "mathutils.Vector", "mathutils.Euler", "mathutils.Matrix", "mathutils.Quaternion"],
  "chain_min2": ["bpy.data", "bpy.context"],
  "chain_deeper": ["bpy.ops.mesh", "bpy.ops.object", "bpy.ops.render", "bpy.ops.export_scene", "bpy.ops.transform", "bpy.ops.wm"],
  "wm_deny_prefix": ["addon_", "open_", "read_", "recover_", "revert_", "python_", "script_", "append", "link", "lib",
    "save_userpref", "save_homefile", "alembic_", "collada_", "usd_", "obj_", "ply_", "stl_"],
  "attr_deny": ["as_module", "texts", "libraries", "use_scripts", "use_scripts_auto_execute", "handlers", "app", "utils", "addons",
    "preferences", "open_mainfile", "read_homefile", "execfile", "load_scripts", "register_submodule_factory", "python_file_run",
    "run_script", "addon_utils", "register_class", "unregister_class"],
  "kw_deny": ["use_scripts", "files"],
  "str_deny": ["filepath", "filename", "directory", "use_scripts", "path", "libpath", "filepath_raw"],
  "path_kwargs": ["filepath", "filename", "directory", "path", "libpath", "filepath_raw"],
  "path_calls": ["load", "save", "save_render", "write", "export", "save_as_mainfile", "save_mainfile", "pack", "unpack",
    "fbx", "gltf", "obj", "alembic_export", "usd_export", "collada_export", "obj_export", "ply_export", "stl_export"],
  "max_bytes": 262144,
  "max_nodes": 20000
}
