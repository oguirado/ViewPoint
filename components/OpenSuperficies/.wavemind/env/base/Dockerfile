FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS fetch
ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
RUN rm -f /etc/apt/sources.list.d/* && printf '%s\n' 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261001T000000Z/ bookworm main' > /etc/apt/sources.list && apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils unzip && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/toolchains /opt/debs /opt/downloads
RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --output '/opt/debs/blender_3.4.1+dfsg-2+b1_arm64.deb' 'https://snapshot.debian.org/archive/debian/20261001T000000Z/pool/main/b/blender/blender_3.4.1+dfsg-2+b1_arm64.deb' && printf '%s\n' '7a6ac9eb675f419a8d8b9fa13aeb8a868e2dee6fa62d7e1e285464b86f1007c2  /opt/debs/blender_3.4.1+dfsg-2+b1_arm64.deb' | sha256sum -c -
RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --output '/opt/debs/build-essential_12.9_arm64.deb' 'https://snapshot.debian.org/archive/debian/20261001T000000Z/pool/main/b/build-essential/build-essential_12.9_arm64.deb' && printf '%s\n' 'cb14b62d98e911ae8cb32248f9f46de50cc09d46ec9dcb3b9bfda1ff2e0abf49  /opt/debs/build-essential_12.9_arm64.deb' | sha256sum -c -
RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --output '/opt/debs/cmake_3.25.1-1_arm64.deb' 'https://snapshot.debian.org/archive/debian/20261001T000000Z/pool/main/c/cmake/cmake_3.25.1-1_arm64.deb' && printf '%s\n' '457c1e246b50bbfc2cd6f0f0d1da09889c8bc24677b9acb8946c4c778eaa74e5  /opt/debs/cmake_3.25.1-1_arm64.deb' | sha256sum -c -
RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --output '/opt/downloads/go1.26.0.linux-arm64.tar.gz' 'https://go.dev/dl/go1.26.0.linux-arm64.tar.gz' && printf '%s\n' 'bd03b743eb6eb4193ea3c3fd3956546bf0e3ca5b7076c8226334afe6b75704cd  /opt/downloads/go1.26.0.linux-arm64.tar.gz' | sha256sum -c -
RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --output '/opt/downloads/Godot_v4.4.1-stable_linux.arm64.zip' 'https://github.com/godotengine/godot/releases/download/4.4.1-stable/Godot_v4.4.1-stable_linux.arm64.zip' && printf '%s\n' '07e170b208f91a5bd663fae40f2731fdba1ee3380e4fea90a0d0131e0d3522df  /opt/downloads/Godot_v4.4.1-stable_linux.arm64.zip' | sha256sum -c -
RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --output '/opt/downloads/node-v22.16.0-linux-arm64.tar.xz' 'https://nodejs.org/dist/v22.16.0/node-v22.16.0-linux-arm64.tar.xz' && printf '%s\n' 'eab80cb88f8fda1e65f5e8d0420c9809bdb320b03fd34976ab7161b6e703b910  /opt/downloads/node-v22.16.0-linux-arm64.tar.xz' | sha256sum -c -
RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --output '/opt/debs/python3-pip_23.0.1+dfsg-1_all.deb' 'https://snapshot.debian.org/archive/debian/20261001T000000Z/pool/main/p/python-pip/python3-pip_23.0.1+dfsg-1_all.deb' && printf '%s\n' 'd8024ededc6c7fe941ca96aabebdcf2d846fd130eae9d66aad1aa32a84454291  /opt/debs/python3-pip_23.0.1+dfsg-1_all.deb' | sha256sum -c -
RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --output '/opt/debs/pkg-config_1.8.1-1_arm64.deb' 'https://snapshot.debian.org/archive/debian/20261001T000000Z/pool/main/p/pkgconf/pkg-config_1.8.1-1_arm64.deb' && printf '%s\n' '9fa52c7b352fec0bfdb4cfb17f64bb17939207e04c88022635f43a8c9ad2fc11  /opt/debs/pkg-config_1.8.1-1_arm64.deb' | sha256sum -c -
RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --output '/opt/debs/python3-venv_3.11.2-1+b1_arm64.deb' 'https://snapshot.debian.org/archive/debian/20261001T000000Z/pool/main/p/python3-defaults/python3-venv_3.11.2-1+b1_arm64.deb' && printf '%s\n' '9e56023bb7ea5f65b6c491cf6efeee17fc26d2bd25dae58a1845262e134d0010  /opt/debs/python3-venv_3.11.2-1+b1_arm64.deb' | sha256sum -c -
RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --output '/opt/downloads/rust-1.85.1-aarch64-unknown-linux-gnu.tar.xz' 'https://static.rust-lang.org/dist/rust-1.85.1-aarch64-unknown-linux-gnu.tar.xz' && printf '%s\n' '6945d648b19f62052ee619b05e79e8ab8a2e18b5d5310c6c0899d552669ee61b  /opt/downloads/rust-1.85.1-aarch64-unknown-linux-gnu.tar.xz' | sha256sum -c -
RUN curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --output '/opt/debs/tini_0.19.0-1+b3_arm64.deb' 'https://snapshot.debian.org/archive/debian/20261001T000000Z/pool/main/t/tini/tini_0.19.0-1+b3_arm64.deb' && printf '%s\n' '335dee1e36c0bf61f11c9fe9740012966a3183bd50405b73ed19477293c28f7f  /opt/debs/tini_0.19.0-1+b3_arm64.deb' | sha256sum -c -
RUN tar -xzf /opt/downloads/go1.26.0.linux-arm64.tar.gz -C /opt/toolchains && mkdir /opt/toolchains/node && tar -xJf /opt/downloads/node-v22.16.0-linux-arm64.tar.xz --strip-components=1 -C /opt/toolchains/node
RUN mkdir /opt/downloads/rust && tar -xJf /opt/downloads/rust-1.85.1-aarch64-unknown-linux-gnu.tar.xz --strip-components=1 -C /opt/downloads/rust && /opt/downloads/rust/install.sh --prefix=/opt/toolchains/rust --without=rust-docs --disable-ldconfig
RUN unzip -q /opt/downloads/Godot_v4.4.1-stable_linux.arm64.zip -d /opt/toolchains && mv /opt/toolchains/Godot_v4.4.1-stable_linux.arm64 /opt/toolchains/godot
COPY base/w8runner/ /runner/
RUN cd /runner && mkdir -p /opt/w8 && CGO_ENABLED=0 GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off /opt/toolchains/go/bin/go build -trimpath -buildvcs=false -ldflags='-s -w -buildid=' -o /opt/w8/ingest main.go process.go probes.go text.go extract.go && for verb in gate status extract purge; do cp /opt/w8/ingest /opt/w8/$verb; done && chmod 0555 /opt/w8/*
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS runtime
ARG SOURCE_DATE_EPOCH
COPY --from=fetch opt/toolchains /opt/toolchains
COPY --from=fetch opt/debs /opt/debs
COPY --from=fetch --chmod=0555 opt/w8 /opt/w8
RUN rm -f /etc/apt/sources.list.d/* && printf '%s\n' 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261001T000000Z/ bookworm main' > /etc/apt/sources.list && apt-get update && apt-get install -y --no-install-recommends /opt/debs/*.deb procps git jq ca-certificates python3 util-linux && rm -rf /opt/debs /var/log/* /var/cache/ldconfig/aux-cache /var/lib/apt/lists/*
RUN ln -s /opt/toolchains/go/bin/go /usr/local/bin/go && ln -s /opt/toolchains/go/bin/gofmt /usr/local/bin/gofmt && for x in node npm npx; do ln -s /opt/toolchains/node/bin/$x /usr/local/bin/$x; done && for x in rustc cargo rustdoc; do ln -s /opt/toolchains/rust/bin/$x /usr/local/bin/$x; done && ln -s /opt/toolchains/godot /usr/local/bin/godot
RUN groupadd --gid 10001 worker && useradd --uid 10001 --gid 10001 --home-dir /home/worker --shell /usr/sbin/nologin worker && mkdir -p /opt/w8 /opt/cache /workspace /home/worker && chown 10001:10001 /home/worker /workspace && chmod 0770 /workspace
COPY --chmod=0555 base/assert.sh /usr/local/libexec/w8-assert
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LC_ALL=C.UTF-8 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 TINI_SUBREAPER=1 GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/true GOTOOLCHAIN=local GOFLAGS=-mod=mod GOMODCACHE=/opt/cache/gomod GOCACHE=/workspace/.cache/go-build CARGO_HOME=/opt/cache/cargo CARGO_NET_OFFLINE=true PIP_NO_INDEX=1 HOME=/home/worker TMPDIR=/tmp
RUN runuser -u worker -- env GOTELEMETRY=off /usr/local/libexec/w8-assert && ldconfig && rm -rf /var/cache/* /var/log/* /var/lib/apt/lists/* /home/worker/.config /home/worker/.cache /root/.bashrc /root/.profile
USER 10001:10001
ENTRYPOINT ["/usr/bin/tini","-s","--"]
CMD ["/usr/bin/sleep","infinity"]
