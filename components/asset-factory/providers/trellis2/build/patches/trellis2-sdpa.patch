+def _seqlen_segment_ids(seqlen: Union[List[int], torch.Tensor], device: torch.device) -> torch.Tensor:
+    """Map each packed token to the index of the sequence it belongs to: [T] int64."""
+    seqlen = torch.as_tensor(seqlen, device=device, dtype=torch.long)
+    return torch.repeat_interleave(torch.arange(seqlen.numel(), device=device), seqlen)
+
+
+def _block_diag_attn_mask(q_seqlen, kv_seqlen, device) -> torch.Tensor:
+    """Boolean block-diagonal mask [T_Q, T_KV]; True where q-token and kv-token share a sequence."""
+    q_seg = _seqlen_segment_ids(q_seqlen, device)      # [T_Q]
+    kv_seg = _seqlen_segment_ids(kv_seqlen, device)    # [T_KV]
+    return q_seg[:, None] == kv_seg[None, :]
+
+
+def _sdpa_varlen(q, k, v, q_seqlen, kv_seqlen, mode: str) -> torch.Tensor:
+    """
+    SDPA fallback over varlen-packed tensors (no padding), matching the flash_attn varlen contract.
+
+    Inputs are packed [T_Q, H, Ci] / [T_KV, H, Ci] / [T_KV, H, Co]; returns packed [T_Q, H, Co].
+    `F.scaled_dot_product_attention` expects [B, H, L, E] and applies the default scale
+    1/sqrt(E) (E = head_dim = last dim) — identical to flash_attn's default 1/sqrt(head_dim),
+    so no explicit `scale=` is needed. qk_rms_norm (dim**0.5 * F.normalize, applied in
+    modules.py BEFORE this call) scales q and k for every backend equally, so it does not
+    change the flash<->sdpa parity. Input dtype (BF16/FP16) is preserved end-to-end.
+    """
+    if mode == 'naive':
+        # Per-sequence reference path: O(sum Li^2), no large mask materialized.
+        outs = []
+        q_off = kv_off = 0
+        q_seqlen = [int(x) for x in q_seqlen]
+        kv_seqlen = [int(x) for x in kv_seqlen]
+        for ql, kvl in zip(q_seqlen, kv_seqlen):
+            qi = q[q_off:q_off + ql].transpose(0, 1).unsqueeze(0)      # [1, H, ql, Ci]
+            ki = k[kv_off:kv_off + kvl].transpose(0, 1).unsqueeze(0)   # [1, H, kvl, Ci]
+            vi = v[kv_off:kv_off + kvl].transpose(0, 1).unsqueeze(0)   # [1, H, kvl, Co]
+            oi = F.scaled_dot_product_attention(qi, ki, vi)           # [1, H, ql, Co]
+            outs.append(oi.squeeze(0).transpose(0, 1))                # [ql, H, Co]
+            q_off += ql
+            kv_off += kvl
+        return torch.cat(outs, dim=0)                                 # [T_Q, H, Co]
+    else:  # 'sdpa' — vectorized, batch=1 with a block-diagonal mask
+        mask = _block_diag_attn_mask(q_seqlen, kv_seqlen, q.device)   # [T_Q, T_KV] bool
+        qf = q.transpose(0, 1).unsqueeze(0)                           # [1, H, T_Q, Ci]
+        kf = k.transpose(0, 1).unsqueeze(0)                           # [1, H, T_KV, Ci]
+        vf = v.transpose(0, 1).unsqueeze(0)                           # [1, H, T_KV, Co]
+        out = F.scaled_dot_product_attention(qf, kf, vf, attn_mask=mask)  # [1, H, T_Q, Co]
+        return out.squeeze(0).transpose(0, 1)                         # [T_Q, H, Co]
+
+
 @overload
