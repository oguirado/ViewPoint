         out = flash_attn_3.flash_attn_varlen_func(q, k, v, cu_seqlens_q, cu_seqlens_kv, max_q_seqlen, max_kv_seqlen)
+    elif config.ATTN in ('sdpa', 'naive'):
+        # Native torch fallback for sm_121 / no-flash_attn environments (GAP-2). Unpack the
+        # fused forms exactly as the flash_attn branch does, then run varlen SDPA.
+        if num_all_args == 1:
+            q, k, v = qkv.unbind(dim=1)     # [T, H, C] each
+        elif num_all_args == 2:
+            k, v = kv.unbind(dim=1)         # [T_KV, H, C] each
+        out = _sdpa_varlen(q, k, v, q_seqlen, kv_seqlen, config.ATTN)
     else:
         raise ValueError(f"Unknown attention module: {config.ATTN}")
     
