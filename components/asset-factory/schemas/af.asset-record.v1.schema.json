          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "licence_expression": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "licence_text_digest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "provenance_digest": {
          "$ref": "#/$defs/digest"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "territory_excluded": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "subject_digest",
        "component",
        "licence_expression",
        "licence_text_digest",
        "provenance_digest",
        "commercial",
        "territory_excluded",
        "gated",
        "absence_reason"
      ],
      "type": "object"
    },
    "socket": {
      "additionalProperties": false,
      "properties": {
        "allowed_peer_roles": {
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "fit_receipt_digest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "frame": {
          "$ref": "#/$defs/transform"
        },
        "id": {
          "$ref": "#/$defs/key"
        },
        "mating_dimensions_um": {
          "$ref": "#/$defs/positiveVector"
        },
        "mating_type": {
          "enum": [
            "fixed",
            "hinge",
            "ball_socket",
            "threaded",
            "clamp",
            "surface_seam",
            "keyed"
          ]
        },
        "polarity": {
          "enum": [
            "plug",
            "receptacle",
            "neutral"
          ]
        },
        "profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "semantic_role": {
          "$ref": "#/$defs/key"
        }
      },
      "required": [
        "id",
        "semantic_role",
        "frame",
        "mating_type",
        "polarity",
        "profile_digest",
        "mating_dimensions_um",
        "allowed_peer_roles",
        "fit_receipt_digest"
      ],
      "type": "object"
    },
    "symmetry": {
      "additionalProperties": false,
      "properties": {
        "absence_reason": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "counterpart_record_digest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "kind": {
          "enum": [
            "none",
            "bilateral",
            "radial",
            "unknown"
          ]
        },
        "plane_normal_axis": {
          "oneOf": [
            {
              "enum": [
                "x",
                "y",
                "z"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "plane_offset_um": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "radial_order": {
          "oneOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_digest": {
          "$ref": "#/$defs/nullableDigest"
        }
      },
      "required": [
        "kind",
        "plane_normal_axis",
        "plane_offset_um",
        "radial_order",
        "counterpart_record_digest",
        "receipt_digest",
        "absence_reason"
      ],
      "type": "object"
    },
    "texture": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "channel": {
                "enum": [
                  "normal",
                  "orm",
                  "roughness",
                  "metallic",
                  "occlusion",
                  "displacement",
                  "opacity"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "color_space": {
                "const": "linear"
              }
            }
          }
        }
      ],
      "properties": {
        "channel": {
          "enum": [
            "base_color",
            "normal",
            "orm",
            "roughness",
            "metallic",
            "occlusion",
            "emission",
            "displacement",
            "opacity"
          ]
        },
        "channel_layout": {
          "minLength": 1,
          "type": "string"
        },
        "color_space": {
          "enum": [
            "srgb",
            "linear"
          ]
        },
        "file_digest": {
          "$ref": "#/$defs/digest"
        },
        "uv_set": {
          "$ref": "#/$defs/key"
        }
      },
      "required": [
        "channel",
        "file_digest",
        "color_space",
        "uv_set",
        "channel_layout"
      ],
      "type": "object"
    },
    "transform": {
      "additionalProperties": false,
      "properties": {
        "rotation_xyzw_ppm": {
          "$ref": "#/$defs/quaternion"
        },
        "translation_um": {
          "$ref": "#/$defs/position"
        },
        "uniform_scale_ppm": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "translation_um",
        "rotation_xyzw_ppm",
        "uniform_scale_ppm"
      ],
      "type": "object"
    },
    "uncertainty": {
      "additionalProperties": false,
      "properties": {
        "confidence_ppm": {
          "oneOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "lower": {
          "type": "integer"
        },
        "method_digest": {
          "$ref": "#/$defs/digest"
        },
        "upper": {
          "type": "integer"
        }
      },
      "required": [
        "lower",
        "upper",
        "confidence_ppm",
        "method_digest"
      ],
      "type": "object"
    },
    "view": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_kind": {
                "const": "external_refinement"
              }
            }
          },
          "then": {
            "properties": {
              "parent_image_digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      ],
      "properties": {
        "alpha_derivative_digest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "background": {
          "enum": [
            "neutral_grey",
            "transparent"
          ]
        },
        "camera_digest": {
          "$ref": "#/$defs/digest"
        },
        "frame_identity_digest": {
          "$ref": "#/$defs/digest"
        },
        "id": {
          "enum": [
            "front",
            "front34_left",
            "left",
            "back",
            "right",
            "front34_right",
            "top",
            "face_front",
            "face_left",
            "hands",
            "materials"
          ]
        },
        "image_digest": {
          "$ref": "#/$defs/digest"
        },
        "parent_image_digest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "receipt_digests": {
          "items": {
            "$ref": "#/$defs/digest"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_kind": {
          "enum": [
            "blender",
            "external_refinement"
          ]
        }
      },
      "required": [
        "id",
        "image_digest",
        "camera_digest",
        "frame_identity_digest",
        "source_kind",
        "parent_image_digest",
        "background",
        "alpha_derivative_digest",
        "receipt_digests"
      ],
      "type": "object"
    }
  },
  "$id": "urn:af:asset-record:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "const": "humanoid"
          }
        }
      },
      "then": {
        "properties": {
          "taxonomy_path": {
            "pattern": "^humanoid/"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "creature"
          }
        }
      },
      "then": {
        "properties": {
          "taxonomy_path": {
            "pattern": "^creature/"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "prop"
          }
        }
      },
      "then": {
        "properties": {
          "taxonomy_path": {
            "pattern": "^prop/"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "vehicle"
          }
        }
      },
      "then": {
        "properties": {
          "taxonomy_path": {
            "pattern": "^vehicle/"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "environment"
          }
        }
      },
      "then": {
        "properties": {
          "taxonomy_path": {
            "pattern": "^environment/"
          }
        }
      }
    }
  ],
  "properties": {
    "annotations": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "canonical_profile": {
      "const": "af.integer-json-lf/v1"
    },
    "category": {
      "enum": [
        "humanoid",
        "creature",
        "prop",
        "vehicle",
        "environment"
      ]
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "coordinate_frame": {
      "const": "RH_Z_UP_FRONT_NEG_Y_UM"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/digest"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "dimensions": {
      "$ref": "#/$defs/dimensions"
    },
    "display_name": {
      "minLength": 1,
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 1,
      "type": "array"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/gate"
      },
      "minItems": 0,
      "type": "array"
    },
    "geometry_digest": {
      "$ref": "#/$defs/digest"
    },
    "instances": {
      "items": {
        "$ref": "#/$defs/instance"
      },
      "minItems": 0,
      "type": "array"
    },
    "labels": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "type": "object"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "lods": {
      "items": {
        "$ref": "#/$defs/lod"
      },
      "minItems": 0,
      "type": "array"
    },
    "materials": {
      "items": {
        "$ref": "#/$defs/material"
      },
      "minItems": 0,
      "type": "array"
    },
    "record_kind": {
      "const": "asset"
    },
    "references": {
      "oneOf": [
        {
          "$ref": "#/$defs/references"
        },
        {
          "type": "null"
        }
      ]
    },
    "representations": {
      "$ref": "#/$defs/representations"
    },
    "rights": {
      "$ref": "#/$defs/rights"
    },
    "schema": {
      "const": "af.asset-record/v1"
    },
    "sockets": {
      "items": {
        "$ref": "#/$defs/socket"
      },
      "minItems": 0,
      "type": "array"
    },
    "symmetry": {
      "$ref": "#/$defs/symmetry"
    },
    "taxonomy_path": {
      "pattern": "^(humanoid|creature|prop|vehicle|environment)(/[a-z][a-z0-9_-]*)+$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "record_kind",
    "canonical_profile",
    "display_name",
    "category",
    "taxonomy_path",
    "classification",
    "labels",
    "annotations",
    "dimensions",
    "coordinate_frame",
    "symmetry",
    "sockets",
    "materials",
    "lods",
    "gates",
    "lineage",
    "rights",
    "files",
    "geometry_digest",
    "representations",
    "references",
    "instances",
    "dependencies"
  ],
  "title": "af.asset-record/v1 — design draft",
  "type": "object"
}
