{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:face-fit:v1",
  "title": "Reopened procedural FACE fixture evidence",
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "pin": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"},
    "count": {"type": "integer", "minimum": 0},
    "ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "pair": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{"$ref": "#/$defs/count"}, {"type": "integer", "minimum": 1}]
    },
    "landmark_errors": {
      "type": "object", "required": ["front", "profile"],
      "propertyNames": {"enum": ["front", "profile"]}, "additionalProperties": {"$ref": "#/$defs/count"}
    },
    "frames": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "pts", "controls_ppm", "rendered", "landmark_error_millipx"],
        "properties": {
          "landmark_error_millipx": {"$ref": "#/$defs/landmark_errors"},
          "index": {"$ref": "#/$defs/count"},
          "pts": {"$ref": "#/$defs/pair"},
          "controls_ppm": {
            "type": "object", "required": ["bite", "closed", "jaw", "open", "round", "wide"],
            "propertyNames": {"enum": ["bite", "closed", "jaw", "open", "round", "wide"]},
            "additionalProperties": {"$ref": "#/$defs/ppm"}
          },
          "rendered": {
            "type": "object", "required": ["front", "profile"],
            "propertyNames": {"enum": ["front", "profile"]}, "additionalProperties": {"$ref": "#/$defs/pin"}
          }
        }
      }
    },
    "metrics": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["max_channel_error_upper_ppm", "worst_tile_error_upper_ppm", "within_targets"],
        "properties": {
          "max_channel_error_upper_ppm": {"$ref": "#/$defs/ppm"},
          "worst_tile_error_upper_ppm": {"$ref": "#/$defs/ppm"},
          "within_targets": {"type": "boolean"}
        },
        "if": {
          "properties": {
            "max_channel_error_upper_ppm": {"maximum": 20000},
            "worst_tile_error_upper_ppm": {"maximum": 10000}
          }
        },
        "then": {"properties": {"within_targets": {"const": true}}},
        "else": {"properties": {"within_targets": {"const": false}}}
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": [
    "schema", "scope", "operation", "checkpoint", "args", "scene_sha256", "track_sha256",
    "source_projection_sha256", "camera_separation_policy", "i02_decision",
    "source_sha256", "heldout_sha256", "scales", "landmark_error_millipx", "protected_metrics",
    "frames", "fixture_verdict", "rc", "reasons", "criterion_basis", "character_verdict", "authorized_character_fit"
  ],
  "properties": {
    "schema": {"const": "af.face-fit/v1"},
    "scope": {"const": "procedural_fixture"},
    "operation": {"const": "af.face_fit"},
    "checkpoint": {"const": "face_controls"},
    "args": {
      "type": "object", "additionalProperties": false,
      "required": ["goal_id", "mesh_sha256", "face_views_sha256"],
      "properties": {
        "goal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"},
        "mesh_sha256": {"$ref": "#/$defs/sha"},
        "face_views_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "source_projection_sha256": {"$ref": "#/$defs/sha"},
    "camera_separation_policy": {"const": {"basis": "TARGET_UNCALIBRATED", "max_axis_cosine": [984807, 1000000]}},
    "i02_decision": {"const": "local_comparison_of_uncalibrated_TARGET_limits"},
    "scene_sha256": {"$ref": "#/$defs/sha"},
    "track_sha256": {"$ref": "#/$defs/sha"},
    "source_sha256": {"$ref": "#/$defs/sha"},
    "heldout_sha256": {"$ref": "#/$defs/sha"},
    "scales": {"type": "array", "items": {"$ref": "#/$defs/pair"}, "minItems": 3, "maxItems": 3},
    "landmark_error_millipx": {
      "type": "object", "required": ["front", "profile"],
      "propertyNames": {"enum": ["front", "profile"]}, "additionalProperties": {"$ref": "#/$defs/count"}
    },
    "protected_metrics": {
      "type": "object", "required": ["front", "profile"],
      "propertyNames": {"enum": ["front", "profile"]}, "additionalProperties": {"$ref": "#/$defs/metrics"}
    },
    "frames": {"$ref": "#/$defs/frames"},
    "fixture_verdict": {"enum": ["PASS", "FAIL"]},
    "rc": {"enum": [0, 5]},
    "reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "criterion_basis": {"const": "TARGET"},
    "character_verdict": {"const": "CANNOT_SEE"},
    "authorized_character_fit": {"type": "null"}
  },
  "if": {"properties": {"rc": {"const": 0}}},
  "then": {
    "properties": {
      "fixture_verdict": {"const": "PASS"}, "reasons": {"maxItems": 0},
      "landmark_error_millipx": {"additionalProperties": {"maximum": 1}},
      "frames": {"items": {"properties": {"landmark_error_millipx": {"additionalProperties": {"maximum": 1}}}}},
      "protected_metrics": {"additionalProperties": {"items": {"properties": {"within_targets": {"const": true}}}}}
    }
  },
  "else": {"properties": {"fixture_verdict": {"const": "FAIL"}, "reasons": {"minItems": 1}}}
}
