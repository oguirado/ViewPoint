{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:s-toro-stage-receipt:v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "af.s-toro-stage-receipt/v1"
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "native_receipt_sha256": {
      "$ref": "#/$defs/digest"
    },
    "policy_sha256": {
      "$ref": "#/$defs/digest"
    },
    "execution_scope": {
      "enum": [
        "fixture",
        "diagnostic",
        "production"
      ]
    },
    "subject_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs_sha256": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "outputs_sha256": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "previous_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "rc": {
      "enum": [
        0,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "status": {
      "enum": [
        "OK",
        "ERROR",
        "INCOMPLETE",
        "STALE",
        "FAIL",
        "BUDGET_EXCEEDED"
      ]
    },
    "stage_verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "CANNOT_SEE",
        "ERROR"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "asset_receipt_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "asset_verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "CANNOT_SEE",
        "ERROR"
      ]
    },
    "transport_verdict": {
      "anyOf": [
        {
          "enum": [
            "PASS",
            "FAIL",
            "CANNOT_SEE",
            "ERROR"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "consumer_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "deadline_ns": {
      "type": "integer",
      "minimum": 0
    },
    "priority": {
      "type": "integer"
    },
    "affinity_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "expected_order": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "stage",
    "native_receipt_sha256",
    "policy_sha256",
    "execution_scope",
    "subject_sha256",
    "inputs_sha256",
    "outputs_sha256",
    "previous_sha256",
    "rc",
    "status",
    "stage_verdict",
    "reason_codes",
    "asset_receipt_sha256",
    "asset_verdict",
    "transport_verdict",
    "consumer_id",
    "deadline_ns",
    "priority",
    "affinity_key",
    "expected_order"
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "rc": {
            "const": 0
          }
        },
        "required": [
          "rc"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "OK"
          },
          "stage_verdict": {
            "const": "PASS"
          },
          "outputs_sha256": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rc": {
            "const": 2
          }
        },
        "required": [
          "rc"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "ERROR"
          },
          "stage_verdict": {
            "const": "ERROR"
          },
          "outputs_sha256": {
            "maxItems": 0
          },
          "subject_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rc": {
            "const": 3
          }
        },
        "required": [
          "rc"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "INCOMPLETE"
          },
          "stage_verdict": {
            "const": "CANNOT_SEE"
          },
          "outputs_sha256": {
            "maxItems": 0
          },
          "subject_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rc": {
            "const": 4
          }
        },
        "required": [
          "rc"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "STALE"
          },
          "stage_verdict": {
            "const": "CANNOT_SEE"
          },
          "outputs_sha256": {
            "maxItems": 0
          },
          "subject_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rc": {
            "const": 5
          }
        },
        "required": [
          "rc"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "FAIL"
          },
          "stage_verdict": {
            "const": "FAIL"
          },
          "outputs_sha256": {
            "maxItems": 0
          },
          "subject_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rc": {
            "const": 6
          }
        },
        "required": [
          "rc"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "BUDGET_EXCEEDED"
          },
          "stage_verdict": {
            "const": "CANNOT_SEE"
          },
          "outputs_sha256": {
            "maxItems": 0
          },
          "subject_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_verdict": {
            "const": "PASS"
          }
        },
        "required": [
          "asset_verdict"
        ]
      },
      "then": {
        "properties": {
          "execution_scope": {
            "const": "production"
          },
          "stage_verdict": {
            "const": "PASS"
          },
          "asset_receipt_sha256": {
            "$ref": "#/$defs/digest"
          },
          "subject_sha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_receipt_sha256": {
            "type": "null"
          }
        },
        "required": [
          "asset_receipt_sha256"
        ]
      },
      "then": {
        "properties": {
          "asset_verdict": {
            "const": "CANNOT_SEE"
          }
        }
      }
    }
  ]
}
