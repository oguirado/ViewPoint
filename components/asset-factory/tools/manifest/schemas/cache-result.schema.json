{
  "$id": "urn:af:cache-result:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "media_type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "path",
          "media_type",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "cache_status": {
      "enum": [
        "MISS",
        "HIT_PASS",
        "HIT_REJECTED",
        "CANNOT_SEE",
        "STALE",
        "ERROR",
        "BUDGET_EXCEEDED"
      ]
    },
    "manifest_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "rc": {
      "enum": [
        0,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "request_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "const": "af.cache-result/v1"
    },
    "verdict": {
      "enum": [
        null,
        "PASS",
        "FAIL",
        "CANNOT_SEE",
        "ERROR"
      ]
    }
  },
  "required": [
    "schema",
    "rc",
    "cache_status",
    "verdict",
    "request_key",
    "manifest_sha256",
    "reason_codes",
    "artifacts"
  ],
  "type": "object"
}
