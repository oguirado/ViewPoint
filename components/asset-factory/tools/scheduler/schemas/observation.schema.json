      ]
    }
  },
  "required": [
    "schema",
    "sample_id",
    "monotonic_ns",
    "host_mem_available_bytes",
    "cgroup_headroom_bytes",
    "effective_ceiling_bytes",
    "swap_limit_bytes",
    "residents",
    "absence_reasons"
