{
  "$id": "urn:af:bench-case:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string"
    },
    "gate_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean"
        ]
      },
      "type": "object"
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "origin_provider": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "provenance",
        "origin_provider",
        "redistribution_allowed"
      ],
      "type": "object"
    },
    "schema": {
      "const": "af.bench-case/v1"
    },
    "seed": {
      "type": "integer"
    },
    "slot": {
      "enum": [
        "generate",
        "refine",
        "topology",
        "uv_texture",
        "parts",
        "rig",
        "motion",
        "render"
      ]
    }
  },
  "required": [
    "schema",
    "case_id",
    "slot",
    "reference",
    "seed",
    "parameters",
    "gate_policy_sha256"
  ],
  "type": "object"
}
