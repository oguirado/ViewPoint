{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:diagram:v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "af.diagram/v1"
    },
    "canvas": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 64,
        "maximum": 4096
      },
      "minItems": 2,
      "maxItems": 2
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "range": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "cuts": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "focus": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "visual_box": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "caption_box": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "font": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "additionalProperties": false
    },
    "min_font_px": {
      "type": "integer",
      "minimum": 8,
      "maximum": 256
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "box": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "local_only": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "box",
          "local_only"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "zone": {
            "type": "string",
            "minLength": 1
          },
          "box": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "font_px": {
            "type": "integer",
            "minimum": 8,
            "maximum": 256
          },
          "labels": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "zone",
          "box",
          "font_px",
          "labels"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema",
    "canvas",
    "fps",
    "range",
    "cuts",
    "focus",
    "visual_box",
    "caption_box",
    "locale",
    "font",
    "min_font_px",
    "zones",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
