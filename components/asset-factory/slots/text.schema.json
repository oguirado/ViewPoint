{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:text:v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "text-slot/job-v1"
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32767
        },
        "frame_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048574
        },
        "frame_end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048574
        },
        "safe_area": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 4,
                "maximum": 65536
              },
              "height": {
                "type": "integer",
                "minimum": 4,
                "maximum": 65536
              }
            },
            "required": [
              "id",
              "width",
              "height"
            ],
            "additionalProperties": true
          }
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "text",
              "start",
              "end"
            ],
            "additionalProperties": true
          }
        },
        "font": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "schema",
        "fps",
        "frame_start",
        "frame_end",
        "safe_area",
        "profiles",
        "cues",
        "font"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "af.text/v1"
        },
        "context": {
          "type": "object",
          "properties": {
            "policy_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "toolchain_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "timeout_s": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "policy_sha256",
            "toolchain_sha256",
            "timeout_s"
          ],
          "additionalProperties": false
        },
        "request": {
          "type": "object",
          "properties": {
            "schema": {
              "const": "text-slot/job-v1"
            },
            "fps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32767
            },
            "frame_start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048574
            },
            "frame_end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048574
            },
            "safe_area": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 4,
              "maxItems": 4
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 4,
                    "maximum": 65536
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 4,
                    "maximum": 65536
                  }
                },
                "required": [
                  "id",
                  "width",
                  "height"
                ],
                "additionalProperties": true
              }
            },
            "cues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "id",
                  "text",
                  "start",
                  "end"
                ],
                "additionalProperties": true
              }
            },
            "locale": {
              "type": "string",
              "minLength": 1
            },
            "default_font": {
              "type": "string",
              "minLength": 1
            },
            "fonts": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "schema",
            "fps",
            "frame_start",
            "frame_end",
            "safe_area",
            "profiles",
            "cues",
            "locale",
            "default_font",
            "fonts"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "schema",
        "context",
        "request"
      ],
      "additionalProperties": false
    }
  ]
}
