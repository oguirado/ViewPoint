{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard",
  "description": "Author a contiguous timeline in absolute half-open frames. Version 2 requires the exact output partitions, canvas and locale.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "fps",
    "start_frame",
    "end_frame",
    "cameras",
    "camera_cuts",
    "sources",
    "surfaces",
    "scenes",
    "cues"
  ],
  "properties": {
    "schema": {
      "enum": [
        "storyboard/v1",
        "storyboard/v2"
      ]
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*(?![\\s\\S])"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "fps": {
      "description": "Reduced frames per second as [numerator, denominator].",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "minItems": 2,
      "maxItems": 2
    },
    "start_frame": {
      "$ref": "#/$defs/frame"
    },
    "end_frame": {
      "$ref": "#/$defs/frame"
    },
    "cameras": {
      "$ref": "#/$defs/ids",
      "minItems": 1
    },
    "camera_cuts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cut"
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 1
    },
    "cues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cue"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "storyboard/v2"
          }
        }
      },
      "then": {
        "required": [
          "canvas",
          "locale"
        ],
        "properties": {
          "scenes": {
            "items": {
              "required": [
                "partitions"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "canvas": false,
          "locale": false,
          "scenes": {
            "items": {
              "properties": {
                "partitions": false
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "frame": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "camera"
      ],
      "properties": {
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "camera": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "description": "Canonical POSIX path to a regular file beneath the caller-provided project root. Symbolic links are disallowed.",
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_frame",
        "end_frame"
      ],
      "properties": {
        "start_frame": {
          "$ref": "#/$defs/frame"
        },
        "end_frame": {
          "$ref": "#/$defs/frame"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_frame",
        "end_frame",
        "backend",
        "source_ids",
        "surface_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start_frame": {
          "$ref": "#/$defs/frame"
        },
        "end_frame": {
          "$ref": "#/$defs/frame"
        },
        "partitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/partition"
          }
        },
        "backend": {
          "description": "Explicit route per logical scene. Use unassigned for a board before route selection.",
          "enum": [
            "unassigned",
            "native",
            "direct",
            "plate"
          ]
        },
        "source_ids": {
          "$ref": "#/$defs/ids"
        },
        "surface_ids": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "start_frame",
        "end_frame",
        "text"
      ],
      "properties": {
        "id": {
          "description": "An absolute identifier under urn:story:<storyboard-id>:cue:<cue-id>.",
          "type": "string",
          "pattern": "^urn:story:[A-Za-z0-9][A-Za-z0-9._-]*:cue:[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "caption",
            "vo"
          ]
        },
        "start_frame": {
          "$ref": "#/$defs/frame"
        },
        "end_frame": {
          "$ref": "#/$defs/frame"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  },
  "$comment": "Request contract used by tools/storyboard/schema.json."
}
