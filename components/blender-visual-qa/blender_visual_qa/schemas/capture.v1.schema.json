          "file": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "fps": {
            "type": "integer",
            "minimum": 1
          },
          "effective_fps": {
            "type": "integer",
            "minimum": 1
          },
          "capture_fps": {
            "type": "integer",
            "minimum": 1
          },
