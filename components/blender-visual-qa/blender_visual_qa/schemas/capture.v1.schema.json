          "render_index_map": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "tick_start": {
            "type": "integer",
            "minimum": 0
          },
          "tick_end": {
            "type": "integer",
            "minimum": 0
