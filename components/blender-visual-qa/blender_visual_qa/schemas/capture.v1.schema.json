          "telemetry_line": {
            "type": "integer",
            "minimum": 1
          },
          "fault_receipt_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
