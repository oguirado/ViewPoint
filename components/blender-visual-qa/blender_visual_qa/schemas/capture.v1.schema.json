          },
          "render_index": {
            "type": "integer",
            "minimum": 0
          },
          "tick": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "const": "native_reference_drift"
          },
          "mismatched_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "status",
                "state_sha256"
              ]
            },
            "uniqueItems": true
          },
          "reference": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "observed": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "state_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "status",
              "state_sha256"
            ],
            "additionalProperties": false
          },
          "expected": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "state_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "call_index": {
                "type": "integer",
                "minimum": 0
              },
              "tick": {
                "type": "integer",
                "minimum": 0
              },
              "sequence": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "status",
              "state_sha256",
              "call_index",
              "tick",
              "sequence"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "adapter_id",
    "ruleset_id",
    "renderer",
    "fps",
    "viewport_px",
    "driver_mode",
    "driver_validated",
    "driver_input",
    "preflight",
    "telemetry",
    "frames",
    "clips",
    "points",
    "complete",
    "errors",
    "incomplete",
    "encode_argv"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "offline-capture"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "complete": {
            "const": false
          },
          "driver_validated": {
            "const": false
          },
          "qualified": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mock_unqualified": {
            "const": true
          }
        },
        "required": [
          "mock_unqualified"
        ]
      },
      "then": {
        "required": [
          "scope",
          "qualified"
        ],
        "properties": {
          "scope": {
            "const": "offline-capture"
          },
          "complete": {
            "const": false
          },
          "driver_validated": {
            "const": false
          },
          "qualified": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "required": [
          "scope",
          "qualified",
          "drive_results",
          "driver_reference"
        ],
        "properties": {
          "scope": {
            "const": "render"
          },
          "driver_validated": {
            "const": true
          },
          "driver_reference": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "preflight": {
            "properties": {
              "passed": {
                "const": true
              },
              "receipt": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "errors": {
            "maxItems": 0
          },
          "incomplete": {
            "maxItems": 0
          },
          "drive_results": {
            "maxItems": 0
          },
          "frames": {
            "minItems": 1
          },
          "points": {
            "minItems": 1,
            "items": {
              "properties": {
                "complete": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  ]
}
