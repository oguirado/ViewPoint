        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "drive_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "verdict",
          "applicable",
          "oracle_executed",
          "evidence_ids",
          "render_index",
          "tick",
          "reason",
          "mismatched_fields",
          "reference",
          "observed",
          "expected"
        ],
        "properties": {
          "check_id": {
            "const": "drive.native_reference"
          },
          "verdict": {
            "const": "FAIL"
          },
          "applicable": {
            "const": true
          },
          "oracle_executed": {
            "const": true
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
