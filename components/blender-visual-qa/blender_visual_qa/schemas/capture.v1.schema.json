{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vqa:capture:v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "vqa.capture/v1"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "ruleset_id": {
      "type": "string",
      "minLength": 1
    },
    "renderer": {
      "enum": [
        "forward_plus",
        "mobile",
        "gl_compatibility"
      ]
    },
    "fps": {
      "type": "integer",
      "minimum": 1
    },
    "effective_fps": {
      "type": "integer",
      "minimum": 1
    },
    "viewport_px": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "driver_mode": {
      "enum": [
        "journal",
        "bot",
        "timeline"
      ]
    },
    "driver_validated": {
      "type": "boolean"
    },
    "mock_unqualified": {
      "type": "boolean"
    },
    "driver_input": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "preflight": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "receipt": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "passed",
        "receipt"
      ],
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "import": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rc": {
              "type": "integer"
            },
            "duration": {
              "type": "number",
              "minimum": 0
            },
            "duration_seconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "command",
            "rc"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
