{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vqa:mutant-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "baseline_sha256",
    "adapter_sha256",
    "checklist_sha256",
    "capture_plan_sha256",
    "mutants"
  ],
  "properties": {
    "schema": {
      "enum": ["vqa.mutant-manifest/v1", "vqa.mutant-manifest/v2"]
    },
    "baseline_sha256": {
      "$ref": "#/$defs/sha"
    },
    "adapter_sha256": {
      "$ref": "#/$defs/sha"
    },
    "checklist_sha256": {
      "$ref": "#/$defs/sha"
    },
    "capture_plan_sha256": {
      "$ref": "#/$defs/sha"
    },
    "mutants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scenario_id",
          "kind",
          "fault",
          "fault_spec_sha256",
          "interval",
          "expected_check_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "runtime",
              "patch"
            ]
          },
          "fault": {
            "type": "object",
            "required": [
              "operation",
              "selector",
              "parameters"
            ],
            "additionalProperties": false,
            "properties": {
              "operation": {
                "enum": [
                  "hide_ui",
                  "camera_offset",
                  "clone_cards",
                  "translate_actor",
                  "overlap_ui",
                  "black_overlay",
                  "freeze_world"
                ]
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "parameters": {
                "type": "object"
              }
            }
          },
          "fault_spec_sha256": {
            "$ref": "#/$defs/sha"
          },
          "interval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_render_index",
              "end_render_index"
            ],
            "properties": {
              "start_render_index": {
                "type": "integer",
                "minimum": 0
              },
              "end_render_index": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "expected_check_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "reason", "scenario_id", "evidence_path", "evidence_sha256"],
            "properties": {
              "status": {"const": "NOT_APPLICABLE"},
              "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "scenario_id": {"type": "string", "minLength": 1},
              "evidence_path": {"type": "string", "pattern": "^adapters/[a-z0-9_-]+/[a-zA-Z0-9_./-]+\\.json$"},
              "evidence_sha256": {"$ref": "#/$defs/sha"}
            }
          },
          "patch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relative_path",
              "base_sha256",
              "patch_sha256"
            ],
            "properties": {
              "relative_path": {
                "type": "string",
                "minLength": 1
              },
              "base_sha256": {
                "$ref": "#/$defs/sha"
              },
              "patch_sha256": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "patch"
                }
              }
            },
            "then": {
              "required": [
                "patch"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "runtime"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "patch"
                ]
              }
            }
          }
        ]
      }
    },
    "clean_schedule": {
      "type": "array",
      "minItems": 3,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution_id",
          "scenario_id",
          "seed_hex",
          "driver_sha256",
          "baseline_projection_sha256"
        ],
        "properties": {
          "execution_id": {
            "type": "string",
            "pattern": "^clean_[a-zA-Z0-9_.-]+$"
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "seed_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "driver_sha256": {
            "$ref": "#/$defs/sha"
          },
          "baseline_projection_sha256": {
            "$ref": "#/$defs/sha"
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"schema": {"const": "vqa.mutant-manifest/v1"}}},
    "then": {"properties": {"mutants": {"items": {"not": {"required": ["applicability"]}}}}}
  }],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
