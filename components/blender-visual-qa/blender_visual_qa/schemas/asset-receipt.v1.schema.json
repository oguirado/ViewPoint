{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bvqa:asset-receipt:v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "bvqa.asset-receipt/v1"
    },
    "stage": {
      "enum": [
        "inspect",
        "normalize",
        "mesh-gate",
        "turntable",
        "render-sheet",
        "lod-ladder",
        "hull-gen",
        "ortho4",
        "orm-pack",
        "heal",
        "self-isect",
        "bake-pbr",
        "uv-gate",
        "pbr-validate",
        "delight"
      ]
    },
    "rc": {
      "enum": [
        0,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "input_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "prev_receipt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage_receipt": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "stage",
    "rc",
    "input_sha256",
    "prev_receipt_sha256",
    "receipt_sha256",
    "stage_receipt"
  ],
  "additionalProperties": false
}
