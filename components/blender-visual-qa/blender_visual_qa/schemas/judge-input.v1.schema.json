{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vqa:judge-input:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "batch_id",
    "attempt_id",
    "model_id",
    "effort",
    "checklist_sha256",
    "checks",
    "media",
    "attention_questions"
  ],
  "properties": {
    "schema": {
      "const": "vqa.judge-input/v1"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "batch_id": {
      "$ref": "#/$defs/id"
    },
    "attempt_id": {
      "$ref": "#/$defs/id"
    },
    "model_id": {
      "const": "gemini-3.8-flash"
    },
    "effort": {
      "const": "medium"
    },
    "checklist_sha256": {
      "$ref": "#/$defs/sha"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "media": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/media"
      }
    },
    "attention_questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "source_map": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "requirement",
        "pass_anchor",
        "fail_anchor",
        "evidence_ids"
      ],
      "properties": {
        "check_id": {
          "$ref": "#/$defs/id"
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "pass_anchor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "fail_anchor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "evidence_requirement": {
          "enum": [
            "ocr",
            "scene",
            "temporal"
          ]
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_evidence_ids",
        "path",
        "sha256",
        "kind",
        "role",
        "tick_start",
        "tick_end",
        "duration_ms",
        "frame_count"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "source_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "kind": {
          "enum": [
            "png",
            "mp4"
          ]
        },
        "role": {
          "enum": [
            "render",
            "contact_sheet",
            "attention"
          ]
        },
        "tick_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tick_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "source_map": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "render_index",
              "tick"
            ],
            "properties": {
              "render_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "tick": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "evidence_id",
        "question"
      ],
      "properties": {
        "question_id": {
          "enum": [
            "attention_text",
            "attention_absent",
            "attention_video"
          ]
        },
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      }
    }
  }
}
