{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vqa:report:v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "vqa.report/v1"
    },
    "scope": {
      "enum": [
        "configuration",
        "render",
        "offline-selftest",
        "live-calibration"
      ]
    },
    "command": {
      "enum": [
        "validate",
        "run",
        "judge",
        "report",
        "selftest"
      ]
    },
    "run_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "rc": {
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "INCOMPLETE"
      ]
    },
    "qualified": {
      "type": "boolean"
    },
    "summary": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "fails": {
          "type": "integer",
          "minimum": 0
        },
        "cannot_see": {
          "type": "integer",
          "minimum": 0
        },
        "expected": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "checks",
        "fails",
        "cannot_see",
        "expected"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "maxLength": 80
          },
          "point_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "maxLength": 80
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "CANNOT_SEE"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "tick": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "reproduce_argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "confidence": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ]
          },
          "deterministic": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:vqa:oracle-result:v1"
              }
            ]
          },
          "judge": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:vqa:judge-output:v1"
              }
            ]
          },
          "disagreement": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "advisory": {
            "const": true
          },
          "advisory_reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "check_id",
          "point_id",
          "verdict",
          "evidence_ids",
          "tick",
          "reproduce_argv",
          "confidence",
          "deterministic",
          "judge",
          "disagreement",
          "reason"
        ],
        "additionalProperties": false,
        "dependentRequired": {
          "advisory": [
            "advisory_reason"
          ],
          "advisory_reason": [
            "advisory"
          ]
        }
      },
      "minItems": 0
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "maxLength": 80
          },
          "status": {
            "enum": [
              "COMPLETE",
              "ERROR",
              "INCOMPLETE"
            ]
          },
          "checks": {
            "type": "integer",
            "minimum": 0
          },
          "fails": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "checks",
          "fails",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "maxLength": 80
          },
          "stage": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "maxLength": 80
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "stage",
          "message"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "incomplete": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "metrics": {
      "type": "object",
      "properties": {
        "gemini_calls": {
          "$ref": "#/$defs/shared1"
        },
        "frames": {
          "$ref": "#/$defs/shared1"
        },
        "clip_seconds": {
          "$ref": "#/$defs/shared1"
        },
        "input_tokens": {
          "$ref": "#/$defs/shared1"
        },
        "output_tokens": {
          "$ref": "#/$defs/shared1"
        },
        "wall_seconds": {
          "$ref": "#/$defs/shared1"
        },
        "cost_usd": {
          "$ref": "#/$defs/shared1"
        }
      },
      "required": [
        "gemini_calls",
        "frames",
        "clip_seconds",
        "input_tokens",
        "output_tokens",
        "wall_seconds",
        "cost_usd"
      ],
      "additionalProperties": false
    },
    "selftest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:vqa:selftest-results:v1"
        }
      ]
    },
    "advisory_findings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/properties/findings/items"
          },
          {
            "required": [
              "advisory",
              "advisory_reason"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "scope",
    "command",
    "run_id",
    "ok",
    "rc",
    "verdict",
    "qualified",
    "summary",
    "findings",
    "stages",
    "errors",
    "incomplete",
    "bindings",
    "metrics",
    "selftest"
  ],
  "additionalProperties": false,
  "$defs": {
    "shared1": {
      "type": "object",
      "properties": {
        "absence_reason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "provenance": {
          "enum": [
            "MEASURED",
            "CITED",
            "TARGET",
            "AUSENTE"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        }
      },
      "required": [
        "value",
        "unit",
        "provenance",
        "absence_reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "const": "AUSENTE"
              },
              "absence_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "provenance": {
                "enum": [
                  "MEASURED",
                  "CITED",
                  "TARGET"
                ]
              },
              "absence_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
