{
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:viewpoint:short-edit:v1",
  "type": "object",
  "required": ["schema", "fps", "pixels", "shots", "mix", "captions"],
  "properties": {
    "schema": {"const": "viewpoint.short-edit/v1"},
    "fps": {"type": "integer", "minimum": 1, "maximum": 60},
    "pixels": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "integer", "minimum": 2, "maximum": 8192, "multipleOf": 2}
    },
    "shots": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "required": ["id", "source_cut", "media"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "source_cut": {
            "description": "Zero-based half-open source frame range",
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {"type": "integer", "minimum": 0}
          },
          "media": {"$ref": "#/$defs/media"}
        }
      }
    },
    "mix": {"$ref": "#/$defs/media"},
    "captions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["start", "end", "text"],
        "properties": {
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "media": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
