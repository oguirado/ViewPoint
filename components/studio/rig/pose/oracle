def parser():
    class OracleParser(argparse.ArgumentParser):
        def error(self, message):
            refuse("usage:" + message, next_command=["./oracle", "--help"])

    root = OracleParser(prog="oracle", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = root.add_subparsers(dest="command")
    p = sub.add_parser("scene")
    for name in ("incumbent", "candidate", "incumbent-sha256", "candidate-sha256", "out"):
        p.add_argument(f"--{name}", required=True)
    p.add_argument("--witness", action="append", required=True)
    p = sub.add_parser("inspect")
    p.add_argument("--rig", required=True)
    p.add_argument("--map", required=True)
    p.add_argument("--contract", required=True)
    p.add_argument("--out", required=True)
    p = sub.add_parser("sweep")
    for name in ("reference", "map", "contract", "out-dir"):
        p.add_argument(f"--{name}", required=True)
    p.add_argument("--profile", choices=("full", "quick"), default="full")
    p = sub.add_parser("cameras")
    p.add_argument("--out", required=True)
    p.add_argument("--map", required=True)
    p.add_argument("--seed")
    p = sub.add_parser("synth")
    p.add_argument("--out-dir", required=True)
    p.add_argument("--contract", required=True)
    p = sub.add_parser("historical")
    for name in ("poses-dir", "failure-index", "rig-info", "map", "contract"):
        p.add_argument(f"--{name}", required=True)
    p = sub.add_parser("extract")
    for name in ("take-dir", "rig", "map", "frames", "out-dir"):
        p.add_argument(f"--{name}", required=True)
    p = sub.add_parser("measure")
    for name in ("rig", "map", "contract", "cameras", "poses", "out"):
        p.add_argument(f"--{name}", required=True)
    p.add_argument("--jobs", type=int, default=4)
    p.add_argument("--expect-sha256")
    p.add_argument("--no-pin", action="store_true")
    p.add_argument("--reference")
    p.add_argument("--enforce-budget", action="store_true", default=None)
    p.add_argument("--dump-views", help="directory for the worst-view mask of every pose (evidence images)")
    p = sub.add_parser("compare")
    for name in ("candidate", "candidate-map", "incumbent", "incumbent-map", "contract", "cameras", "poses", "out"):
        p.add_argument(f"--{name}", required=True)
    p.add_argument("--jobs", type=int, default=4)
    p.add_argument("--reference")
    p.add_argument("--controls", action="store_true", help="use the synthetic controls without a production triangle gate")
    return root


def main():
    args = parser().parse_args()
    if args.command in ("inspect", "synth", "extract", "measure", "compare", "scene") and not common.in_scope():
        try:
            common.require_admission()
        except common.Refusal as error:
            refuse(error.reason, error.retry_when, error.next_command or ["./oracle", *sys.argv[1:]])
        env = {"PATH": "/usr/bin:/bin", **common.ENV}
        for key in ("DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR", "STUDIO_BLENDER"):
            if key in os.environ:
                env[key] = os.environ[key]
        with tempfile.TemporaryDirectory(prefix=".scope-", dir=os.environ.get("TMPDIR")) as tmp:
            command = common.scope_command() + [sys.executable, "-I", "-B", str(ROOT / "oracle"), *sys.argv[1:]]
            env.update({k: str(tmp) for k in ("TMPDIR", "XDG_CACHE_HOME", "XDG_CONFIG_HOME", "HOME")})
            cp = subprocess.run(command, env=env, capture_output=True, text=True, check=False)
            print(cp.stdout, end="")
            if cp.returncode not in (0, 1) and not cp.stdout:
                refuse(f"scope_launch_failed:{cp.stderr[-350:].strip()}")
            if cp.stderr:
                print(cp.stderr, end="", file=sys.stderr)
            sys.exit(cp.returncode if cp.returncode in (0, 1) else 2)
    handlers = {"inspect": cmd_inspect, "sweep": cmd_sweep, "cameras": cmd_cameras, "synth": cmd_synth,
                "historical": cmd_historical, "extract": cmd_extract, "measure": cmd_measure, "compare": cmd_compare,
                "scene": cmd_scene}
    if args.command not in handlers:
        refuse("usage: ./oracle inspect|sweep|cameras|synth|historical|extract|measure|compare",
               next_command=["./oracle", "--help"])
    handlers[args.command](args)


if __name__ == "__main__":
    main()
