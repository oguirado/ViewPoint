                           "by_basis": report["expectations"]["by_basis"], "unmet": len(report["expectations"]["unmet"])},
          "out": args.out})
    sys.exit(1 if report["verdict"] == "REJECT" else 0)


# ------------------------------------------------------------------ compare
def motion_reproduced(report, expected_poses, tolerance):
    def within_tolerance(*errors):
        return all(isinstance(error, (int, float)) and not isinstance(error, bool)
                   and 0 <= error <= tolerance for error in errors)

    rest = report["rest"] or {}
    if (not expected_poses or [row["pose_id"] for row in report["poses"]] != expected_poses
            or "pose_not_reproduced" in report["rejected_classes"]
            or not within_tolerance(rest.get("fk_readback_m"), rest.get("fk_independent_m"))):
        return False
    for row in report["poses"]:
        fk = row.get("fk", {})
        if (row["joints_not_commanded"]
                or not within_tolerance(fk.get("readback_m"), fk.get("independent_m"))):
            return False
    return True


def comparison_status(report, cls, enforce_budget):
    if cls in report["rejected_classes"]:
        return "REJECT"
    asset, rest = report["asset"], report["rest"]
    if (rest is None
            or (cls == "exterior_not_closed" and not asset.get("nonmanifold_edges_by_object"))
            or (cls == "stale_inverse_bind" and asset.get("inverse_bind_m") is None)
            or (cls == "triangle_budget_exceeded" and not enforce_budget)
            or (cls in ("bearing_clearance_out_of_range", "bearing_surface_unverified", "joint_stop_exceeded")
                and not rest.get("bearing_fit"))
            or (cls == "pivot_shifted" and not rest["registered_geometry"]["pivot_error_m"])
            or (cls == "fork_tip_damaged" and not rest["registered_geometry"]["fork_tips"])
            or (cls in ("sole_not_touching", "sole_contact_insufficient")
                and not any("clearance_min_m" in sole for pose in report["poses"]
                            for sole in pose.get("soles", {}).values()))
            or (cls == "rest_seam_open" and not rest.get("seams"))
            or (cls == "seam_see_through"
                and (not asset.get("seams") or not rest["interior"]["see_through"]["heldout_views_cast"]))):
        return "AUSENTE"
    return "PASS"


@guard
def cmd_compare(args):
    out = Path(args.out).resolve()
    if out.suffix != ".json":
        raise common.Refusal("comparison_requires_json_output")
    keys = ("incumbent", "candidate", "incumbent_map", "candidate_map", "contract", "cameras", "poses", "reference")
    inputs = {absolute(getattr(args, key)) for key in keys if getattr(args, key)}
    outputs = (out, out.with_suffix(".md"), *(out.with_name(f"{out.stem}.{label}.json")
                                             for label in ("incumbent", "candidate")))
    if any(absolute(path) in inputs for path in outputs):
        raise common.Refusal("output_aliases_input")
    out.parent.mkdir(parents=True, exist_ok=True)
    reports = {}
    shared_inputs = measurement_inputs(args)
    contract, _, _, items, _ = shared_inputs
    expected_poses = [item["pose"]["pose_id"] for item in items]
    tolerance = contract["tolerances"]["fk_readback_m"]["value"]
    if (not isinstance(tolerance, (int, float)) or isinstance(tolerance, bool)
            or not math.isfinite(tolerance) or tolerance < 0):
        raise common.Refusal("invalid_fk_readback_tolerance")
    for label, rig, map_path in (("incumbent", args.incumbent, args.incumbent_map),
                                 ("candidate", args.candidate, args.candidate_map)):
        opts = measure_opts(Path(rig), Path(map_path), out.with_name(f"{out.stem}.{label}.json"), args)
        opts.label = label
        opts.enforce_budget = not args.controls
        if label == "candidate":
            if not reports["incumbent"]["camera_frames"]:
                raise common.Refusal("incumbent_camera_frames_missing")
            opts.fixed_camera_frames = reports["incumbent"]["camera_frames"]
        reports[label] = measure(opts, shared_inputs)
    inc, cand = reports["incumbent"], reports["candidate"]
    bindings = ("contract_sha256", "cameras_sha256", "camera_frames_sha256", "reference_sha256", "poses_digest", "poses")
    matched = all(inc["inputs"][k] == cand["inputs"][k] for k in bindings)
    same_motion = all(motion_reproduced(rep, expected_poses, tolerance) for rep in reports.values())
    matched = matched and same_motion and bool(cand["camera_frames"])
    inc_classes, cand_classes = set(inc["rejected_classes"]), set(cand["rejected_classes"])
    if not matched:
        verdict = "unmatched_inputs"
    elif cand["verdict"] == "REJECT" and not cand_classes <= inc_classes:
        verdict = "candidate_worse" if inc["verdict"] == "PASS" else "candidate_rejected"
    elif cand["verdict"] == "REJECT":
        verdict = "tie_reject" if cand_classes == inc_classes else "candidate_partial"
    elif inc["verdict"] == "REJECT":
        verdict = "candidate_separates"
    else:
        verdict = "tie_pass" if inc["asset"].get("triangles_within_budget") else "incumbent_over_budget"
    inc_by = {r["pose_id"]: r for r in inc["poses"]}
    poses = [{"pose_id": r["pose_id"],
              "incumbent": inc_by[r["pose_id"]]["verdict"] if r["pose_id"] in inc_by else None,
              "candidate": r["verdict"],
              "incumbent_classes": sorted({f["class"] for f in inc_by[r["pose_id"]]["failures"]}) if r["pose_id"] in inc_by else None,
              "candidate_classes": sorted({f["class"] for f in r["failures"]})} for r in cand["poses"]]
    summary = lambda rep: {"verdict": rep["verdict"], "classes": sorted(rep["rejected_classes"]),
                           "file_sha256": rep["asset"]["file_sha256"], "worst": rep["worst"],
                           "triangles": rep["asset"].get("triangles"),
                           "triangle_budget": rep["asset"].get("triangle_budget"),
                           "exterior_closure": rep["asset"].get("exterior_closure"),
                           "historical_observations": rep["expectations"]["historical"],
                           "poses_passed": sum(r["verdict"] == "PASS" for r in rep["poses"])}
    report = {"schema": "rp4.pose-oracle.compare.v1", "unit": UNIT, "command": "compare", "matched": matched,
              "comparator": verdict,
               "rows": [{"class": c, **{label: comparison_status(rep, c, not args.controls)
                                         for label, rep in reports.items()}} for c in CLASS_ORDER],
              "incumbent": summary(inc), "candidate": summary(cand),
               "measurement_sha256": {label: common.sha256(out.with_name(f"{out.stem}.{label}.json"))
                                      for label in reports},
              "inputs": {k: inc["inputs"][k] for k in bindings},
              "matched_motion": same_motion, "production_promotion": "WITHHELD",
              "poses": poses}
    common.dump_json(out, report)
    table = ["| Class | Incumbent cut-shell | Candidate |", "|---|---|---|"] + [
        f"| `{r['class']}` | {r['incumbent']} | {r['candidate']} |"
        for r in report["rows"]]
    out.with_suffix(".md").write_text("\n".join(table) + f"\n\nComparator: `{verdict}`.\n", encoding="utf-8")
    if not matched:
        refuse("unmatched_inputs")
    emit({"comparator": verdict, "matched": matched, "incumbent": inc["verdict"], "candidate": cand["verdict"],
          "incumbent_classes": sorted(inc_classes), "candidate_classes": sorted(cand_classes),
          "out": str(out)})
    if cand["verdict"] == "REJECT":
        sys.exit(1)


