@guard
def cmd_synth(args):
    """Build the synthetic control rigs, their maps, sweep and camera ring."""
    out_dir = Path(args.out_dir).resolve()
    out_dir.mkdir(parents=True, exist_ok=True)
    digests = {}
    for name, variant in synthmod.VARIANTS.items():
        path = out_dir / f"synth_{name}.glb"
        digests[name] = synthmod.write_rig(path, variant)
    common.dump_json(out_dir / "joints.synth.json", synthmod.joint_map())
    seated = out_dir / "synth_seated.glb"
    file = glbmod.Glb(seated)
    common.dump_json(out_dir / "joints.synth.seated.json",
                     synthmod.joint_map({"file_sha256": file.sha256, "structure_sha256": file.structure_digest()}))
    rig = inspect_rig(seated, out_dir / "joints.synth.json", out_dir / "rig.synth.json", args.contract)
    poses = synthmod.poses(rig)
    sweep_dir = out_dir / "sweep-synth"
    sweep_dir.mkdir(parents=True, exist_ok=True)
    records = []
    for pose in poses:
        data = sweepmod.pose_bytes(pose)
        name = f"{pose['pose_id']}.pose.json"
        (sweep_dir / name).write_bytes(data)
        records.append({"pose_id": pose["pose_id"], "family": pose["family"], "file": name,
                        "sha256": hashlib.sha256(data).hexdigest(), "plant": pose["plant"], "expect": pose["expect"]})
    joint_map = synthmod.joint_map()
    manifest = sweepmod.manifest(records, "synth", 0, rig, joint_map, common.load_json(args.contract), 0.0)
    common.dump_json(sweep_dir / "sweep.json", manifest)
    cameras = cammod.generate("pose-oracle synthetic controls", chains=["left_arm"])
    common.dump_json(out_dir / "cameras.synth.json", cameras)
    emit({"out_dir": str(out_dir), "variants": digests, "poses": len(records), "poses_digest": manifest["poses_digest"],
          "seated": {"file_sha256": file.sha256, "structure_sha256": file.structure_digest(),
                     "triangles": rig["asset"]["triangles"], "vertices": rig["asset"]["vertices"]},
          "rest": {k: rig["rest"][k] for k in ("rigidity_m", "fk_independent_m", "glb_positions_max_m", "backface_px_total")}})


