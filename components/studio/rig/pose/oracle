    with tempfile.TemporaryDirectory(prefix=".scene-", dir=os.environ.get("TMPDIR")) as tmp:
        path = Path(tmp) / "scene.json"
        spec = inputs | {"out": str(path), "witnesses": sorted(set(args.witness))}
        record, report = run_blender("scene_binding.py", spec, tmp, "scene")
