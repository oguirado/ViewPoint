# ------------------------------------------------------------------ measure
def load_pose_items(entry):
    """Pose items from a sweep manifest, a directory, single files or a comma list."""
    items = []
    ids = set()
    for token in entry.split(","):
        path = Path(token)
        if not path.exists():
            raise common.Refusal(f"poses_missing:{token}", "generate poses first", ["./oracle", "sweep"])
        files = sorted(path.glob("*.pose.json")) if path.is_dir() else [path]
        manifest_records = {}
        if not path.is_dir() and path.suffix == ".json":
            doc = common.load_json(path)
            if doc.get("schema") == sweepmod.SWEEP_SCHEMA:
                records = doc["poses"]
                digest = common.digest_obj([[r["pose_id"], r["sha256"]] for r in records])
                if digest != doc["poses_digest"] or doc["count"] != len(records):
                    raise common.Refusal("sweep_manifest_digest_or_count")
                files = []
                for rec in records:
                    if Path(rec["file"]).name != rec["file"]:
                        raise common.Refusal("sweep_pose_path_not_local")
                    pose_file = path.parent / rec["file"]
                    if common.sha256(pose_file) != rec["sha256"]:
                        raise common.Refusal(f"sweep_pose_changed:{rec['file']}", "regenerate the sweep",
                                             ["./oracle", "sweep"])
                    files.append(pose_file)
                    manifest_records[pose_file] = rec
        for pose_file in files:
            data = pose_file.read_bytes()
            sha = hashlib.sha256(data).hexdigest()
            pose = json.loads(data)
            pose_id = pose["pose_id"]
            if pose.get("schema") != sweepmod.SCHEMA or pose_id in ids:
                raise common.Refusal(f"invalid_or_duplicate_pose:{pose_id}")
            if manifest_records:
                record = manifest_records[pose_file]
                if record["pose_id"] != pose_id or record["sha256"] != sha:
                    raise common.Refusal("sweep_pose_record_mismatch")
            ids.add(pose_id)
            items.append({"path": str(pose_file), "sha256": sha, "pose": pose})
    if not items:
        raise common.Refusal("poses_missing", "generate poses first", ["./oracle", "sweep"])
    return items, common.digest_obj([[i["pose"]["pose_id"], i["sha256"]] for i in items])


def run_shards(work, specs):
    records, reports = [], []
    procs = []
    try:
        for k, spec in enumerate(specs):
            spec_path = Path(work) / f"shard{k}.spec.json"
            spec_path.write_text(json.dumps(spec, sort_keys=True) + "\n", encoding="utf-8")
            command = common.blender_command(ROOT / "blender" / "blender_measure.py", [spec_path], threads=2)
            stdout = Path(work) / f"shard{k}.stdout"
            stderr = Path(work) / f"shard{k}.stderr"
            with stdout.open("wb") as stdout_stream, stderr.open("wb") as stderr_stream:
                process = subprocess.Popen(command, cwd=work, env=common.child_env(work),
                                           stdout=stdout_stream, stderr=stderr_stream)
            procs.append({"spec": spec, "command": [str(c) for c in command],
                          "proc": process})
        for job in procs:
            rc = job["proc"].wait(timeout=3600)
            spec = job["spec"]
            out = Path(spec["out"])
            report = common.load_json(out) if out.exists() else {"refusal": {"reason": "shard_report_missing"}}
            records.append({"shard": spec["shard"], "rc": rc,
                            "poses": len(spec["poses"]), "verdict": report.get("verdict"),
                            "refusal": report.get("refusal")})
            reports.append((job, rc, report))
            if rc or "refusal" in report:
                break
    finally:
        for job in procs:
            process = job["proc"]
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
    return records, reports


def merge_shards(reports, order):
    merged = {key: value for key, value in reports[0][2].items() if key != "scope"}
    merged["poses"] = []
    merged["camera_frames"] = {}
    worst = {}
    for _, _, report in reports:
        merged["poses"] += report["poses"]
        merged["camera_frames"].update(report.get("camera_frames", {}))
        for key, rec in report["worst"].items():
            lower = key in LOWER_IS_WORSE
            if key not in worst or (rec["value"] < worst[key]["value"] if lower else rec["value"] > worst[key]["value"]):
                worst[key] = rec
    merged["poses"].sort(key=lambda r: order.get(r.get("pose_id"), 1 << 30))
    merged["worst"] = worst
    merged["shard"] = "merged"
    return merged


def expectation_met(want, verdict, observed):
    """A pass expectation needs PASS; a reject expectation needs REJECT on one of the named classes."""
    if want.get("verdict") == "pass":
        return verdict == "PASS"
    if verdict != "REJECT":
        return False
    return bool(set(want.get("classes", ())) & set(observed))


def measurement_inputs(opts):
    """Read the shared comparison inputs once for both independent reopens."""
    items, poses_digest = load_pose_items(opts.poses)
    return (common.load_json(opts.contract), common.load_json(opts.cameras),
            common.load_json(opts.reference) if opts.reference else None, items, poses_digest)


def measure(opts, shared_inputs=None):
    """Reopen one asset in parallel Blender processes and merge their measurements."""
    joint_map = resolve(common.load_json(opts.map))
    contract, cameras_doc, reference, items, poses_digest = (
        shared_inputs if shared_inputs is not None else measurement_inputs(opts))
    if opts.enforce_budget is None:
        opts.enforce_budget = contract["tolerances"]["triangle_budget"].get("gating", False)
    expected = {k: v for k, v in (joint_map.get("asset") or {}).items()
                if k in ("file_sha256", "structure_sha256") and v}
    if opts.expect_sha256:
        expected["file_sha256"] = opts.expect_sha256
    if opts.no_pin:
        expected = {}
    if opts.label in ("candidate", "incumbent") and not expected.get("file_sha256"):
        raise common.Refusal(f"{opts.label}_file_pin_missing")
    expectations = {i["pose"]["pose_id"]: i["pose"]["expect"] for i in items if i["pose"].get("expect")}
    judges = {}
    for item in items:
        pose = item["pose"]
        judge = pose.get("judge")
        if not judge:
            continue
        source = pose["source"]
        frame = judge["movie_frame"] + 1
        if (frame != source["set_frame"] or judge["movie_frame"] != source["movie_frame"]
                or pose["pose_id"] != f"hist-{source['take']}-{frame:03d}"):
            raise common.Refusal(f"historical_judge_frame_mismatch:{pose['pose_id']}")
        judges[pose["pose_id"]] = judge
    # The measurer never sees what a pose is expected to prove.
    blind = [{k: v for k, v in i["pose"].items() if k not in ("expect", "judge")} for i in items]
    count = max(1, min(int(opts.jobs), len(blind)))
    with tempfile.TemporaryDirectory(prefix=".measure-", dir=os.environ.get("TMPDIR")) as tmp:
        specs = [{"out": str(Path(tmp) / f"shard{k}.json"), "rig": opts.rig, "contract": contract,
                  "joint_map": joint_map, "cameras": cameras_doc, "floor_z_m": FLOOR_Z,
                  "poses": blind[k::count], "expected": expected, "shard": k,
                  "reference": reference, "enforce_budget": opts.enforce_budget,
                  "fixed_camera_frames": opts.fixed_camera_frames,
                  "require_scope": True,
                  "dump_dir": absolute(opts.dump_views) if opts.dump_views else None} for k in range(count)]
        records, reports = run_shards(tmp, specs)
        for p, rc, report in reports:
            if rc or "refusal" in report or "poses" not in report:
                tail = Path(p["command"][-1]).with_name(f"shard{p['spec']['shard']}.stderr")
                tail = tail.read_text(errors="replace")[-700:] if tail.exists() else ""
                reason = report.get("refusal") or {}
                raise common.Refusal(
                    f"measure_shard_{p['spec']['shard']}_rc_{rc}:{reason.get('reason')}:{reason.get('traceback', tail)[-300:]}"[:700],
                    reason.get("retry_when", common.RETRY_PRECONDITION))
        order = {pose.get("pose_id"): i for i, pose in enumerate(blind)}
        merged = merge_shards(reports, order)
    # Asset-level, rest-level and pose-level failures all decide the verdict.
    classes = ({f["class"] for f in merged.get("asset_failures", [])}
               | {f["class"] for f in merged.get("rest_failures", [])}
               | {f["class"] for rec in merged["poses"] for f in rec.get("failures", [])})
    merged.update({"unit": UNIT, "command": "measure", "label": opts.label, "shards": records,
                   "rejected_classes": sorted(classes), "verdict": "REJECT" if classes else "PASS",
                   "inputs": {"rig": opts.rig, "map": opts.map, "file_sha256": merged["asset"]["file_sha256"],
                              "structure_sha256": merged["asset"].get("structure_sha256"),
                              "contract_sha256": common.digest_obj(contract),
                              "joint_map_sha256": common.digest_obj(joint_map), "cameras_sha256": cammod.digest(cameras_doc),
                              "reference_sha256": common.digest_obj(reference) if reference else None,
                              "camera_frames_sha256": common.digest_obj(merged["camera_frames"]),
                              "poses_digest": poses_digest, "poses": len(items), "expected_pins": expected,
                              "camera_resolution": cameras_doc["resolution"]}})
    unmet, by_basis, historical = [], {}, []
    semantic_of = {j["bone"]: name for name, j in joint_map["joints"].items() if j.get("bone")}
    for rec in merged["poses"]:
        want = expectations.get(rec.get("pose_id"))
        observed = sorted({f["class"] for f in rec.get("failures", [])})
        if not want or want.get("verdict") == "none":
            continue
        basis = want.get("basis", "generated")
        tally = by_basis.setdefault(basis, {"checked": 0, "met": 0, "unverified": 0})
        if basis == "judge-cited":
            judge = judges.get(rec["pose_id"])
            if not judge or not judge["cited"]:
                raise common.Refusal(f"historical_judge_binding_missing:{rec['pose_id']}")
            rows = histmod.corroborate(judge, rec, semantic_of)
            historical.extend(rows)
            tally["checked"] += len(rows)
            tally["met"] += sum(row["status"] == "CORROBORATED" for row in rows)
            tally["unverified"] += sum(row["status"] == "UNVERIFIED" for row in rows)
            unmet.extend(row for row in rows if row["status"] == "NOT_CORROBORATED")
        else:
            met = expectation_met(want, rec["verdict"], observed)
            tally["checked"] += 1
            tally["met"] += int(met)
            if met:
                continue
            unmet.append({"pose_id": rec.get("pose_id"), "basis": basis, "expected": want, "observed": observed,
                          "verdict": rec["verdict"]})
    checked_count = sum(tally["checked"] for tally in by_basis.values())
    merged["expectations"] = {"checked": checked_count, "met": sum(t["met"] for t in by_basis.values()),
                              "unverified": sum(t["unverified"] for t in by_basis.values()),
                              "unmet": unmet, "by_basis": by_basis, "historical": historical}
    common.dump_json(opts.out, merged)
    return merged


