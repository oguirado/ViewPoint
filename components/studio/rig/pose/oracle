# ------------------------------------------------------------------ extract
def stance_table(take_dir):
    """SET frame -> feet the motion stage declared in stance (movie intervals are inclusive)."""
    report = common.load_json(Path(take_dir) / "motion" / "motion-report.json")
    table = {}
    for side, intervals in report.get("stance", {}).items():
        for interval in intervals:
            start, end = interval["frames"]
            for frame in range(int(start) + 1, int(end) + 1):
                table.setdefault(str(frame), []).append(side)
    return table


@guard
def cmd_extract(args):
    rig, joint_map = Path(args.rig).resolve(), resolve(common.load_json(args.map))
    take_dir = Path(args.take_dir).resolve()
    blend = take_dir / "render" / "take.blend"
    frames = sorted({int(f) for f in args.frames.split(",") if f})
    if not blend.is_file():
        raise common.Refusal(f"take_missing:{blend}")
    with tempfile.TemporaryDirectory(prefix=".extract-", dir=os.environ.get("TMPDIR")) as tmp:
        spec = {"out": str(Path(tmp) / "extract.json"), "blend": str(blend), "rig": str(rig), "joint_map": joint_map,
                "floor_z_m": FLOOR_Z, "frames": frames, "stance": stance_table(take_dir)}
        record, report = run_blender("blender_extract.py", spec, tmp, "extract")
        checked(record, report, "extract")
    out_dir = Path(args.out_dir).resolve()
    out_dir.mkdir(parents=True, exist_ok=True)
    run, rig_sha = take_dir.name, common.sha256(rig)
    replay = {k: 0.0 for k in ("dformat", "basis", "head")}
    for key, frame in report["frames"].items():
        pose = {"schema": sweepmod.SCHEMA, "pose_id": f"hist-{run}-{int(key):03d}", "family": "historical",
                "plant": frame["plant_declared"], "floor_z_m": FLOOR_Z,
                "source": {"take": run, "blend": str(blend), "blend_sha256": common.sha256(blend),
                           "set_frame": int(key), "movie_frame": int(key) - 1, "rig": str(rig), "rig_sha256": rig_sha},
                "soles_in_take": frame["soles_in_take"], "replay": frame.get("replay"),
                "joints": {s: {k: v[k] for k in ("q", "t") if k in v} for s, v in frame["joints"].items()}}
        if "camera" in report["scene"]:
            pose["film_camera"] = report["scene"]["camera"]
        common.dump_json(out_dir / f"{pose['pose_id']}.pose.json", pose)
        for k in replay:
            replay[k] = max(replay[k], frame["replay"].get(f"{k}_max_m") or 0.0)
    common.dump_json(out_dir / f"extract-{run}.json", {
        "schema": report["schema"], "take": run, "frames": frames, "blend_sha256": common.sha256(blend),
        "scene": {k: v for k, v in report["scene"].items() if k != "camera"}, "camera": report["scene"].get("camera"),
        "replay_rig": report.get("replay_rig")})
    emit({"take": run, "frames": frames, "poses": [f"hist-{run}-{f:03d}" for f in frames],
          "replay_max_m": {k: round(v, 9) for k, v in replay.items()}, "out_dir": str(out_dir),
          "soles_in_take": {k: {s: round(v["min_clearance_m"], 5) for s, v in f["soles_in_take"].items()}
                            for k, f in report["frames"].items()},
          "plant": {k: f["plant_declared"] for k, f in report["frames"].items()}})


