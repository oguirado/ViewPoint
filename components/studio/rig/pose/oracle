UNIT = "studio.pose-oracle"
FLOOR_Z = 0.0
LOWER_IS_WORSE = {"sole_contact_insufficient"}
CLASS_ORDER = ["asset_substituted", "stale_inverse_bind", "part_deformed", "pose_not_reproduced",
               "joint_gap_visible", "seam_see_through", "socket_exposed", "interpenetration", "sole_not_touching",
               "sole_contact_insufficient", "floor_penetration", "rest_seam_open",
               "pivot_shifted", "fork_tip_damaged", "triangle_budget_exceeded", "exterior_not_closed",
               "bearing_clearance_out_of_range", "bearing_surface_unverified", "joint_stop_exceeded"]
CENSUS_VIEWS = [{"az_deg": float(a), "el_deg": 10.0} for a in (0, 60, 120, 180, 240, 300)]


# ------------------------------------------------------------------ plumbing
def emit(obj):
    print(json.dumps(obj, sort_keys=True))


def refuse(reason, retry_when=common.RETRY_PRECONDITION, next_command=None):
    emit({"reason": reason, "retry_when": retry_when,
          "next_command": next_command or ["./oracle", *sys.argv[1:]]})
    sys.exit(2)


def guard(fn):
    def wrapped(*args):
        try:
            return fn(*args)
        except common.Refusal as error:
            refuse(error.reason, error.retry_when, error.next_command)
        except (OSError, ValueError, KeyError, IndexError, TypeError, subprocess.TimeoutExpired) as error:
            refuse(f"harness:{type(error).__name__}:{error}"[:400])
    return wrapped


def absolute(path):
    return str(Path(path).resolve())


def resolve(map_doc):
    """Joint map with sole parts resolved to bone names, as the Blender scripts expect."""
    bones = {s: j["bone"] for s, j in map_doc["joints"].items() if j.get("bone")}
    out = json.loads(json.dumps(map_doc))
    for sole in out["soles"].values():
        sole["part"] = bones.get(sole["part"], sole["part"])
    return out


def run_blender(script, spec, work, name):
    """Run one Blender script from a spec file; return the command record and the report."""
    spec_path = Path(work) / f"{name}.spec.json"
    spec_path.write_text(json.dumps(spec, sort_keys=True) + "\n", encoding="utf-8")
    command = common.blender_command(ROOT / "blender" / script, [spec_path])
    record = common.invoke(command, work, name)
    out = Path(spec["out"])
    if not out.exists():
        tail = Path(record["stderr"]).read_text(errors="replace")[-700:]
        raise common.Refusal(f"{name}_no_report:{tail}"[:500])
    return record, common.load_json(out)


def checked(record, report, name):
    reason = (report.get("refusal") or {}).get("reason") or report.get("error")
    if reason or record["rc"]:
        tail = Path(record["stderr"]).read_text(errors="replace")[-500:]
        retry = common.RETRY_PRECONDITION
        if str(reason).startswith("joint_map_unresolved"):
            retry = "when the candidate's joint map names a bone of its GLB for every required joint"
        raise common.Refusal(f"{name}_rc_{record['rc']}:{reason}:{tail}"[:500], retry, ["./oracle", name])


# ------------------------------------------------------------------ inspect
def inspect_rig(rig, map_path, out_path, contract_path):
    """Reopen one GLB in Blender and write its identity and rest record."""
    rig, out_path = Path(rig).resolve(), Path(out_path).resolve()
    joint_map = resolve(common.load_json(map_path))
    tol = common.load_json(contract_path)["tolerances"]
    with tempfile.TemporaryDirectory(prefix=".inspect-", dir=os.environ.get("TMPDIR")) as tmp:
        spec = {"out": str(Path(tmp) / "rig.json"), "rig": str(rig), "joint_map": joint_map,
                "floor_z_m": FLOOR_Z, "seam_band_m": tol["seam_band_m"]["value"], "census_views": CENSUS_VIEWS}
        record, report = run_blender("blender_inspect.py", spec, tmp, "inspect")
        checked(record, report, "inspect")
    error, joints = glbmod.Glb(rig).bind_error()
    report["asset"].update({"inverse_bind_m": error, "inverse_bind_joints": joints})
    common.dump_json(out_path, report)
    return report


@guard
def cmd_inspect(args):
    if absolute(args.out) in {absolute(path) for path in (args.rig, args.map, args.contract)}:
        raise common.Refusal("output_aliases_input")
    report = inspect_rig(args.rig, args.map, args.out, args.contract)
    emit({"schema": report["schema"], "out": args.out,
          "asset": {k: report["asset"][k] for k in ("file_sha256", "structure_sha256", "vertices", "triangles", "joints")},
          "rest": report["rest"], "map_unresolved_required": report["map_unresolved_required"]})


# ------------------------------------------------------------------ sweep
@guard
def cmd_sweep(args):
    rig = common.load_json(args.reference)
    joint_map, contract = common.load_json(args.map), common.load_json(args.contract)
    if rig.get("schema") != "rp4.pose-oracle.rig.v1" or "error" in rig:
        raise common.Refusal("reference_not_inspected", "run ./oracle inspect on the reference GLB first",
                             ["./oracle", "inspect"])
    generator = sweepmod.Generator(rig, joint_map, contract, rig["rest"]["floor_z_m"])
    poses = generator.generate(args.profile, int(contract["sweep"]["seed"]))
    out_dir = Path(args.out_dir).resolve()
    out_dir.mkdir(parents=True, exist_ok=True)
    records = []
    for pose in poses:
        data = sweepmod.pose_bytes(pose)
        name = f"{pose['pose_id']}.pose.json"
        (out_dir / name).write_bytes(data)
        records.append({"pose_id": pose["pose_id"], "family": pose["family"], "file": name,
                        "sha256": hashlib.sha256(data).hexdigest(), "plant": pose["plant"], "expect": pose.get("expect")})
    manifest = sweepmod.manifest(records, args.profile, int(contract["sweep"]["seed"]), rig, joint_map, contract,
                                 rig["rest"]["floor_z_m"])
    common.dump_json(out_dir / "sweep.json", manifest)
    families = {}
    for rec in records:
        families[rec["family"]] = families.get(rec["family"], 0) + 1
    emit({"schema": manifest["schema"], "out": str(out_dir / "sweep.json"), "profile": args.profile,
          "poses": len(records), "families": families, "poses_digest": manifest["poses_digest"],
          "contract_sha256": manifest["contract_sha256"], "joint_map_sha256": manifest["joint_map_sha256"]})


