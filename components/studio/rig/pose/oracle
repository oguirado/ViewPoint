@guard
def cmd_scene(args):
    inputs = {label: {"path": absolute(getattr(args, label)), "sha256": getattr(args, f"{label}_sha256")}
              for label in ("incumbent", "candidate")}
    if absolute(args.out) in {item["path"] for item in inputs.values()}:
