{
  "$id": "urn:rea.game.replay_trace:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "qualified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "additionalProperties": false,
            "properties": {
              "schema": {
                "const": "rea.game.replay_metrics/v1"
              },
              "sha256": {
                "$ref": "urn:rea.frame:v1#/$defs/sha256"
              }
            },
            "required": [
              "schema",
              "sha256"
            ],
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "incomplete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "type": "null"
          }
        }
      }
    }
  ],
  "description": "Ordered state digests and an explicit qualification verdict.",
  "properties": {
    "actions_sha256": {
      "$ref": "urn:rea.frame:v1#/$defs/sha256"
    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "opaque"
          ]
        },
        "unresolved": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "scope",
        "unresolved"
      ],
      "type": "object"
    },
    "metrics": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "rea.game.replay_metrics/v1"
            },
            "sha256": {
              "$ref": "urn:rea.frame:v1#/$defs/sha256"
            }
          },
          "required": [
            "schema",
            "sha256"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "reset_sha256": {
      "$ref": "urn:rea.frame:v1#/$defs/sha256"
    },
    "rules": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "rea.game.rule_set/v1"
        },
        "sha256": {
          "$ref": "urn:rea.frame:v1#/$defs/sha256"
        }
      },
      "required": [
        "schema",
        "sha256"
      ],
      "type": "object"
    },
    "schema": {
      "const": "rea.game.replay_trace/v1"
    },
    "state_digests": {
      "items": {
        "$ref": "urn:rea.frame:v1#/$defs/sha256"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": false
    },
    "status": {
      "enum": [
        "qualified",
        "failed",
        "incomplete"
      ]
    }
  },
  "required": [
    "schema",
    "rules",
    "reset_sha256",
    "actions_sha256",
    "state_digests",
    "status",
    "metrics",
    "coverage"
  ],
  "title": "rea.game.replay_trace/v1",
  "type": "object"
}
