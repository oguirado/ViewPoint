      },
      "then": {
        "allOf": [
          {
            "properties": {
              "evidence": {
                "contains": {
                  "properties": {
                    "origin": {
                      "const": "frame"
                    }
                  },
                  "required": [
                    "origin"
                  ]
                }
              }
            }
          }
        ],
        "properties": {
          "evidence": {
            "items": {
              "properties": {
                "origin": {
                  "const": "frame"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "binary-only"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "evidence": {
                "contains": {
                  "properties": {
                    "origin": {
                      "const": "binary"
                    }
                  },
                  "required": [
                    "origin"
                  ]
                }
              }
            }
          }
        ],
        "properties": {
          "evidence": {
            "items": {
              "properties": {
                "origin": {
                  "const": "binary"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "video+binary"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "evidence": {
                "contains": {
                  "properties": {
                    "origin": {
                      "const": "frame"
                    }
                  },
                  "required": [
                    "origin"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "evidence": {
                "contains": {
                  "properties": {
                    "origin": {
                      "const": "binary"
                    }
                  },
                  "required": [
                    "origin"
                  ]
                }
              }
            }
          }
        ]
      }
    }
