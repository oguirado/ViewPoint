      "type": "array",
      "uniqueItems": true
    },
    "mode": {
      "enum": [
        "video-only",
        "binary-only",
        "video+binary"
      ]
    },
    "schema": {
      "const": "rea.reimpl_plan/v2"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
