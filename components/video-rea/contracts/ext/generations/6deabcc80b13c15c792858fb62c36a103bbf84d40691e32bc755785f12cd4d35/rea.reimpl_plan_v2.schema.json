        }
      },
      "required": [
        "schema",
        "sha256"
      ],
      "type": "object"
    },
    "steps": {
      "items": {
        "$ref": "urn:rea.game.evidence:v1#/$defs/claim"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "target": {
      "minLength": 1,
      "type": "string"
    }
