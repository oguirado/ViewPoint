{
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "schema": "rea.conformance_case/v1",
  "test_id": "event-and-presentation-time",
  "case": "nominal",
  "execution_profile": "offline_fixture",
  "fixture": {
    "clock_binding": {"clock_source": "pts", "time_base_numerator": 1, "time_base_denominator": 1000, "origin_tick": 0},
    "late_tolerance_ms": 0,
    "reference_events": [{"event_id": "a", "t_ms": 10}, {"event_id": "b", "t_ms": 10}, {"event_id": "c", "t_ms": 20}],
    "candidate_events": [{"event_id": "b", "t_ms": 10}, {"event_id": "a", "t_ms": 10}, {"event_id": "c", "t_ms": 20}],
    "reference_frames": [{"pts_tick": 0, "pixel_u8": 0}, {"pts_tick": 40, "pixel_u8": 8}, {"pts_tick": 95, "pixel_u8": 8}],
    "candidate_frames": [{"pts_tick": 0, "pixel_u8": 0}, {"pts_tick": 40, "pixel_u8": 8}, {"pts_tick": 95, "pixel_u8": 8}]
  },
  "expected": {
    "outcome": "pass", "code": "ORACLE_PASS",
    "reason": "Occurrences agree on the shared clock. The tied reference events impose no precedence, and all synthetic pixel samples align at their presentation ticks.",
    "assertions": [
      {"pointer": "/matched_event_ids", "equals": ["a", "b", "c"]},
      {"pointer": "/order_conflicts", "equals": []},
      {"pointer": "/aligned_pts_ticks", "equals": [0, 40, 95]},
      {"pointer": "/spatial_match", "equals": true},
      {"pointer": "/verdict", "equals": "match"}
    ]
  }
}
