{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rea.screen:v1",
  "title": "rea.screen/v1",
  "description": "Screen observation at a frame. Element digests address rea.ui_element artifacts. Missing detectors are enumerated even when another detector succeeds.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rea.screen/v1"
    },
    "provenance": {
      "$ref": "urn:rea.frame:v1#/$defs/provenance"
    },
    "screen_id": {
      "type": "string",
      "minLength": 1
    },
    "element_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[a-f0-9]{64}$"
      },
      "minItems": 0
    },
    "status": {
      "enum": [
        "ok",
        "degraded"
      ]
    },
    "degraded_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema",
    "provenance",
    "screen_id",
    "element_sha256",
    "status",
    "degraded_reasons"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "degraded_reasons": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "degraded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "degraded_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
