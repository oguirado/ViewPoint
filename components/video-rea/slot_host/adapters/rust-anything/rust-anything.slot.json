      "negctl:host/oracle-bank/outside-record-replay-compare@1",
      "negctl:host/oracle-bank/perception-and-pool@1",
      "negctl:host/oracle-bank/freshness-and-value-semantics@1",
      "negctl:host/oracle-bank/event-and-presentation-time@1",
      "negctl:host/oracle-bank/custody-and-wrong-binding@1",
      "negctl:host/oracle-bank/transport-parity-and-retry@1",
      "negctl:host/oracle-bank/oracle-independence-and-coverage@1",
      "negctl:host/oracle-bank/update-and-remove@1"
