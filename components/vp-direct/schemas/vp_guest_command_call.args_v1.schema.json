    "output.result": {
      "$id": "urn:vp_guest_command_call.output.result:v1",
      "title": "vp_guest_command_call.output.result/v1",
      "type": "object",
      "properties": {
        "output_ref": {
          "$ref": "urn:vp.artifact_ref:v1"
        }
