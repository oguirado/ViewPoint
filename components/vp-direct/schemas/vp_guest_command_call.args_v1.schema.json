      "type": "object",
      "properties": {
        "op": {
          "const": "cancel"
        },
        "workload_id": {
          "type": "string",
          "pattern": "^workload-[a-z0-9][a-z0-9._-]{0,63}$",
          "maxLength": 73
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "job_id": {
          "type": "string",
          "pattern": "^job-[a-z0-9][a-z0-9._-]{0,63}$",
          "maxLength": 68
