          "maxLength": 73
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "op",
        "workload_id",
        "generation"
      ],
      "additionalProperties": false
    },
    "stop.result": {
      "$id": "urn:vp_guest_command_call.stop.result:v1",
      "title": "vp_guest_command_call.stop.result/v1",
      "type": "object",
      "properties": {
        "workload_id": {
          "type": "string",
          "minLength": 1
        }
