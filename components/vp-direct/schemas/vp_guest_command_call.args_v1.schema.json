          "const": "run"
        },
        "workload_id": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "[\\x00-\\x1f\\x7f;&|<>$\\x60\\\\()!*?{}\\[\\]~#'\"]"
            }
          },
          "minItems": 1
        }
      },
      "required": [
        "op",
        "workload_id",
        "argv"
