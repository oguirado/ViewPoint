    {
      "if": {
        "properties": {
          "op": {
            "const": "create"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_guest_command_call.create.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "run"
          }
