    "create.result": {
      "$id": "urn:vp_guest_command_call.create.result:v1",
      "title": "vp_guest_command_call.create.result/v1",
      "type": "object",
      "properties": {
        "workload_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "workload_id",
        "generation"
      ],
      "additionalProperties": false
    },
    "run.args": {
      "$id": "urn:vp_guest_command_call.run.args:v1",
