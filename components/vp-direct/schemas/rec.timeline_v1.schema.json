{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rec.timeline:v1",
  "title": "rec.timeline/v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rec.timeline/v1"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mono_ns": {
            "type": "integer",
            "minimum": 0
          },
          "capsule_id": {
            "type": "string",
            "minLength": 1
          },
          "incarnation": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "demo",
              "channel",
              "cdp",
              "atspi",
              "human"
            ]
          },
          "op": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "click",
              "right_click",
              "double_click",
              "lpath_click",
              "focus",
              "paste",
              "type",
              "insert_text",
              "select",
              "press",
              "key",
              "hover",
              "scroll",
              "drag",
              "wait_signal",
              "navigate"
            ]
          },
          "text_len": {
            "type": "integer",
            "minimum": 0
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "value_len": {
            "type": "integer",
            "minimum": 0
          },
          "value_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "atspi_capture": {
            "const": "polling_only"
          },
          "frame": {
            "$ref": "urn:vp.frame:v1"
          },
          "gap": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "mono_ns",
          "capsule_id",
          "incarnation",
          "source"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "atspi"
                }
              },
              "required": [
                "source"
              ]
            },
            "then": {
              "required": [
                "atspi_capture"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "human"
                }
              },
              "required": [
                "source"
              ]
            },
            "then": {
              "properties": {
                "gap": {
                  "const": true
                }
              },
              "required": [
                "gap"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "action"
                    ]
                  },
                  {
                    "required": [
                      "text_len"
                    ]
                  },
                  {
                    "required": [
                      "text_sha256"
                    ]
                  },
                  {
                    "required": [
                      "value_len"
                    ]
                  },
                  {
                    "required": [
                      "value_sha256"
                    ]
                  },
                  {
                    "required": [
                      "frame"
                    ]
                  },
                  {
                    "required": [
                      "atspi_capture"
                    ]
                  }
                ]
              }
            }
          },
          {
            "dependentRequired": {
              "text_len": [
                "text_sha256"
              ],
              "text_sha256": [
                "text_len"
              ],
              "value_len": [
                "value_sha256"
              ],
              "value_sha256": [
                "value_len"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "events"
  ],
  "additionalProperties": false,
  "$comment": "TARGET collection shape: events contains joined, redacted records. Equal mono_ns preserves source order. Uses incarnation, superseding SF incarnation_id. No raw text, frame bytes or profile paths."
}
