{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vp.snapshot_receipt:v1",
  "title": "vp.snapshot_receipt/v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "vp.snapshot_receipt/v1"
    },
    "workload_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "acks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "participant": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "participant",
          "generation"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "admission_closed": {
      "type": "boolean"
    },
    "actions_reconciled": {
      "type": "boolean"
    },
    "channels_drained": {
      "type": "boolean"
    },
    "active_writers": {
      "type": "integer",
      "minimum": 0
    },
    "coverage": {
      "type": "object",
      "properties": {
        "ram": {
          "type": "boolean"
        },
        "machine": {
          "type": "boolean"
        },
        "disks": {
          "type": "boolean"
        },
        "devices": {
          "type": "boolean"
        }
      },
      "required": [
        "ram",
        "machine",
        "disks",
        "devices"
      ],
      "additionalProperties": false
    },
    "complete": {
      "type": "boolean"
    },
    "not_verified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "workload_id",
    "generation",
    "participants",
    "acks",
    "admission_closed",
    "actions_reconciled",
    "channels_drained",
    "active_writers",
    "coverage",
    "complete",
    "not_verified"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "properties": {
          "admission_closed": {
            "const": true
          },
          "actions_reconciled": {
            "const": true
          },
          "channels_drained": {
            "const": true
          },
          "active_writers": {
            "const": 0
          },
          "acks": {
            "minItems": 1
          },
          "not_verified": {
            "maxItems": 0
          }
        },
        "required": [
          "admission_closed",
          "actions_reconciled",
          "channels_drained",
          "active_writers",
          "acks",
          "not_verified"
        ]
      }
    }
  ]
}
