      "title": "vp_handoff_call.list.result/v1",
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "surface_id": {
                "type": "string",
                "minLength": 1
              },
              "step_index": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "surface_id",
              "step_index",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "rows"
      ],
      "additionalProperties": false
    },
    "ack.args": {
      "$id": "urn:vp_handoff_call.ack.args:v1",
      "title": "vp_handoff_call.ack.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "ack"
        },
        "surface_id": {
          "type": "string",
          "minLength": 1
        },
        "step_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "op",
        "surface_id",
        "step_index"
      ],
      "additionalProperties": false
    },
