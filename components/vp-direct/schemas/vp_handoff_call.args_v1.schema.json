      "required": [
        "op",
        "profile_id"
      ],
      "additionalProperties": false
    },
    "network_open.result": {
      "$id": "urn:vp_handoff_call.network_open.result:v1",
      "title": "vp_handoff_call.network_open.result/v1",
      "type": "object",
      "properties": {
        "mode": {
          "const": "open"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
