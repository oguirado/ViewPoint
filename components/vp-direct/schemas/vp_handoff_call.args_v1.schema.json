        "op": {
          "const": "network_allowlist"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "op",
        "profile_id",
        "domains"
      ],
      "additionalProperties": false
    },
    "network_allowlist.result": {
      "$id": "urn:vp_handoff_call.network_allowlist.result:v1",
      "title": "vp_handoff_call.network_allowlist.result/v1",
      "type": "object",
      "properties": {
        "mode": {
          "const": "allowlisted"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Named per-op args and result resources are embedded below. Only a verified binding in the registry admits dispatch."
}
