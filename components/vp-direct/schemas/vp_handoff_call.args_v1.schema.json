    "op": {
      "enum": [
        "list",
        "ack",
        "network_open",
        "network_allowlist"
      ]
    },
    "domains": {},
    "profile_id": {},
    "step_index": {},
    "surface_id": {}
  },
  "required": [
    "op"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "list"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_handoff_call.list.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "ack"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_handoff_call.ack.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "network_open"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_handoff_call.network_open.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "network_allowlist"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_handoff_call.network_allowlist.args:v1"
      }
    }
  ],
  "$defs": {
    "list.args": {
      "$id": "urn:vp_handoff_call.list.args:v1",
      "title": "vp_handoff_call.list.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "list"
