{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vp_capture_call.args:v1",
  "title": "vp_capture_call.args/v1",
  "type": "object",
  "properties": {
    "op": {
      "enum": [
        "screenshot",
        "frame_subscribe",
        "frame_unsubscribe",
        "ram_export",
        "ram_list",
        "ram_select"
      ]
    },
    "capsule_id": {},
    "dest_locator": {},
    "interest": {},
    "observation_id": {},
    "purpose": {},
    "recording_id": {},
    "session_id": {},
    "subscription_id": {},
    "surface_id": {}
  },
  "required": [
    "op"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "screenshot"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_capture_call.screenshot.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "frame_subscribe"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_capture_call.frame_subscribe.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "frame_unsubscribe"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_capture_call.frame_unsubscribe.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "ram_export"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_capture_call.ram_export.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "ram_list"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_capture_call.ram_list.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "ram_select"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_capture_call.ram_select.args:v1"
      }
    }
  ],
  "$defs": {
    "screenshot.args": {
      "$id": "urn:vp_capture_call.screenshot.args:v1",
      "title": "vp_capture_call.screenshot.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "screenshot"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "capsule_id": {
          "type": "string",
          "minLength": 1
        },
        "observation_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "session_id"
          ]
        },
        {
          "required": [
            "capsule_id"
          ]
        }
      ]
    },
    "screenshot.result": {
      "$id": "urn:vp_capture_call.screenshot.result:v1",
      "title": "vp_capture_call.screenshot.result/v1",
      "$ref": "urn:vp.frame:v1"
    },
    "frame_subscribe.args": {
      "$id": "urn:vp_capture_call.frame_subscribe.args:v1",
      "title": "vp_capture_call.frame_subscribe.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "frame_subscribe"
        },
        "surface_id": {
          "type": "string",
          "minLength": 1
        },
        "interest": {
          "enum": [
            "VERIFIED",
            "DISPLAY"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "op",
        "surface_id",
        "interest",
        "purpose"
      ],
      "additionalProperties": false
    },
    "frame_subscribe.result": {
      "$id": "urn:vp_capture_call.frame_subscribe.result:v1",
      "title": "vp_capture_call.frame_subscribe.result/v1",
      "type": "object",
      "properties": {
        "subscription_id": {
          "type": "string",
          "minLength": 1
        },
        "demand_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "subscription_id",
        "demand_id"
      ],
      "additionalProperties": false
    },
    "frame_unsubscribe.args": {
      "$id": "urn:vp_capture_call.frame_unsubscribe.args:v1",
      "title": "vp_capture_call.frame_unsubscribe.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "frame_unsubscribe"
        },
        "subscription_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "op",
        "subscription_id"
      ],
      "additionalProperties": false
    },
    "frame_unsubscribe.result": {
      "$id": "urn:vp_capture_call.frame_unsubscribe.result:v1",
      "title": "vp_capture_call.frame_unsubscribe.result/v1",
      "type": "object",
      "properties": {
        "subscription_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "subscription_id"
      ],
      "additionalProperties": false
    },
    "ram_export.args": {
      "$id": "urn:vp_capture_call.ram_export.args:v1",
      "title": "vp_capture_call.ram_export.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "ram_export"
        },
        "recording_id": {
          "type": "string",
          "minLength": 1
        },
        "dest_locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(af|file)://[^\\s]+$"
        }
      },
      "required": [
        "op",
        "recording_id",
        "dest_locator"
      ],
      "additionalProperties": false
    },
    "ram_export.result": {
      "$id": "urn:vp_capture_call.ram_export.result:v1",
      "title": "vp_capture_call.ram_export.result/v1",
      "type": "object",
      "properties": {
        "artifact_ref": {
          "$ref": "urn:vp.artifact_ref:v1"
        }
      },
      "required": [
        "artifact_ref"
      ],
      "additionalProperties": false
    },
    "ram_list.args": {
      "$id": "urn:vp_capture_call.ram_list.args:v1",
      "title": "vp_capture_call.ram_list.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "ram_list"
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    },
    "ram_list.result": {
      "$id": "urn:vp_capture_call.ram_list.result:v1",
      "title": "vp_capture_call.ram_list.result/v1",
      "type": "object",
      "properties": {
        "recordings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "recordings"
      ],
      "additionalProperties": false
    },
    "ram_select.args": {
      "$id": "urn:vp_capture_call.ram_select.args:v1",
      "title": "vp_capture_call.ram_select.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "ram_select"
        },
        "recording_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "op",
        "recording_id"
      ],
      "additionalProperties": false
    },
    "ram_select.result": {
      "$id": "urn:vp_capture_call.ram_select.result:v1",
      "title": "vp_capture_call.ram_select.result/v1",
      "type": "object",
      "properties": {
        "recording_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "recording_id"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Named per-op args and result resources are embedded below. Only a verified binding in the registry admits dispatch."
}
