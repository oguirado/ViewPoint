{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vp_data_call.args:v1",
  "title": "vp_data_call.args/v1",
  "type": "object",
  "properties": {
    "op": {
      "enum": [
        "resolve",
        "put",
        "lease_acquire",
        "lease_release",
        "status"
      ]
    },
    "artifact_ref": {},
    "device": {},
    "holder": {},
    "locator": {},
    "model_sha256": {},
    "sha256": {}
  },
  "required": [
    "op"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "resolve"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_data_call.resolve.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "put"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_data_call.put.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "lease_acquire"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_data_call.lease_acquire.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "lease_release"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_data_call.lease_release.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "status"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_data_call.status.args:v1"
      }
    }
  ],
  "$defs": {
    "resolve.args": {
      "$id": "urn:vp_data_call.resolve.args:v1",
      "title": "vp_data_call.resolve.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "resolve"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(af|file)://[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "op",
        "locator",
        "sha256"
      ],
      "additionalProperties": false
    },
    "resolve.result": {
      "$id": "urn:vp_data_call.resolve.result:v1",
      "title": "vp_data_call.resolve.result/v1",
      "$ref": "urn:vp.artifact_ref:v1"
    },
    "put.args": {
      "$id": "urn:vp_data_call.put.args:v1",
      "title": "vp_data_call.put.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "put"
        },
        "artifact_ref": {
          "$ref": "urn:vp.artifact_ref:v1"
        }
      },
      "required": [
        "op",
        "artifact_ref"
      ],
      "additionalProperties": false
    },
    "put.result": {
      "$id": "urn:vp_data_call.put.result:v1",
      "title": "vp_data_call.put.result/v1",
      "$ref": "urn:vp.artifact_ref:v1"
    },
    "lease_acquire.args": {
      "$id": "urn:vp_data_call.lease_acquire.args:v1",
      "title": "vp_data_call.lease_acquire.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "lease_acquire"
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "holder": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "enum": [
            "cpu",
            "gpu"
          ]
        }
      },
      "required": [
        "op",
        "model_sha256",
        "holder",
        "device"
      ],
      "additionalProperties": false
    },
    "lease_acquire.result": {
      "$id": "urn:vp_data_call.lease_acquire.result:v1",
      "title": "vp_data_call.lease_acquire.result/v1",
      "$ref": "urn:vp.model_lease:v1"
    },
    "lease_release.args": {
      "$id": "urn:vp_data_call.lease_release.args:v1",
      "title": "vp_data_call.lease_release.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "lease_release"
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "holder": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "enum": [
            "cpu",
            "gpu"
          ]
        }
      },
      "required": [
        "op",
        "model_sha256",
        "holder",
        "device"
      ],
      "additionalProperties": false
    },
    "lease_release.result": {
      "$id": "urn:vp_data_call.lease_release.result:v1",
      "title": "vp_data_call.lease_release.result/v1",
      "$ref": "urn:vp.model_lease:v1"
    },
    "status.args": {
      "$id": "urn:vp_data_call.status.args:v1",
      "title": "vp_data_call.status.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "status"
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    },
    "status.result": {
      "$id": "urn:vp_data_call.status.result:v1",
      "title": "vp_data_call.status.result/v1",
      "type": "object",
      "properties": {
        "copy": {
          "enum": [
            "file",
            "none"
          ]
        },
        "leases": {
          "type": "array",
          "items": {
            "$ref": "urn:vp.model_lease:v1"
          }
        }
      },
      "required": [
        "copy",
        "leases"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Named per-op args and result resources are embedded below. Only a verified binding in the registry admits dispatch."
}
