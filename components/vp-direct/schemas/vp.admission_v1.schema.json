{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vp.admission:v1",
  "title": "vp.admission/v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "vp.admission/v1"
    },
    "surface_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "ACTIVE",
        "ASLEEP",
        "WAKING",
        "OFF",
        "QUARANTINED"
      ]
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "admitted": {
      "type": "boolean"
    },
    "surface_count": {
      "type": "integer",
      "minimum": 0
    },
    "resident_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "retained_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "old_ring_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "new_ring_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "reserved_peak_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "available_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "margin_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "gpu_dependent": {
      "type": "boolean"
    },
    "gpu_accounted": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "surface_id",
    "state",
    "backend",
    "admitted",
    "surface_count",
    "resident_bytes",
    "retained_bytes",
    "old_ring_bytes",
    "new_ring_bytes",
    "reserved_peak_bytes",
    "available_bytes",
    "margin_percent",
    "gpu_dependent",
    "gpu_accounted"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "admitted": {
            "const": true
          }
        },
        "required": [
          "admitted"
        ]
      },
      "then": {
        "properties": {
          "surface_count": {
            "maximum": 16
          },
          "margin_percent": {
            "minimum": 15
          }
        },
        "required": [
          "surface_count",
          "margin_percent"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "admitted": {
            "const": true
          },
          "gpu_dependent": {
            "const": true
          }
        },
        "required": [
          "admitted",
          "gpu_dependent"
        ]
      },
      "then": {
        "properties": {
          "gpu_accounted": {
            "const": true
          }
        },
        "required": [
          "gpu_accounted"
        ]
      }
    }
  ]
}
