{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vp_identity_call.args:v1",
  "title": "vp_identity_call.args/v1",
  "type": "object",
  "properties": {
    "op": {
      "enum": [
        "login",
        "release"
      ]
    },
    "holder": {},
    "id": {},
    "profile_id": {}
  },
  "required": [
    "op"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "login"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_identity_call.login.args:v1"
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "release"
          }
        },
        "required": [
          "op"
        ]
      },
      "then": {
        "$ref": "urn:vp_identity_call.release.args:v1"
      }
    }
  ],
  "$defs": {
    "login.args": {
      "$id": "urn:vp_identity_call.login.args:v1",
      "title": "vp_identity_call.login.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "login"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
        }
      },
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false
    },
    "login.result": {
      "$id": "urn:vp_identity_call.login.result:v1",
      "title": "vp_identity_call.login.result/v1",
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": false
    },
    "release.args": {
      "$id": "urn:vp_identity_call.release.args:v1",
      "title": "vp_identity_call.release.args/v1",
      "type": "object",
      "properties": {
        "op": {
          "const": "release"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "holder": {
          "type": "string",
          "pattern": "^srf-id-[a-z0-9-]{1,40}$"
        }
      },
      "required": [
        "op",
        "profile_id",
        "holder"
      ],
      "additionalProperties": false
    },
    "release.result": {
      "$id": "urn:vp_identity_call.release.result:v1",
      "title": "vp_identity_call.release.result/v1",
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Named per-op args and result resources are embedded below. Only a verified binding in the registry admits dispatch."
}
