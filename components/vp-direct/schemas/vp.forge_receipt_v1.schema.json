            },
            "required": [
              "schema",
              "oracle",
              "negative_control"
            ]
          },
          "code": {
            "const": "OK"
          }
        },
        "required": [
          "gates",
          "code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transition": {
            "properties": {
              "from": {
                "const": "proposed"
              }
            },
            "required": [
              "from"
            ]
          }
        },
        "required": [
          "transition"
        ]
      },
      "then": {
        "properties": {
          "transition": {
            "properties": {
              "to": {
                "enum": [
                  "quarantined",
                  "rejected"
                ]
              }
            },
            "required": [
              "to"
            ]
          }
        },
        "required": [
          "transition"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transition": {
            "properties": {
              "from": {
                "const": "quarantined"
              }
            },
            "required": [
              "from"
            ]
          }
        },
        "required": [
          "transition"
        ]
      },
      "then": {
        "properties": {
          "transition": {
            "properties": {
              "to": {
                "enum": [
                  "validated",
                  "rejected"
                ]
              }
            },
            "required": [
              "to"
            ]
          }
        },
        "required": [
          "transition"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transition": {
            "properties": {
              "from": {
                "const": "validated"
              }
            },
            "required": [
              "from"
            ]
          }
        },
        "required": [
          "transition"
        ]
      },
      "then": {
        "properties": {
          "transition": {
            "properties": {
              "to": {
                "enum": [
                  "approved",
                  "rejected"
                ]
              }
            },
            "required": [
              "to"
            ]
          }
        },
        "required": [
          "transition"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transition": {
            "properties": {
              "from": {
                "const": "approved"
              }
            },
            "required": [
              "from"
            ]
          }
        },
        "required": [
          "transition"
        ]
      },
      "then": {
        "properties": {
          "transition": {
            "properties": {
              "to": {
                "enum": [
                  "admitted",
                  "rejected"
                ]
              }
            },
            "required": [
              "to"
            ]
          }
        },
        "required": [
          "transition"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transition": {
            "properties": {
              "to": {
                "const": "rejected"
              }
            },
            "required": [
              "to"
            ]
          }
        },
        "required": [
          "transition"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "not": {
              "const": "OK"
            }
          }
        }
      },
      "else": {
        "properties": {
          "code": {
            "const": "OK"
          }
        },
        "required": [
          "code"
        ]
      }
    }
