        "required": [
          "by",
          "actor",
          "capability_sha256",
          "manifest_generation",
          "gates",
          "code"
        ]
      },
      "else": {
        "properties": {
          "capability_sha256": {
            "const": null
          },
          "manifest_generation": {
            "const": null
          }
        },
        "required": [
          "capability_sha256",
          "manifest_generation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transition": {
            "properties": {
              "to": {
