{
  "schema": "vp.forge_tool/v1",
  "tool": "fixture-paste",
  "state": "proposed",
  "args_schema": {"text": "string"},
  "steps": [
    {"op": "vp_channel_call", "args": {"op": "locate", "session_id": "s-001", "target": "chat-prompt"}, "assert": {"exists": "chat-prompt"}},
