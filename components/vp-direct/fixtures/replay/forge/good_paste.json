  ],
  "oracle": {"post_state": "chat prompt box contains the input text", "check": "observe after act"},
  "negative_control": {"bad_input": "empty text", "must": "fail with input_text empty"},
  "risk_class": "enviar",
  "obligations": ["per-site pace", "operator approval for final send"],
  "proposed_by": "fixture",
  "parents": ["vp_channel_call"]
}
