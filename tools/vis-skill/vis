    if a.expect_change is None: a.expect_change='any'
    if not a.job and os.environ.get('DISPLAY'): fail(5,'inherited display is not owned')
    j=load(a.job,enforce_budget=False)
    j['loop_witness']=dict(before=None,after=None,obtained=False)
    if os.environ.get('MV_HOSTED')=='1': fail(5,MV_HOSTED_REFUSAL)
    if j['ownership'] not in ('started','adopted') and not j.get('allow_act'): fail(5,'attached display is read-only')
