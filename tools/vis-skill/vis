        result=dict(tools=tools,engines=eng,capabilities=caps,engines_unavailable=engines_unavailable,ram_available=os.statvfs('/dev/shm').f_bavail*os.statvfs('/dev/shm').f_frsize,tessdata=Path(os.environ.get('TESSDATA_PREFIX',str(Path.home()/'.local/share/tessdata'))).is_dir(),missing={ 'desktop':[k for k in ('Xvfb','xdotool','dbus-run-session','openbox','xprop','ffmpeg') if not tools[k]],'web':[] if tools['google-chrome'] else ['Chrome'],'electron':[] if os.environ.get('VIS_ELECTRON_BIN') else ['VIS_ELECTRON_BIN']},state_fields={'web':['role','name','states','box'],'desktop':'absent','electron':'absent'},responsiveness={'desktop':'Tk send on authorized targets; advertised _NET_WM_PING; otherwise PID/window and pixels','web':'CDP Runtime.evaluate','electron':'advertised _NET_WM_PING'},hosted_judge='absent: image-only effective capabilities unverified')
