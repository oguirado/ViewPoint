    return d

def prune_frames(j,reserve=0):
    root=jobpath(j['job']); frames=sorted(root.glob('frame_*.png'))
    removed=[]
    for p in frames[:max(0,len(frames)-(40-reserve))]:
        suffix=p.stem.split('_')[-1]; p.unlink(missing_ok=True)
        (root/('marks_'+suffix+'.png')).unlink(missing_ok=True)
        shutil.rmtree(root/('crops_'+suffix),ignore_errors=True)
        removed.append(str(p))
    if removed and (root/'job.json').exists():
        j['frames_dropped']=j.get('frames_dropped',0)+len(removed)
        retained=[name for name,st in j.get('steps',{}).items() if st.get('before') and Path(st['before']).is_file()]
        j['oldest_retained_step']=retained[0] if retained else None
        save(j)

def redact(text,limit=200):
    """Failure reasons for receipts: credential-shaped tokens replaced, bounded length."""
    text=str(text)
    for m in reversed(list(SECRET.finditer(text))):
        if is_secret(m.group(0)): text=text[:m.start()]+'[redacted]'+text[m.end():]
    return text[:limit]

def action_of(a):
    """The requested action, formatted like act receipts, for failure receipts."""
    if a is None: return None
    if a.verb!='act': return a.verb
    # rule() replaces a.type with the file content; receipts name the file instead.
    if a.type_file: return 'type-file:'+Path(a.type_file).name
    if a.type is not None: return a.type
    if a.text is not None: return a.text
    if a.ax: return 'ax:'+a.ax
    if a.click is not None: return 'mark:'+a.click
    if a.xy: return 'xy:'+a.xy
    return a.key

