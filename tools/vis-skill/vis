        eng=engines(); root.mkdir(mode=0o700)
        j=dict(job=a.job,ownership='adopted' if a.verb=='adopt' else 'attached',display=a.display,target_kind='desktop',size='1280x800',pids=pids,engines=eng,steps={},owner={'pid':os.getpid(),'start':identity(os.getpid())},allow_act=getattr(a,'allow_act',False),pidns=pid_namespace())
        try:
            probe=run(['xdotool','getdisplaygeometry'],env=desktop_env(j),check=False)
            if probe.returncode: fail(8,'authorized display unavailable')
            width,height=map(int,probe.stdout.split());j['size']=str(width)+'x'+str(height)
            save(j); CURRENT=j; receipt(j,0); return {'job':a.job,'display':a.display}
        except BaseException:
            shutil.rmtree(root,ignore_errors=True);raise
    j=load(a.job,enforce_budget=a.verb!='stop')
    if a.verb=='stop': return stop(j,keep_frames=a.keep_frames)
    if a.verb=='look':
        frame=capture(j); d=describe(j,frame)
        if j['target_kind']=='web': d['state']=state_observation(j)
        save_last(j,d); receipt(j,0,frame_sha_after=d['frame_sha256']); prune_frames(j); return d
    if a.verb=='check': return do_check(j,a)
    fail(2,'unknown verb')

def region_hash(path,box):
    w,h,rgb=pixels(path);x,y,bw,bh=box
    if x+bw>w or y+bh>h: fail(2,'region outside surface')
    return hashlib.sha256(b''.join(rgb[(row*w+x)*3:(row*w+x+bw)*3] for row in range(y,y+bh))).hexdigest()

def do_check(j,a):
    target(j)
    if not 2<=a.require_stable<=20: fail(2,'--require-stable must be between 2 and 20')
    baseline=None; box=None
    if a.region_changed_since:
        step,value=a.region_changed_since;box=rect(value);st=j.get('steps',{}).get(step)
        if not st: fail(2,'unknown step')
        baseline=st.get('before')
        if not baseline or not Path(baseline).is_file(): fail(3,'step baseline evicted or unavailable')
    snapshots=[];conditions=[];last=None;match_counts=[]
    for i in range(a.require_stable):
        if i: time.sleep(.12)
        if a.state or a.state_absent:
            if j['target_kind']!='web': fail(7,'STATE is web only; OCR is not state')
            value=a.state or a.state_absent
            if '=' not in value: fail(2,'STATE predicate requires role=name')
            role,name=value.split('=',1)
            if role not in rpc(j,{'op':'roles'})['roles']: fail(7,'role is outside STATE coverage')
            state=state_observation(j)
            matches=[n for n in state['nodes'] if n.get('role')==role and n.get('name')==name]
            if a.state_absent and any(n.get('role')=='article' for n in state['nodes']): fail(7,'opaque STATE subtree prevents absence proof')
            good=not matches if a.state_absent else bool(matches) and all(visible_node(n) for n in matches)
            snapshots.append(canonical(matches));conditions.append(good)
            match_counts.append(len(matches))
        elif a.window_title:
            if j['target_kind']=='web': fail(7,'X window title is desktop only')
            result=run(['xdotool','search','--onlyvisible','--name',a.window_title],env=desktop_env(j),check=False)
            names=[]
            if result.returncode==0:
                for wid in result.stdout.decode().split():
                    names.append([wid,run(['xdotool','getwindowname',wid],env=desktop_env(j)).stdout.decode()])
            snapshots.append(canonical(names));conditions.append(bool(names))
        elif baseline:
            last=capture(j)
            if not Path(baseline).is_file(): fail(3,'step baseline evicted during check')
            snapshots.append(region_hash(last,box));conditions.append(snapshots[-1]!=region_hash(baseline,box))
    passed=bool(conditions) and all(conditions) and len(set(snapshots))==1
    regions=[]
    if baseline and passed:
        d=describe(j,last,baseline);ev,changed=pixel_evidence(baseline,last,[],box)
        regions=[r for r in d['changed_regions'] if changed((r['x'],r['y'],r['w'],r['h']))]
        passed=ev['in_region'] and any(intersects(box,(r['x'],r['y'],r['w'],r['h'])) for r in regions)
    evidence={}
    if a.state or a.state_absent:
        evidence['observation']=dict(reads=len(snapshots),stable=len(set(snapshots))==1,
                                    conditions=conditions,match_counts=match_counts,
                                    matches_sha256=hashlib.sha256(snapshots[-1].encode()).hexdigest())
    if not passed: evidence['reason']='predicate failed or observations unstable'
    r=receipt(j,0 if passed else 3,frame_sha_before=frame_sha(baseline) if baseline else None,frame_sha_after=frame_sha(last) if last else None,changed_regions=regions,expected=a.state or a.state_absent or a.window_title or a.region_changed_since,action='check',**evidence)
    if not passed: fail(3,'predicate failed or observations unstable')
    return {'matched':True,'receipt':r}

def dispatch(a):
    if a.verb in ('look','check','stop'):
        j=load(a.job,enforce_budget=False)
        # Serialize frame/state publication without refusing concurrent readers.
        # Actors and teardown retain nonblocking exclusion.
        with lifecycle(j,wait=a.verb!='stop'):
            if a.verb=='stop':
                with actor(j): return _dispatch(a)
            return _dispatch(a)
    return _dispatch(a)

def main():
    global ARGS,DEADLINE
    DEADLINE=time.monotonic()+150
    rc=0; result={}; verb=sys.argv[1] if len(sys.argv)>1 else ''
    try:
        ARGS=parser().parse_args(); verb=ARGS.verb; result=dispatch(ARGS)
        if verb=='doctor' and result.get('drift'): rc=3
    except Failure as exc:
        rc=exc.rc; result=dict(reason=exc.reason,**exc.details)
        if CURRENT and ARGS and (jobpath(CURRENT['job'])/'job.json').exists():
            # Successful dispatch already writes its own receipt; avoid duplicating expectation failures.
            if not RECEIPTED:
                with contextlib.suppress(Exception): receipt(CURRENT,rc,reason=exc.reason,action=action_of(ARGS))
    except Exception as exc:
        rc=9; result={'reason':type(exc).__name__+': '+str(exc)}
        if CURRENT and ARGS:
            with contextlib.suppress(Exception):
                if not RECEIPTED: receipt(CURRENT,rc,reason=result['reason'],action=action_of(ARGS))
    if verb=='act': result['loop_witness']=CURRENT.get('loop_witness',dict(before=None,after=None,obtained=False)) if CURRENT else dict(before=None,after=None,obtained=False)
    print(canonical(dict(ok=rc==0,rc=rc,code=CODES[rc],verb=verb,**result)))
    return rc

