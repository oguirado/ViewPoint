           expected=getattr(ARGS,'expect_change',None),changed_regions=[],verdict='pass' if rc==0 else ('refused' if rc in (2,4,5) else 'fail'),
           rc=rc,code=CODES[rc],attempts=j.get('steps',{}).get(getattr(ARGS,'step',None),{}).get('attempts',0),attempts_scope='per_step_id',
           ref_wa=j.get('engines',{}).get('wender_ref'),ref_ve=j.get('engines',{}).get('ve_ref'),t_ms=int((time.monotonic()-START)*1000))
    if ARGS.verb=='act': r['loop_witness']=j.get('loop_witness',dict(before=None,after=None,obtained=False))
