# Provider key shapes, anchored at a token boundary and length-bounded, plus the PEM
# private-key header. Ordinary words such as "task-list" or "ask-sol" do not match.
# Each branch names its body (the part after the provider prefix) for is_secret().
_KB = r'(?<![A-Za-z0-9_-])'
SECRET = re.compile(
    _KB+r'sk-(?:proj|ant-(?:api|admin)\d\d)-(?P<sk_specific>[A-Za-z0-9_-]{20,512})'
    r'|'+_KB+r'sk-(?P<sk_generic>[A-Za-z0-9_-]{20,512})'
    r'|'+_KB+r'gh[pousr]_(?P<gh>[A-Za-z0-9]{36,255})'
    r'|'+_KB+r'github_pat_(?P<github_pat>[A-Za-z0-9_]{60,255})'
    r'|'+_KB+r'AIza(?P<aiza>[0-9A-Za-z_-]{35})'
    r'|'+_KB+r'xox[abprs]-(?P<xox>[0-9A-Za-z-]{10,255})'
    r'|(?P<pem>-----BEGIN [A-Z ]{0,40}PRIVATE KEY-----)')

def _key_body(kind,body):
    """Character evidence for a generated key, judged on the body alone (the prefix
    never counts). Fewer than 8 distinct characters is filler such as AIza000...;
    a provider prefix needs nothing more, so lowercase hex keys are refused. Bare sk-
    also names words ('sk-learn-...'): with - or _ it needs upper, lower and digits,
    without them letters and digits. Slack tokens always carry digits."""
    if len(set(body))<8: return False
    upper=any(c.isupper() for c in body); lower=any(c.islower() for c in body); digit=any(c.isdigit() for c in body)
    if kind=='sk_generic':
        return upper and lower and digit if ('-' in body or '_' in body) else (upper or lower) and digit
    if kind=='xox': return digit
    return True

def is_secret(text):
    """True when text holds a credential-shaped token (see _key_body) or a PEM private-key header."""
    if not isinstance(text,str) or not text: return False
    for m in SECRET.finditer(text):
        if m.lastgroup=='pem' or _key_body(m.lastgroup,m.group(m.lastgroup)): return True
    return False
