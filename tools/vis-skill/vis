        j['marks_valid']=passed
        if passed: j['marks_sha']=d['frame_sha256']
        retained=[name for name,item in steps.items() if item.get('before') and Path(item['before']).is_file()]
        j['oldest_retained_step']=retained[0] if retained else None
        save(j)
        sampling=dict(spacing_ms=spacing*1000,before_decode_ms=round(before_decode_ms,3),samples=sample_timings,
                      slow_factor=slow_factor,settle_degraded=slow_factor>2)
        r=receipt(j,0 if passed else 3,action=action,frame_sha_before=evidence['sha_before'],frame_sha_after=d['frame_sha256'],changed_regions=regions,sampling=sampling,
                  **({} if passed else {'reason':'expected visible change not verified'}))
        if not passed: fail(3,'expected visible change not verified')
        return dict(receipt=r,loop_witness=j['loop_witness'],sampling=sampling,**d)

class Parser(argparse.ArgumentParser):
    def error(self,message): fail(2,message)
    def exit(self,status=0,message=None): fail(2,message or 'use a documented verb')

def parser():
    p=Parser(add_help=False); sub=p.add_subparsers(dest='verb',required=True,parser_class=Parser)
    for verb in ('doctor','start','look','act','check','stop','sweep','adopt','attach'):
        s=sub.add_parser(verb,add_help=False)
        if verb not in ('doctor','sweep'): s.add_argument('--job')
        if verb in ('doctor','start'): s.add_argument('--target-repo')
        if verb=='doctor': s.add_argument('--skill',action='store_true')
        if verb=='stop': s.add_argument('--keep-frames',action='store_true')
        if verb=='start':
            g=s.add_mutually_exclusive_group(required=True)
            for x in ('app','web','electron'): g.add_argument('--'+x)
            s.add_argument('--size',default='1280x800'); s.add_argument('--timeout',type=float,default=30); s.add_argument('--wait-title'); s.add_argument('--headed',action='store_true'); s.add_argument('--mem',default='4G')
        if verb=='adopt': s.add_argument('--display',required=True); s.add_argument('--xvfb-pid',type=int,required=True)
        if verb=='attach': s.add_argument('--display',required=True); s.add_argument('--owner-ok',required=True); s.add_argument('--allow-act',action='store_true')
        if verb=='act':
            s.add_argument('--step'); g=s.add_mutually_exclusive_group(required=True)
            for x in ('click','xy','type','key','ax','type-file'): g.add_argument('--'+x)
            s.add_argument('--op',choices=('click','focus','type')); s.add_argument('--text'); s.add_argument('--expect-change'); s.add_argument('--mask',action='append',default=[]); s.add_argument('--settle-ms',type=int)
        if verb=='check':
            g=s.add_mutually_exclusive_group(required=True)
            for x in ('state','state-absent','window-title'): g.add_argument('--'+x)
            g.add_argument('--region-changed-since',nargs=2)
            s.add_argument('--require-stable',type=int,default=2)
    return p

def death_witness(root,children,oom):
    """Structured death witness: exits, OOM, then app.log; xvfb.log only when Xvfb
    itself exited, without its 'pci id for fd' noise."""
    exits=[{'pid':p.pid,'process':Path(p.args[0]).name,'returncode':p.returncode} for p in children if p.returncode is not None]
    log=''
    for logname in ('app.log','xvfb.log'):
        if logname=='xvfb.log' and not any(e['process']=='Xvfb' for e in exits): continue
        if (root/logname).exists():
            with open(root/logname,'rb') as f:
                f.seek(max(0,os.fstat(f.fileno()).st_size-1600)); text=f.read(1600).decode(errors='replace')
            log+='; '+logname+': '+'\n'.join(line for line in text.splitlines() if 'pci id for fd' not in line)
    return {'rc':6 if oom else 8,'reason':'scope memory budget exceeded' if oom else 'target exited: '+canonical(exits)+log,'oom':oom,'exits':exits}

# The scoped supervisor keeps CDP pipes and the desktop session alive between CLI invocations.
def serve(name):
    ctypes.CDLL(None).prctl(36,1,0,0,0)  # Reap descendants even when their session leader exits.
    j=readjson(jobpath(name)/'job.json'); root=jobpath(name); children=[]; server=None; c=None
    (root/'supervisor.started').write_text('started')
    def shutdown(*_): raise SystemExit
    signal.signal(signal.SIGTERM,shutdown); signal.signal(signal.SIGINT,shutdown)
    try:
        j['pids']=[{'pid':os.getpid(),'start':identity(os.getpid())}]
        if j['target_kind']!='web' or j.get('headed'):
            (root/'fb').mkdir(); rd,wr=os.pipe()
            with open(root/'xvfb.log','wb') as display_log:
                xp=sp.Popen(['Xvfb','-displayfd',str(wr),'-screen','0',j['size']+'x24','-fbdir',str(root/'fb'),'-nocursor','-nolisten','tcp','-noreset'],pass_fds=(wr,),stdout=sp.DEVNULL,stderr=display_log)
            children.append(xp); os.close(wr)
            deadline=time.monotonic()+10;line=b''
            try:
                # Xvfb writes the digits and newline separately. Reading
                # once and closing on digits races its final write (EPIPE),
                # killing the server just after an apparently valid number.
                while not line.endswith(b'\n'):
                    left=deadline-time.monotonic()
                    if left<=0 or not select.select([rd],[],[],max(0,left))[0]: fail(8,'Xvfb did not allocate a display')
                    block=os.read(rd,32-len(line))
                    if not block: fail(8,'incomplete Xvfb displayfd response')
                    line+=block
                    if len(line)>=32: fail(8,'invalid Xvfb displayfd response')
                number=line[:-1].decode()
            finally: os.close(rd)
            if not number.isdigit(): fail(8,'invalid Xvfb displayfd response')
            j.update(display=':'+number,fb=str(root/'fb/Xvfb_screen0')); j['pids'].append(record(xp))
        if j['target_kind']=='web':
            sys.path.insert(0,j['engines']['wender'])
            from wender.perceive import ax,browser,cdp_pipe
            from wender.act.cdp_executor import run_ax_action
            e=desktop_env(j); os.environ.update(e)
            os.environ['CHROME_BIN']=os.environ.get('CHROME_BIN','/usr/bin/google-chrome')
            # Chrome and all its temporary profile data stay inside the job.
            os.environ['TMPDIR']=str(root)
            c=cdp_pipe.CdpPipe(timeout=30,headless=not j.get('headed',False)); c.__enter__(); sid=c.attach_page(); c.navigate(sid,j['url']); c.send('Emulation.setDeviceMetricsOverride',{'width':int(j['size'].split('x')[0]),'height':int(j['size'].split('x')[1]),'deviceScaleFactor':1,'mobile':False},session_id=sid)
        else:
            cmd=j['command']
            app_log=open(root/'app.log','wb')
            wm_command='openbox & while :; do case "$(xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null)" in *"window id #"*) exec bash -c '+shlex.quote(cmd)+';; esac; sleep 0.05; done'
            app=sp.Popen(['dbus-run-session','--','bash','-c',wm_command],env=desktop_env(j),stdout=app_log,stderr=app_log)
            app_log.close()
            children.append(app); j['pids'].append(record(app)); j['clients']=[record(app)]
        cg=Path('/proc/self/cgroup').read_text().strip().split('::',1)[-1]
        j['cgroup']='/sys/fs/cgroup'+cg
        if j.get('launch')=='test-pidns': j['oom_kill_base']=oom_count(j)
        save(j)
        server=socket.socket(socket.AF_UNIX); server.bind(str(root/'helper.sock')); os.chmod(root/'helper.sock',0o600); server.listen(8); server.settimeout(.3)
        (root/'ready').write_text('ready')
        def read_nodes():
            raw=ax.raw_tree(c,sid)
            try:
                if not raw or not any(n.get('role',{}).get('value')=='RootWebArea' for n in raw): fail(7,'AX root missing')
                ids={n.get('nodeId') for n in raw}
                if len(ids)!=len(raw) or any(k not in ids for n in raw for k in n.get('childIds',[])): fail(7,'AX tree truncated')
                return ax.prune(raw)
            finally: ax.release(c,sid)
        def read_state():
            # Independently check the raw retrieval before accepting negative
            # predicates; pruning intentionally excludes static/provider text.
            read_nodes()
            state=browser.page_state(c,sid)
            from wender.state import schema
            if schema.validate_state(state): fail(7,'invalid STATE observation')
            return state
        def protected_node(wanted):
            if not wanted:
                r=c.send('Runtime.evaluate',{'expression':"Boolean(document.activeElement && (document.activeElement.matches('input[type=password]') || document.activeElement.getAttribute('aria-protected')==='true'))",'returnByValue':True},session_id=sid)
                return r.get('result',{}).get('value') is True
            nodes=read_nodes(); node=next((n for n in nodes if str(n['id'])==wanted),None)
            if node is None: fail(2,'AX target missing')
            d=c.send('DOM.describeNode',{'backendNodeId':node['backend_id']},session_id=sid)['node']
            attrs=d.get('attributes',[]); attrs=dict(zip(attrs[::2],attrs[1::2]))
            return attrs.get('type','').lower()=='password' or attrs.get('aria-protected')=='true'
        dead=False
        while True:
            if not dead and any(p.poll() is not None for p in children):
                (root/'target.exit.json').write_text(canonical(death_witness(root,children,oom_killed(j))))
                # Retain the scope and its memory.events until explicit
                # cleanup. The death witness makes every target verb fail;
                # a fast exit must not erase OOM evidence before observation.
                dead=True
            for pid,status in owned_descendants(os.getpid()):
                if status=='Z' and pid not in {p.pid for p in children}:
                    with contextlib.suppress(ChildProcessError): os.waitpid(pid,os.WNOHANG)
            try: conn,_=server.accept()
            except socket.timeout: continue
            with conn:
                try:
                    req=json.loads(conn.makefile('rb').readline(1024*1024)); op=req['op']; reply={}
                    if op=='stop': conn.sendall(b'{"stopped":true}\n'); break
                    if dead:
                        death=readjson(root/'target.exit.json');fail(death['rc'],death['reason'])
                    if op=='ping':
                        if c: c.send('Runtime.evaluate',{'expression':'1'},session_id=sid)
                        reply={'alive':True}
                    elif op=='state': reply={'state':read_state()}
                    elif op=='roles': reply={'roles':sorted(ax.CHASSIS_ROLES)}
                    elif op=='capture':
                        p=Path(req['path'])
                        if p.parent!=root or p.is_symlink(): fail(5,'capture path refused')
                        data=c.send('Page.captureScreenshot',{'format':'png'},session_id=sid)['data']; p.write_bytes(base64.b64decode(data))
                    elif op=='protected': reply={'protected':protected_node(req.get('node'))}
                    elif op=='action':
                        if os.environ.get('MV_HOSTED')=='1': fail(5,MV_HOSTED_REFUSAL)
                        if req.get('text') is not None and protected_node(req.get('ax')): fail(5,'protected input refused')
                        if req.get('ax'):
                            nodes=read_nodes(); n=next((n for n in nodes if str(n['id'])==req['ax']),None)
                            if n is None: fail(3,'AX target missing or hidden')
                            sn=next((v for v in read_state()['nodes'] if v['id']==req['ax']),None)
                            if sn is None or not visible_node(sn): fail(3,'AX target not visible')
                            if req.get('operation')=='type' and n.get('states',{}).get('protected'): fail(5,'protected input refused')
                            action={'op':req['operation'],'target':req['ax'],'irreversible':False}
                            if req.get('text') is not None: action['text']=req['text']
                            r=run_ax_action(c,sid,nodes,action,read_nodes,retries=1)
                            reply={'verified':bool(r.get('ok') and r.get('verified')),'ax_receipt':r}
                        elif req.get('xy'):
                            x,y=req['xy']; c.send('Input.dispatchMouseEvent',{'type':'mouseMoved','x':x,'y':y},session_id=sid); time.sleep(.3)
                            c.send('Input.dispatchMouseEvent',{'type':'mousePressed','x':x,'y':y,'button':'left','clickCount':1},session_id=sid); time.sleep(.1)
                            c.send('Input.dispatchMouseEvent',{'type':'mouseReleased','x':x,'y':y,'button':'left','clickCount':1},session_id=sid); reply={'verified':True}
                        elif req.get('text') is not None:
                            c.send('Input.insertText',{'text':req['text']},session_id=sid); reply={'verified':True}
                        else: fail(7,'web key input unavailable')
                    conn.sendall((canonical(reply)+'\n').encode())
                except Exception as exc:
                    conn.sendall((canonical({'error':str(exc),'rc':exc.rc if isinstance(exc,Failure) else 8})+'\n').encode())
    except BaseException as exc:
        if not isinstance(exc,SystemExit): (root/'failure.json').write_text(canonical({'rc':exc.rc if isinstance(exc,Failure) else 8,'reason':str(exc)}))
    finally:
        signal.signal(signal.SIGTERM,signal.SIG_IGN)
        signal.signal(signal.SIGINT,signal.SIG_IGN)
        if c:
            with contextlib.suppress(Exception): c.__exit__(None,None,None)
        if server: server.close()
        # Keep the subreaper alive through escalation and waitpid. A stopped
        # child cannot handle TERM; serial Popen.wait timeouts used to exceed
        # the caller's grace and orphan Xvfb before it could be reaped.
        descendants=[{'pid':pid,'start':identity(pid,include_dead=True)}
                     for pid,_ in owned_descendants(os.getpid())]
        for r in reversed(descendants):
            terminate(r)
            if alive(r):
                with contextlib.suppress(ProcessLookupError): os.kill(r['pid'],signal.SIGCONT)
        deadline=time.monotonic()+.8
        while any(alive(r) for r in descendants) and time.monotonic()<deadline:
            for p in children: p.poll()
            time.sleep(.02)
        for r in reversed(descendants):
            if alive(r):
                with contextlib.suppress(ProcessLookupError): os.kill(r['pid'],signal.SIGKILL)
        deadline=time.monotonic()+2
        while time.monotonic()<deadline:
            try:
                pid,_=os.waitpid(-1,os.WNOHANG)
                if not pid: time.sleep(.02)
            except ChildProcessError: break

def scope_members(j):
    scope=j.get('scope'); path=j.get('cgroup')
    if not scope or not path: return []
    if not re.fullmatch('vis-'+re.escape(j['job'])+r'-[0-9]+\.scope',scope): fail(5,'scope identity invalid')
    root=Path(path)
    if root.name!=scope or not str(root.resolve()).startswith('/sys/fs/cgroup/'): fail(5,'scope path invalid')
    if not root.exists(): return []
    result=run(['systemctl','--user','show',scope,'--property=ControlGroup','--value'],check=False,timeout=5)
    group=result.stdout.decode().strip()
    # A nonempty different path is a real mismatch, even for an empty scope.
    if group and '/sys/fs/cgroup'+group!=str(root): fail(5,'scope ownership not verified')
    try: members=[int(v) for v in (root/'cgroup.procs').read_text().split()]
    except FileNotFoundError: return []  # Collected between exists/show/read.
    if result.returncode or not group:
        if not members: return []  # No scope member can be signalled here.
        fail(5,'scope ownership not verified')
    return members

def shutdown_started(j, extra=()):
    root=jobpath(j['job']); records={}
    def add(rec):
        if present(rec): records[(rec['pid'],rec['start'])]=rec
    for rec in [*j.get('pids',[]),*extra]:
        add(rec)
        if alive(rec):
            for pid,status in owned_descendants(rec['pid']): add({'pid':pid,'start':identity(pid,include_dead=True)})
    for pid in scope_members(j): add({'pid':pid,'start':identity(pid,include_dead=True)})
    j['cleanup_pids']=list(records.values())
    if (root/'job.json').exists(): save(j)
    if (root/'helper.sock').exists():
        with contextlib.suppress(Failure): rpc(j,{'op':'stop'})
    deadline=time.monotonic()+5
    def pending():
        return any(present(r) for r in records.values())
    while pending() and time.monotonic()<deadline: time.sleep(.05)
    for rec in reversed(list(records.values())): terminate(rec)
    deadline=time.monotonic()+1
    while pending() and time.monotonic()<deadline: time.sleep(.05)
    for rec in reversed(list(records.values())):
        if alive(rec):
            with contextlib.suppress(ProcessLookupError): os.kill(rec['pid'],signal.SIGKILL)
    deadline=time.monotonic()+1
    while pending() and time.monotonic()<deadline: time.sleep(.05)
    if pending(): fail(8,'owned process did not stop or reap; job retained')
    if scope_members(j): fail(8,'owned scope is not empty; job retained')

# Test mode only: this reaper, a child of vis start in its own session, parents
# and reaps the supervisor and any orphan, as the user manager does otherwise.
TEST_REAPER='''import ctypes,os,subprocess,sys
ctypes.CDLL(None).prctl(36,1,0,0,0)
p=subprocess.Popen(sys.argv[1:],stdin=subprocess.DEVNULL,stdout=2,stderr=2)
os.write(1,(str(p.pid)+chr(10)).encode()); os.close(1); p.wait()
while True:
    try: os.wait()
    except ChildProcessError: break
'''

def test_pidns_mode():
    """NEWTON_TEST_PIDNS=1 inside a PID namespace other than the initial one (safe_run)."""
    return os.environ.get('NEWTON_TEST_PIDNS')=='1' and pid_namespace() not in (None,INIT_PIDNS)

def inherited_memory_cap(cgroups='/sys/fs/cgroup',membership='/proc/self/cgroup'):
    # Test mode has no transient scope: the caller's own cgroup must carry the cap.
    cg=Path(membership).read_text().strip().split('::',1)[-1]
    try: value=Path(cgroups+cg,'memory.max').read_text().strip()
    except OSError: value='max'
    if not value.isdigit(): fail(5,'test-mode start needs a memory-capped caller cgroup (safe_run)')
    return int(value)

def launch_test_supervisor(root,command):
    keep=('PATH','HOME','USER','LOGNAME','LANG','CHROME_BIN','TESSDATA_PREFIX','MV_HOSTED','NEWTON_TEST_PIDNS')
    with open(root/'scope.log','ab') as log:
        p=sp.Popen([sys.executable,'-I','-c',TEST_REAPER,*command],stdin=sp.DEVNULL,stdout=sp.PIPE,stderr=log,
                   env={k:os.environ[k] for k in keep if k in os.environ},start_new_session=True)
    try: line=p.stdout.readline(32) if select.select([p.stdout],[],[],remaining(10))[0] else b''
    finally: p.stdout.close()
    if not line.strip().isdigit(): fail(7,'test-mode supervisor launch failed')
    return {'pid':int(line),'start':identity(int(line))}

def session_runtime_missing():
    """Read-only probe of prerequisites for the production user-scope launcher."""
    runtime=os.environ.get('XDG_RUNTIME_DIR')
    prerequisite='XDG_RUNTIME_DIR must name an existing absolute directory owned by the current uid'
    try:
        path=Path(runtime) if runtime else None
        if path is None or not path.is_absolute() or not path.is_dir() or path.stat().st_uid!=os.getuid():
            return [prerequisite]
    except OSError: return [prerequisite]
    missing=[]
    if not shutil.which('systemd-run'): missing.append('systemd-run executable for user scope creation')
    bus='reachable user bus and user manager (systemctl --user show --property=Version --value)'
    if not shutil.which('systemctl'): missing.append(bus)
    else:
        try:
            probe=run(['systemctl','--user','show','--property=Version','--value'],check=False,timeout=3)
            if probe.returncode or not probe.stdout.strip(): missing.append(bus)
        except Failure: missing.append(bus)
    return missing

def require_session_runtime(prerequisites,**details):
    if prerequisites:
        prerequisite='; '.join(prerequisites)
        raise Failure(7,'session_runtime_absent: '+prerequisite,
                      cause='session_runtime_absent',prerequisite=prerequisite,**details)

def start(a):
    global CURRENT
    if not re.fullmatch(r'[1-9][0-9]{1,3}x[1-9][0-9]{1,3}',a.size): fail(2,'invalid size')
    if not 0<a.timeout<=120: fail(2,'timeout out of range')
    if not re.fullmatch(r'[1-9][0-9]*[MG]',a.mem): fail(2,'invalid memory cap')
    test_mode=test_pidns_mode(); cap=inherited_memory_cap() if test_mode else None
    if not test_mode: require_session_runtime(session_runtime_missing())
    root=jobpath(a.job)
    if root.exists(): fail(2,'job already exists')
    eng=engines(a.target_repo)
    if a.electron and not os.environ.get('VIS_ELECTRON_BIN'): fail(7,'VIS_ELECTRON_BIN is required')
    root.mkdir(mode=0o700)
    tmpfs(root)
    j=dict(job=a.job,ownership='started',display='web:'+a.job,target_kind='web' if a.web else 'electron' if a.electron else 'desktop',size=a.size,engines=eng,steps={},pids=[],owner={'pid':os.getpid(),'start':identity(os.getpid())},scope='vis-'+a.job+'-'+str(os.getpid())+'.scope',wait_title=a.wait_title,headed=a.headed,pidns=pid_namespace())
    if a.web: j['url']=a.web
    else: j['command']=a.app if a.app else shlex.join([os.environ['VIS_ELECTRON_BIN'],'--no-sandbox','--disable-gpu',a.electron])
    # Test mode (safe_run): no transient scope and no --mem; safe_run's cgroup caps memory.
    if test_mode: j.update(scope=None,launch='test-pidns',memory_cap=cap)
    save(j); CURRENT=j
    serve_cmd=[sys.executable,'-I',str(HERE/'vis'),'_serve',a.job]
    if not test_mode:
        # A detached Popen is adopted by an arbitrary ancestor subreaper, which
        # may never wait for it. Let the user manager parent/reap the supervisor;
        # systemd-run --scope still places the whole visual session in one scope.
        launcher=j['scope'][:-6]+'-launcher.service'; j['launcher']=launcher; save(j)
        command=['systemd-run','--user','--quiet','--collect','--service-type=exec','--unit='+launcher,
                 '-p','MemoryMax='+a.mem,'-p','MemorySwapMax=0','-p','OOMPolicy=continue',
                 '-p','StandardOutput=append:'+str(root/'scope.log'),'-p','StandardError=append:'+str(root/'scope.log')]
        for key in ('PATH','CHROME_BIN','TESSDATA_PREFIX','MV_HOSTED'):
            if key in os.environ: command+=['--setenv='+key+'='+os.environ[key]]
        command+=['--','systemd-run','--user','--scope','-q','-p','MemoryMax='+a.mem,'-p','MemorySwapMax=0','-p','OOMPolicy=continue','--collect','--unit='+j['scope'],*serve_cmd]
    started=None; deadline=time.monotonic()+a.timeout; last_issue='helper not ready'; last_rc=8
    try:
        if test_mode: started=launch_test_supervisor(root,serve_cmd)
        else:
            launched=run(command,check=False,timeout=10)
            if launched.returncode: fail(7,'supervisor launch failed: '+launched.stderr.decode(errors='replace')[-800:])
            pid=run(['systemctl','--user','show',launcher,'--property=MainPID','--value'],check=False,timeout=5).stdout.strip()
            if pid.isdigit() and int(pid): started={'pid':int(pid),'start':identity(int(pid))}
        while time.monotonic()<deadline:
            if (root/'failure.json').exists():
                failure=readjson(root/'failure.json');fail(failure['rc'],failure['reason'])
            if (root/'target.exit.json').exists():
                failure=readjson(root/'target.exit.json');fail(failure['rc'],failure['reason'])
            if started and not alive(started):
                # Recheck the supervisor's death witness; it may
                # have exited between the file check and this observation.
                if (root/'target.exit.json').exists():
                    failure=readjson(root/'target.exit.json');fail(failure['rc'],failure['reason'])
                fail(8 if (root/'supervisor.started').exists() else 7,'scope or target exited: '+(root/'scope.log').read_text()[-800:])
            if (root/'ready').exists():
                j=load(a.job)
                try: target(j); responsive(j); break
                except Failure as exc:
                    if exc.rc not in (7,8): raise
                    last_issue=exc.reason; last_rc=exc.rc
            time.sleep(.1)
        else: fail(last_rc,'target not ready: '+last_issue)
        # Capture availability is checked without brightness/readiness guesses.
        capture(j)
        receipt(j,0,action='start'); return dict(job=a.job,display=j['display'],scope=j['scope'],engines=eng)
    except BaseException as exc:
        if (root/'job.json').exists():
            with contextlib.suppress(Exception):
                j=load(a.job,enforce_budget=False)
                receipt(j,exc.rc if isinstance(exc,Failure) else 9,action='start',reason=exc.reason if isinstance(exc,Failure) else type(exc).__name__+': '+str(exc))
                persist_receipts(j)
        shutdown_started(j,[started] if started else [])
        remove_job(root); CURRENT=None
        raise

KEPT_FRAMES = re.compile(r'(frame|marks)_[0-9A-Za-z]+\.png')
KEPT_TTL = 24*3600

def remove_job(root,*,keep_frames=False):
    # A private GTK session can leave disconnected GVFS or portal mounts behind.
    # Unmount only mounts whose canonical path is below this exact owned job.
    root=root.resolve()
    for line in reversed(Path('/proc/self/mountinfo').read_text().splitlines()):
        fields=line.split(); mount=Path(re.sub(r'\\([0-7]{3})',lambda m: chr(int(m[1],8)),fields[4])).resolve()
        if root in mount.parents:
            if fields[fields.index('-')+1] not in ('fuse.gvfsd-fuse','fuse.portal'): fail(5,'unexpected job mount; refusing cleanup')
            exe=shutil.which('fusermount3') or shutil.which('fusermount')
            if not exe: fail(7,'private FUSE mount requires fusermount for cleanup')
            result=run([exe,'-u','-z',str(mount)],check=False)
            if result.returncode: fail(8,'private FUSE mount could not be detached')
    if not keep_frames:
        shutil.rmtree(root); return []
    # Keep only regular frame and marks PNGs in RAM, plus a dated marker for sweep.
    kept=[]
    for entry in root.iterdir():
        if KEPT_FRAMES.fullmatch(entry.name) and entry.is_file() and not entry.is_symlink(): kept.append(str(entry)); continue
        if entry.is_dir() and not entry.is_symlink(): shutil.rmtree(entry)
        else: entry.unlink()
    (root/'kept.json').write_text(canonical({'kept_at':time.time(),'frames':len(kept),'pidns':pid_namespace()})+'\n')
    return sorted(kept)

def latest_receipts(j,p):
    latest=p.parent/(j['job']+'.jsonl')
    temp=p.parent/('.'+j['job']+'-'+uuid.uuid4().hex+'.latest')
    try:
        temp.symlink_to(p.name)
        os.replace(temp,latest)
    finally: temp.unlink(missing_ok=True)
    return latest

def persist_receipts(j):
    root=jobpath(j['job'])
    dest=Path.home()/'.local/state/vis/receipts'; dest.mkdir(parents=True,exist_ok=True)
    p=dest/(j['job']+'-'+j['run_id']+'.jsonl')
    # Link a complete adjacent temporary with no replacement, even on collision.
    fd,temp=tempfile.mkstemp(prefix='.'+j['job']+'-',suffix='.tmp',dir=dest)
    try:
        with os.fdopen(fd,'wb') as f, open(root/'receipts.jsonl','rb') as source: shutil.copyfileobj(source,f)
        try: os.link(temp,p)
        except FileExistsError: fail(5,'receipt archive already exists; refusing overwrite')
        latest_receipts(j,p)
    finally: Path(temp).unlink(missing_ok=True)
    return p

def stop(j,keep_frames=False):
    global RECEIPTED
    root=jobpath(j['job'])
    if j['ownership']=='started': shutdown_started(j)
    dest=Path.home()/'.local/state/vis/receipts';dest.mkdir(parents=True,exist_ok=True)
    p=dest/(j['job']+'-'+j['run_id']+'.jsonl')
    if p.exists() or p.is_symlink(): fail(5,'receipt archive already exists; refusing overwrite')
    fd,name=tempfile.mkstemp(prefix='.'+j['job']+'-',suffix='.tmp',dir=dest);os.close(fd);temp=Path(name)
    try:
        shutil.copyfile(root/'receipts.jsonl',temp)
        kept=len([p for p in root.iterdir() if KEPT_FRAMES.fullmatch(p.name) and p.is_file() and not p.is_symlink()]) if keep_frames else None
        with open(temp,'a') as f: f.write(canonical(receipt(j,0,persist=False,action='stop',**({'kept_frames':kept} if keep_frames else {})))+'\n')
        frames=remove_job(root,keep_frames=keep_frames)
        try: os.link(temp,p)
        except FileExistsError: fail(5,'receipt archive already exists; refusing overwrite')
        latest=latest_receipts(j,p)
        RECEIPTED=True
    finally: temp.unlink(missing_ok=True)
    return {'receipts':str(p),'receipts_latest':str(latest),**({'kept_frames':frames} if keep_frames else {})}

