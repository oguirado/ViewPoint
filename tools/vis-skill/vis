def rect(s):
    try:
        v=tuple(map(int,s.split(',')))
        if len(v)!=4 or min(v[:2])<0 or min(v[2:])<=0: raise ValueError
        return v
    except ValueError: fail(2,'rectangle requires X,Y,W,H')

def intersects(a,b): return a[0]<b[0]+b[2] and b[0]<a[0]+a[2] and a[1]<b[1]+b[3] and b[1]<a[1]+a[3]

TYPE_FILE_MAX = 64*1024

def read_type_file(j,given):
    """--type-file: a regular, non-symlink file inside this job's RAM dir, at most
    64 KB of UTF-8. Every refusal before the read is decided from metadata alone."""
    root=os.path.realpath(jobpath(j['job']))
    path=os.path.abspath(given); parent=os.path.realpath(os.path.dirname(path))
    if parent!=root and not parent.startswith(root+os.sep): fail(5,'type-file must be inside the job RAM dir; not opened')
    target=os.path.join(parent,os.path.basename(path))
    try: st=os.lstat(target)
    except OSError: fail(5,'type-file absent; not opened')
    if not stat.S_ISREG(st.st_mode): fail(5,'type-file must be a regular non-symlink file; not opened')
    if st.st_size>TYPE_FILE_MAX: fail(5,'type-file larger than 64 KB; not opened')
    fd=os.open(target,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC)
    try:
        now=os.fstat(fd)
        if (now.st_dev,now.st_ino)!=(st.st_dev,st.st_ino) or not stat.S_ISREG(now.st_mode): fail(5,'type-file changed while opening')
        data=os.read(fd,TYPE_FILE_MAX+1)
    finally: os.close(fd)
    if len(data)>TYPE_FILE_MAX: fail(5,'type-file larger than 64 KB')
    try: return data.decode('utf-8')
    except UnicodeDecodeError: fail(5,'type-file is not UTF-8')

def rule(j,a):
    if os.environ.get('MV_HOSTED')=='1': fail(5,MV_HOSTED_REFUSAL)
    if j['ownership'] not in ('started','adopted') and not j.get('allow_act'): fail(5,'attached display is read-only')
    if a.type_file is not None: a.type=read_type_file(j,a.type_file)
    text=a.type if a.type is not None else a.text
    if is_secret(text): fail(5,'credential-shaped token refused; vis never types real secrets')
    if a.ax and j['target_kind']!='web': fail(7,'AX is web only')
    if a.ax and a.op=='type':
        nodes=rpc(j,{'op':'state'})['state'].get('nodes',[])
        node=next((n for n in nodes if str(n['id'])==a.ax),None)
        if node is None: fail(2,'unknown AX node')
        states=node.get('states',{})
        if node.get('protected') or (isinstance(states,dict) and states.get('protected')) or (isinstance(states,list) and 'protected' in states): fail(5,'protected input refused')
    if j['target_kind']=='web' and text is not None:
        if rpc(j,{'op':'protected','node':a.ax}).get('protected'): fail(5,'protected input refused')

def visible_node(node):
    box=node.get('box')
    if not isinstance(box,list) or len(box)!=4: fail(7,'target visible geometry unavailable')
    states=node.get('states',{})
    return box[2]>0 and box[3]>0 and states.get('hidden') not in (True,'true')

def state_observation(j):
    state=rpc(j,{'op':'state'}).get('state')
    if not isinstance(state,dict) or state.get('schema')!='wender.state/v1' or not isinstance(state.get('nodes'),list):
        fail(7,'STATE unavailable or malformed')
    if state.get('counts',{}).get('nodes')!=len(state['nodes']) or state.get('truncated') or state.get('incomplete'):
        fail(7,'STATE incomplete')
    if not any(n.get('role')=='RootWebArea' for n in state['nodes']): fail(7,'STATE root absent')
    return state

def do_act(a):
