    if a.verb=='sweep':
        safe_base(); removed=[]; skipped=[]
        for p in BASE.iterdir():
            if p.is_dir() and not p.is_symlink() and not (p/'job.json').exists() and (p/'kept.json').is_file():
                # Frames kept by stop --keep-frames: no processes, receipts archived.
                try: kept=readjson(p/'kept.json'); kept_at=float(kept['kept_at'])
                except (OSError,ValueError,KeyError,TypeError): kept={}; kept_at=(p/'kept.json').stat().st_mtime
                if not isinstance(kept,dict) or not same_pid_namespace(kept): skipped.append(p.name)
                elif time.time()-kept_at>KEPT_TTL: remove_job(p); removed.append(p.name)
                else: skipped.append(p.name)
                continue
            if p.is_dir() and not p.is_symlink() and (p/'job.json').exists():
                try:
                    j=load(p.name,enforce_budget=False)
                    with lifecycle(j),actor(j):
                        # A recorded death witness means the target is gone even
                        # while its supervisor still serves: stop and remove it.
                        dead=j['ownership']=='started' and (p/'target.exit.json').exists()
                        if alive(j.get('owner',{})) or (not dead and any(alive(r) for r in j.get('pids',[]))): skipped.append(p.name); continue
                        probe=run(['xdotool','getdisplaygeometry'],env=desktop_env(j),timeout=3,check=False) if j['target_kind']!='web' and not dead else None
                        if probe and probe.returncode==0: skipped.append(p.name); continue
                        stop(j); removed.append(p.name)
                except Failure as exc:
                    if exc.rc==5: skipped.append(p.name)
                    else: raise
