def remaining(default):
    if DEADLINE is None: return default
    value = min(default, DEADLINE-time.monotonic())
    if value <= 0: fail(6, 'operation time budget exceeded')
    return value

class Failure(Exception):
    def __init__(self, rc, reason, **details): self.rc, self.reason, self.details = rc, reason, details

def fail(rc, reason): raise Failure(rc, reason)
def canonical(v): return json.dumps(v, sort_keys=True, separators=(',', ':'), ensure_ascii=True)
def run(cmd, *, env=None, cwd=None, timeout=30, check=True):
    # Bound both time and collected output, including a noisy/broken engine.
    try:
        p = sp.Popen(cmd, env=env, cwd=cwd, stdout=sp.PIPE, stderr=sp.PIPE, start_new_session=True)
    except FileNotFoundError: fail(7, 'missing executable: '+str(cmd[0]))
    output = {p.stdout:bytearray(), p.stderr:bytearray()}
    deadline = time.monotonic()+remaining(timeout)
    try:
        with selectors.DefaultSelector() as poll:
            for f in output: poll.register(f, selectors.EVENT_READ)
            while poll.get_map():
                left = deadline-time.monotonic()
                if left <= 0: fail(6, 'command time budget exceeded')
                for key,_ in poll.select(min(left,.1)):
                    block = os.read(key.fd,65536)
                    if not block: poll.unregister(key.fileobj); continue
                    output[key.fileobj].extend(block)
                    if len(output[key.fileobj]) > (8*1024*1024 if key.fileobj is p.stdout else 65536):
                        fail(6, 'subprocess output budget exceeded')
            p.wait(timeout=max(.01,deadline-time.monotonic()))
        r = sp.CompletedProcess(cmd,p.returncode,bytes(output[p.stdout]),bytes(output[p.stderr]))
    except BaseException as exc:
        with contextlib.suppress(ProcessLookupError): os.killpg(p.pid,signal.SIGKILL)
        p.wait()
        if isinstance(exc,sp.TimeoutExpired): fail(6,'command time budget exceeded')
        raise
    finally:
        p.stdout.close(); p.stderr.close()
    if check and r.returncode: fail(7, 'command failed: '+str(cmd[0])+': '+r.stderr.decode(errors='replace')[-1000:])
    return r

def tmpfs(path):
    # Linux statfs: f_type is the first native long. No external df parsing.
    buf = ctypes.create_string_buffer(256)
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.statfs(os.fsencode(path), buf) or ctypes.c_long.from_buffer(buf).value != 0x01021994:
        fail(5, 'frames require tmpfs')

def safe_base():
    tmpfs('/dev/shm')
    p = Path('/dev/shm')
    for part in ('vqa-cu','vis'):
        p = p / part
        if p.is_symlink(): fail(5, 'symlink in RAM root')
        p.mkdir(mode=0o700, exist_ok=True)
        if p.stat().st_uid != os.getuid(): fail(5, 'RAM root owned by another uid')
    tmpfs(BASE)

def jobpath(name):
    if not name or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,63}', name): fail(2, 'invalid job')
    safe_base()
    p = BASE / name
    if p.is_symlink(): fail(5, 'symlink job refused')
    return p

def readjson(p): return json.loads(p.read_text())

INIT_PIDNS = 'pid:[4026531836]'  # the kernel's initial PID namespace (PROC_PID_INIT_INO)
def pid_namespace():
    try: return os.readlink('/proc/self/ns/pid')
    except OSError: return None

def same_pid_namespace(record):
    # Recorded PIDs mean other processes in another PID namespace. Records made
    # before this field existed were made on the host (the initial namespace).
    return record.get('pidns',INIT_PIDNS)==pid_namespace()
@contextlib.contextmanager
def state_lock(name):
    with open(jobpath(name)/'state.lock','a') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        yield

def save_unlocked(j):
    j.setdefault('run_id',uuid.uuid4().hex)
    p = jobpath(j['job']) / 'job.json'
    t = p.with_suffix('.tmp-'+str(os.getpid()))
    t.write_text(canonical(j)+'\n'); os.replace(t,p)

def save(j):
    with state_lock(j['job']): save_unlocked(j)

def save_last(j,d):
    with state_lock(j['job']):
        fresh=readjson(jobpath(j['job'])/'job.json');fresh['last']=d
        fresh['marks_valid']=True;fresh['marks_sha']=d['frame_sha256'];save_unlocked(fresh)

def load(name, enforce_budget=True):
    global CURRENT
    p = jobpath(name)
    if not (p/'job.json').is_file(): fail(2,'unknown job')
    j = readjson(p/'job.json')
    if j.get('job') != name: fail(5,'job identity mismatch')
    if not same_pid_namespace(j): fail(5,'job belongs to another PID namespace; its processes are not visible here')
    if 'run_id' not in j:
        # Upgrade a live pre-extension job once, under the existing state lock.
        with state_lock(name):
            j=readjson(p/'job.json'); save_unlocked(j)
    CURRENT = j
    if enforce_budget: budget(j)
    return j

def identity(pid, *, include_dead=False):
    try:
        p = Path('/proc')/str(pid)
        if p.stat().st_uid != os.getuid(): return None
        fields = (p/'stat').read_text().rsplit(')',1)[1].split()
        if not include_dead and fields[0] in ('Z','X','x'): return None
        return str(int(fields[19]))
    except (OSError,IndexError,ValueError): return None

def record(p): return {'pid':p.pid,'start':identity(p.pid)}
def alive(r): return r.get('start') is not None and identity(r['pid']) == r['start']
def present(r): return r.get('start') is not None and identity(r['pid'],include_dead=True) == r['start']
def owned_descendants(pid):
    rows={}
    for p in Path('/proc').glob('[0-9]*'):
        try:
            f=(p/'stat').read_text().rsplit(')',1)[1].split()
            rows[int(p.name)]=(int(f[1]),f[0])
        except (OSError,ValueError,IndexError): pass
    own={pid}; changed=True
    while changed:
        changed=False
        for child,(parent,state) in rows.items():
            if parent in own and child not in own: own.add(child);changed=True
    return [(p,rows[p][1]) for p in own if p!=pid and p in rows]

def terminate(r):
    if alive(r):
        with contextlib.suppress(ProcessLookupError): os.kill(r['pid'],signal.SIGTERM)

def budget(j):
    # App downloads have their own lifetime and remain memory-capped by the
    # enclosing scope. Prune their two private cache trees before traversal.
    root=jobpath(j['job']); excluded={root/'home/.cache',root/'cache'}; total=0
    for directory,dirs,files in os.walk(root,followlinks=False):
        base=Path(directory)
        dirs[:]=[name for name in dirs if base/name not in excluded and not (base/name).is_symlink()]
        for name in files:
            path=base/name
            if not path.is_symlink() and path.is_file(): total+=path.stat().st_size
            if total>2*1024**3: fail(6,'job RAM budget exceeded')

def select_refs(target_repo=None):
    refs = dict(readjson(HERE/'vis.json')['defaults'])
    reasons = {k:'default: no target repository' for k in refs}
    chosen = target_repo or os.environ.get('VIS_TARGET_REPO')
    if chosen:
        lock = Path(chosen).resolve()/'deps.lock'
        if lock.is_symlink(): fail(5,'symlink dependency lock refused')
        if not lock.exists(): reasons = {k:'default: deps.lock absent' for k in refs}
        else:
            try:
                if lock.stat().st_size>1024*1024: fail(2,'dependency lock too large')
                data=readjson(lock)
            except (OSError,ValueError): fail(2,'invalid dependency lock')
            if not isinstance(data,dict): fail(2,'dependency lock must be an object')
            entries=data.get('dependencies',data.get('deps',data))
            if isinstance(entries,list):
                mapped={}
                for entry in entries:
                    if not isinstance(entry,dict) or not isinstance(entry.get('name'),str): fail(2,'invalid dependency entry')
                    if entry['name'] in mapped: fail(2,'duplicate dependency entry')
                    mapped[entry['name']]=entry
                entries=mapped
            if not isinstance(entries,dict): fail(2,'invalid dependency entries')
            for name,key in [('wender-agent','wender_ref'),('vision-engine','ve_ref')]:
                if name not in entries: reasons[key]='default: '+name+' entry absent'; continue
                entry=entries[name]
                sha=entry.get('commit') if isinstance(entry,dict) else None
                if not isinstance(sha,str) or not re.fullmatch('[0-9a-f]{40}',sha): fail(2,'invalid commit pin: '+name)
                refs[key]=sha; reasons[key]='deps.lock commit: '+str(lock)
    return dict(refs,selection=reasons,target_repo=str(Path(chosen).resolve()) if chosen else None)

ENGINE_ARCHIVE_HINT = 'point VIS_WENDER_REPO/VIS_VE_REPO at git clones of the engine repositories'

def _has_pinned_commit(repo, sha):
    # True only when repo is a git checkout that contains the pinned commit.
    # A plain vendored directory inside this repository is not one: `git -C`
    # there either fails or resolves to the monorepo, which lacks the pin.
    try:
        r = sp.run(['git', '-C', str(repo), 'cat-file', '-e', sha + '^{commit}'],
                   stdout=sp.DEVNULL, stderr=sp.DEVNULL, timeout=10, check=False)
        return r.returncode == 0
    except (OSError, ValueError):
        return False

def _engine_archive_message(name, var, repo, sha, detail=''):
    text = ('engine archive unavailable: ' + name + ' source ' + str(repo)
            + ' (via ' + var + ' or vendored default) is not a git checkout containing '
            'pinned commit ' + sha + ': ' + ENGINE_ARCHIVE_HINT)
    return text + ': ' + detail if detail else text

def engines(target_repo=None):
    result = select_refs(target_repo)
    cache = Path.home()/'.cache/vis'
    try:
        cache.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        fail(7, 'engine archive unavailable: cannot prepare engine cache ' + str(cache) + ': ' + ENGINE_ARCHIVE_HINT + ': ' + type(exc).__name__ + ': ' + str(exc))
    for name,key,var,default in [('wender','wender_ref','VIS_WENDER_REPO',str(HERE.parent.parent/'components'/'wender-agent')),('ve','ve_ref','VIS_VE_REPO',str(HERE.parent.parent/'components'/'vision-engine'))]:
        sha = result[key]
        if not re.fullmatch('[0-9a-f]{40}',sha): fail(7,'engine pin is not a full commit SHA')
        dest = cache/(name+'-'+sha)
        if dest.is_symlink(): fail(5,'symlink engine cache refused')
        repo = os.environ.get(var,default)
        try:
            lock_file = open(cache/(name+'-'+sha+'.lock'),'a')
        except OSError as exc:
            fail(7, _engine_archive_message(name, var, repo, sha, 'cannot prepare engine cache lock: ' + type(exc).__name__ + ': ' + str(exc)))
        with lock_file as lock:
            fcntl.flock(lock,fcntl.LOCK_EX)
            if not dest.exists():
                temp = Path(tempfile.mkdtemp(prefix=name+'-',dir=cache))
                try:
                    if not _has_pinned_commit(repo,sha):
                        fail(7, _engine_archive_message(name, var, repo, sha))
                    archive=sp.Popen(['git','-C',repo,'archive',sha],stdout=sp.PIPE,stderr=sp.DEVNULL)
                    try:
                      try:
                        with tarfile.open(fileobj=archive.stdout,mode='r|') as tf:
                          for m in tf:
                            if m.name.startswith('/') or '..' in Path(m.name).parts or not (m.isfile() or m.isdir()): fail(5,'unsafe engine archive')
                            # Only vetted regular files/directories; works on
                            # Python 3.11 before tarfile's filter API existed.
                            tf.extract(m,temp)
                      except (tarfile.ReadError, EOFError, OSError) as exc:
                        fail(7, _engine_archive_message(name, var, repo, sha, 'git archive produced no usable archive: ' + type(exc).__name__ + ': ' + str(exc)))
                      if archive.wait(timeout=30): fail(7, _engine_archive_message(name, var, repo, sha, 'git archive exited nonzero'))
                    finally:
                        archive.stdout.close()
                        if archive.poll() is None: archive.kill(); archive.wait()
                    for p in temp.rglob('*'):
                        if p.is_file(): p.chmod(0o555 if os.access(p,os.X_OK) else 0o444)
                        elif p.is_dir(): p.chmod(0o555)
                    temp.chmod(0o555); os.rename(temp,dest)
                finally:
                    if temp.exists(): shutil.rmtree(temp)
        result[name] = str(dest)
    return result

def engine_env(j):
    e = os.environ.copy(); e.pop('DISPLAY',None)
    e.update(PYTHONDONTWRITEBYTECODE='1',PYTHONPATH=j['engines']['ve'],TESSDATA_PREFIX=os.environ.get('TESSDATA_PREFIX',str(Path.home()/'.local/share/tessdata')))
    return e

def desktop_env(j):
    e = engine_env(j); root = jobpath(j['job'])
    for key,sub in [('HOME','home'),('XDG_CONFIG_HOME','config'),('XDG_CACHE_HOME','cache'),('XDG_DATA_HOME','data'),('XDG_RUNTIME_DIR','runtime'),('TMPDIR','tmp')]:
        (root/sub).mkdir(mode=0o700,exist_ok=True); e[key]=str(root/sub)
    e.update(DISPLAY=j['display'],LANG='C.UTF-8',LANGUAGE='C',GIO_USE_VFS='local',GVFS_DISABLE_FUSE='1',GTK_USE_PORTAL='0')
    for key in ('DBUS_SESSION_BUS_ADDRESS','SESSION_MANAGER','XAUTHORITY','WAYLAND_DISPLAY','DBUS_STARTER_ADDRESS','DBUS_STARTER_BUS_TYPE'):
        e.pop(key,None)
    return e

@contextlib.contextmanager
def lifecycle(j, *, wait=False, limit=150, expired='job reader wait exceeded time budget'):
    path=jobpath(j['job'])/'lock'
    if path.is_symlink(): fail(5,'job lock symlink')
    with open(path,'a') as f:
        deadline=time.monotonic()+remaining(limit) if wait else None
        while True:
            try:
                fcntl.flock(f,fcntl.LOCK_EX|fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if not wait: fail(5,'job operation in progress')
                left=deadline-time.monotonic()
                if left<=0: fail(6,expired)
                time.sleep(min(.02,left))
        yield

def display_identity(display):
    # Local screens belong to the same X server, and must exclude each other.
    match=re.fullmatch(r':(0|[1-9][0-9]*)(?:\.(0|[1-9][0-9]*))?',display)
    return ':'+match[1] if match else display

@contextlib.contextmanager
def actor(j):
    # One actor per display whatever the ownership: started, adopted and attached
    # jobs on one display share one display-wide lock file. It lives outside every
    # job directory and is never unlinked, so its inode stays stable for all holders.
    p = BASE/('.actor-'+hashlib.sha256(display_identity(j['display']).encode()).hexdigest())
    if p.is_symlink(): fail(5,'actor lock symlink')
    with open(p,'a') as f:
        try: fcntl.flock(f,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError: fail(5,'another actor holds this display')
        yield

def rpc(j,request):
    s = socket.socket(socket.AF_UNIX); s.settimeout(remaining(5 if request.get('op')=='ping' else 35))
    try:
        s.connect(str(jobpath(j['job'])/'helper.sock')); s.sendall((canonical(request)+'\n').encode())
        f=s.makefile('rb'); reply=json.loads(f.readline(8*1024*1024))
    except (OSError,ValueError): fail(8,'target helper unavailable')
    finally: s.close()
    if 'error' in reply: fail(reply.get('rc',8),reply['error'])
    return reply

def oom_count(j):
    cgroup=j.get('cgroup')
    if cgroup and Path(cgroup,'memory.events').exists():
        events=dict(line.split() for line in Path(cgroup,'memory.events').read_text().splitlines())
        return int(events.get('oom_kill','0'))
    return 0

def oom_killed(j):
    # A test-mode job shares safe_run's cgroup: only kills after its start count.
    return oom_count(j)>j.get('oom_kill_base',0)

def target(j):
    if oom_killed(j): fail(6,'scope memory budget exceeded')
    death=jobpath(j['job'])/'target.exit.json'
    if death.exists():
        failure=readjson(death); fail(failure['rc'],failure['reason'])
    if not all(alive(r) for r in j['pids']): fail(8,'recorded target process died')
    if j['ownership']=='started' and j['pids']:
        if any(status in ('T','t') for pid,status in owned_descendants(j['pids'][0]['pid'])): fail(8,'owned target process is stopped')
    if j['target_kind']!='web':
        r=run(['xdotool','search','--onlyvisible','--name',j.get('wait_title') or '.'],env=desktop_env(j),timeout=5,check=False)
        if r.returncode or not r.stdout.strip(): fail(8,'target window absent or unresponsive')
        for wid in r.stdout.decode().split():
            pr=run(['xdotool','getwindowpid',wid],env=desktop_env(j),timeout=5,check=False)
            if pr.returncode==0 and pr.stdout.strip().isdigit():
                pid=int(pr.stdout)
                try:
                    status=(Path('/proc')/str(pid)/'stat').read_text().rsplit(')',1)[1].split()[0]
                    if status in ('T','t','Z'): fail(8,'window owner stopped or dead')
                except OSError: fail(8,'window owner disappeared')
        # A stopped window owner is not responsive even though Xvfb can still capture it.
        for rec in j.get('clients',[]):
            if alive(rec):
                with contextlib.suppress(OSError):
                    if (Path('/proc')/str(rec['pid'])/'stat').read_text().rsplit(')',1)[1].split()[0] in ('T','t'): fail(8,'target is stopped')
    else: rpc(j,{'op':'ping'})

def responsive(j):
    """Probe the target loop, not the X server or the capture supervisor."""
    if j['target_kind']=='web':
        rpc(j,{'op':'ping'}); return True
    try: return desktop_responsive(j)
    except Failure as exc:
        # A missing optional loop witness leaves target()/pixel checks in force.
        # Demonstrated timeouts and other target/budget failures still propagate.
        if exc.rc==7: return False
        raise

def desktop_responsive(j):
    env=desktop_env(j)
