def frame_sha(path):
    return hashlib.sha256(pixels(path)[2]).hexdigest()

_PIXELS_CACHE = OrderedDict()

def pixels(path):
    """Decode file bytes once, retaining at most four content-addressed RGB frames."""
    data=Path(path).read_bytes(); key=hashlib.sha256(data).digest()
    if key in _PIXELS_CACHE:
        _PIXELS_CACHE.move_to_end(key)
        return _PIXELS_CACHE[key]
    result=_decode_png(data)
    _PIXELS_CACHE[key]=result
    if len(_PIXELS_CACHE)>4: _PIXELS_CACHE.popitem(last=False)
    return result

def _decode_png(data):
    """Independent PNG decoder for RGB/RGBA, not an engine assertion."""
    if data[:8]!=b'\x89PNG\r\n\x1a\n': fail(7,'invalid capture PNG')
    offset=8; compressed=[]; w=h=channels=None
    while offset<len(data):
        length=struct.unpack('>I',data[offset:offset+4])[0]; kind=data[offset+4:offset+8]
        body=data[offset+8:offset+8+length]; crc=struct.unpack('>I',data[offset+8+length:offset+12+length])[0]
        if zlib.crc32(kind+body)&0xffffffff!=crc: fail(7,'capture PNG CRC failed')
        offset+=length+12
        if kind==b'IHDR':
            w,h,depth,color,comp,filt,interlace=struct.unpack('>IIBBBBB',body)
            if depth!=8 or color not in (2,6) or interlace or w*h>16777216: fail(7,'unsupported capture PNG')
            channels=3 if color==2 else 4
        elif kind==b'IDAT': compressed.append(body)
        elif kind==b'IEND': break
    if not channels: fail(7,'capture PNG lacks header')
    raw=zlib.decompress(b''.join(compressed)); stride=w*channels
    if len(raw)!=(stride+1)*h: fail(7,'capture PNG length mismatch')
    previous=bytearray(stride); rows=[]
    def paeth(a,b,c):
        p=a+b-c; pa=abs(p-a); pb=abs(p-b); pc=abs(p-c)
        return a if pa<=pb and pa<=pc else b if pb<=pc else c
    for y in range(h):
        start=y*(stride+1); f=raw[start]; row=bytearray(raw[start+1:start+1+stride])
        if f>4: fail(7,'unsupported PNG filter')
        if f:
            for x in range(stride):
                left=row[x-channels] if x>=channels else 0; up=previous[x]; ul=previous[x-channels] if x>=channels else 0
                predictor=left if f==1 else up if f==2 else (left+up)//2 if f==3 else paeth(left,up,ul)
                row[x]=(row[x]+predictor)&255
        if channels==4:
            rgb=bytearray(w*3); rgb[0::3]=row[0::4]; rgb[1::3]=row[1::4]; rgb[2::3]=row[2::4]; rows.append(bytes(rgb))
        else: rows.append(bytes(row))
        previous=row
    return w,h,b''.join(rows)

def pixel_evidence(before,after,masks,region=None,*,before_pixels=None,after_pixels=None):
    w,h,b=before_pixels if before_pixels is not None else pixels(before)
    w2,h2,a=after_pixels if after_pixels is not None else pixels(after)
    if (w,h)!=(w2,h2): fail(8,'capture dimensions changed')
    a=bytearray(a)
    for mask in masks:
        x,y,mw,mh=rect(mask)
        for row in range(y,min(y+mh,h)):
            lo=(row*w+min(x,w))*3; hi=(row*w+min(x+mw,w))*3; a[lo:hi]=b[lo:hi]
    def changed(box):
        x,y,bw,bh=box
        for row in range(max(y,0),min(y+bh,h)):
            lo=(row*w+max(x,0))*3; hi=(row*w+min(x+bw,w))*3
            if a[lo:hi]!=b[lo:hi]: return True
        return False
    return dict(different=a!=b,in_region=changed(region) if region else a!=b,
                sha_before=hashlib.sha256(b).hexdigest(),sha_after=hashlib.sha256(bytes(a)).hexdigest()),changed

def describe(j,frame,prev=None,masks=()):
    root=jobpath(j['job']); suffix=frame.stem.split('_')[-1]; marks=root/('marks_'+suffix+'.png'); crops=root/('crops_'+suffix)
    cmd=[sys.executable,'-m','vadapt.cu_describe','--frame',str(frame),'--marks-out',str(marks),'--ocr-marks','--json']
    if prev:
        crops.mkdir(mode=0o700,exist_ok=True)
        cmd+=['--prev',str(prev),'--crop-dir',str(crops)]
    for mask in masks: cmd+=['--mask',mask]
    r=run(cmd,cwd=j['engines']['ve'],env=engine_env(j)); d=json.loads(r.stdout)
    if not isinstance(d,dict) or not isinstance(d.get('marks'),list) or not isinstance(d.get('changed_regions'),list): fail(7,'invalid vision-engine observation')
    d.update(frame=str(frame),marks_png=str(marks))
    d['frame_sha256']=frame_sha(frame)
