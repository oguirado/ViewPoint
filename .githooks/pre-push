#!/bin/sh
# Local G-SECRETS guard. Install from the repository root with:
#   install -m 755 .githooks/pre-push .git/hooks/pre-push
# Rejects the push when the shared secrets gate fails. Fails closed: a
# missing git, python3 or gitleaks binary blocks the push. Each outgoing
# commit is checked against the destination ref's advertised old tip when
# it is an ancestor. A rewrite scans the outgoing commit's full ancestry.
set -eu
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
command -v git >/dev/null 2>&1 || { echo "pre-push: git is not installed; the push stays blocked" >&2; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "pre-push: python3 is not installed; the push stays blocked" >&2; exit 1; }
command -v gitleaks >/dev/null 2>&1 || { echo "pre-push: gitleaks is not installed; install v8.18.4 or the push stays blocked" >&2; exit 1; }
scanner=$(command -v gitleaks)
case "$scanner" in
  /*) : ;;
  *) echo "pre-push: gitleaks resolved to a non-absolute path; the push stays blocked" >&2; exit 1 ;;
esac
[ -f "$scanner" ] && [ -x "$scanner" ] || { echo "pre-push: gitleaks is not an executable file; the push stays blocked" >&2; exit 1; }
scan() {
  python3 -I tests/fixtures/secrets/gate.py gate --gitleaks "$scanner" \
    --repo "$root" "$@" </dev/null || {
    echo "pre-push: secrets gate rejected the push" >&2
    exit 1
  }
}
seen_update=false
while read -r local_ref local_oid remote_ref remote_oid extra ||
      [ -n "$local_ref$local_oid$remote_ref$remote_oid$extra" ]; do
  seen_update=true
  if [ -z "$local_ref" ] || [ -z "$remote_ref" ] || [ -n "$extra" ]; then
    echo "pre-push: invalid ref update" >&2
    exit 1
  fi
  case "$local_oid$remote_oid" in
    *[!0123456789abcdef]*) echo "pre-push: invalid ref update" >&2; exit 1 ;;
  esac
  case "${#local_oid}:${#remote_oid}" in
    40:40 | 64:64) ;;
    *) echo "pre-push: invalid ref update" >&2; exit 1 ;;
  esac
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  case "$remote_oid" in
    *[!0]*)
      if git --no-replace-objects merge-base --is-ancestor "$remote_oid" "$local_oid"; then
        :
      elif [ "$?" -eq 1 ]; then
        remote_oid=
      else
        echo "pre-push: could not verify the destination ancestry" >&2
        exit 1
      fi ;;
    *) remote_oid= ;;
  esac
  scan --candidate "$local_oid" --base "$remote_oid"
done
if [ "$seen_update" = false ]; then
  scan
fi
