      "argv": [
        "capsule",
        "start"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "capsule": {
            "type": "string",
            "description": "Capsule name."
          },
          "mode": {
            "type": "string",
            "enum": [
              "program",
              "browser"
            ]
          },
          "target": {
            "type": "string",
            "description": "Program path or URL."
          },
          "dry_run": {
            "type": "boolean",
            "description": "Preview only: report what would run and start nothing."
          }
        },
        "required": [
          "capsule"
        ],
        "additionalProperties": false
      },
      "destructive": false
