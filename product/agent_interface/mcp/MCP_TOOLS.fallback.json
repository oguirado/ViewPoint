    {
      "name": "vp_capsule_list",
      "description": "List ViewPoint capsules and their state.",
      "argv": [
        "capsule",
        "list"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "dry_run": {
            "type": "boolean",
            "description": "Preview only: report what would run and start nothing."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "destructive": false
    },
    {
