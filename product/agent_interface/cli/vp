def mcp(tool, with_confirm=False):
    """ViewPoint MCP tool; --session FILE selects VP_MCP_SESSION (path only, never read by vp)."""
    def build(o, rest):
        rest = list(rest)
        sess = take(rest, "--session")
        if with_confirm and o["confirm"]:
            rest += ["--confirm", o["confirm"]]
        d = mcp_tool(tool)(o, rest)
        if sess:
            d["env"]["VP_MCP_SESSION"] = os.path.abspath(sess)
        if not os.path.exists(d["env"]["VP_MCP_SESSION"]):
            d["need"], d["need_code"] = d["env"]["VP_MCP_SESSION"], "NO_TAKE"
        return d
    return build


def job_guard(o, job, kind, new):
    """Ownership: new jobs carry the vpops prefix; existing ones must be in the ledger or --foreign-ok JOB."""
    if not job:
        return
    if o["dry_run"]:  # a dry run starts nothing: report the refusal the real call would get
        if not (ledger_has(kind, job) or job in o["foreign_ok"]) and not (new and job.startswith(os.environ.get("VP_JOB_PREFIX", "vpops"))):
            WOULD_REFUSE.append("FOREIGN_JOB")
        return
    prefix = os.environ.get("VP_JOB_PREFIX", "vpops")
    owned = ledger_has(kind, job) or job in o["foreign_ok"]
    if new and not job.startswith(prefix) and not owned:
        raise Stop("FOREIGN_JOB", "new jobs must start with %r (or pass --foreign-ok %s)" % (prefix, job), {"job": job})
    if not new and not owned:
        raise Stop("FOREIGN_JOB", "job %r is not in this session's ledger (vp sys jobs); pass --foreign-ok %s to insist" % (job, job),
                   {"job": job}, ["vp sys jobs"])


def b_vision(verb, new=False, owned=True):
    def build(o, rest):
        job = flag(rest, "--job")
        if verb == "sweep" and "sweep" not in o["foreign_ok"] and not o["dry_run"]:
            pass  # sweep only reaps the skill's own leftovers; gated by --confirm sweep
        elif owned:
            job_guard(o, job, "vision", new)
        d = dict(argv=["python3", "-I", P["vision"], verb, *rest], need=P["vision"])
        if new and job:
            d["track"] = ("vision", job)
        return d
    return build


def b_blender_start(o, rest):
    u = "vp blender start --job vpopsNAME [--rt RT] [--bridge ref|hybrid] [--size WxH] [--mem M]"
    rest = list(rest)
    job = take(rest, "--job", True, u)
    rt, bridge = take(rest, "--rt"), take(rest, "--bridge") or "ref"
    size, mem = take(rest, "--size") or "1920x1080", take(rest, "--mem") or "8G"
    job_guard(o, job, "vision", True)
    if bridge == "hybrid":
        if not o["allow_hybrid"]:
            raise Stop("FORBIDDEN_PATH", "bridge=hybrid drives the hybrid lane; refused without --allow-hybrid")
        bpath = os.path.join(P["blender_dir"], "blender_bridge.py")
    elif bridge == "ref":
        bpath = os.path.join(os.path.dirname(P["ref_broker"]), "bridge.py")
    else:
        raise Stop("USAGE", "--bridge ref|hybrid", {"usage": u})
    env = {"VP_SWARM_RT": os.path.abspath(rt)} if rt else {}
    return dict(argv=["python3", "-I", P["vision"], "start", "--job", job, "--size", size, "--mem", mem, "--app",
                      "blender --factory-startup --python " + bpath, "--wait-title", "Blender", *rest],
                env=env, need=bpath, track=("vision", job))


