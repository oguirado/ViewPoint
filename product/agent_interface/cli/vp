def _sys(what, rest):
    if what == "paths":
        return {"paths": P, "override": "env VP_OPS_<KEY>, or a JSON file at $VP_OPS_CONFIG / cli/vp_paths.json", "version": VERSION}
    if what == "jobs":
        rows = ledger_rows()[-50:]
        for r in rows:
            if r.get("kind") == "pid":
                r["alive"] = _pid_start(r["id"]) is not None and (not r.get("start") or _pid_start(r["id"]) == r["start"])
        return {"jobs": rows, "ledger": _ledger_path()}
    if what == "help":
        names = [a for a in rest if not a.startswith("--")]
        tools = design_tools()
        if len(names) < 2:
            idx = {}
            for (n, v), s in sorted(VERBS.items()):
                if not names or names[0] == n:
                    idx.setdefault(n, []).append("%s[%s]" % (v, s["kind"]))
            return {"count": sum(len(v) for v in idx.values()), "commands": idx, "classes": "R read, W write-own, X start, H human-facing, D destructive (--confirm)"}
        key = " ".join(names[:2])
        s = VERBS.get((names[0], names[1]))
        if not s:
            raise Stop("NOT_FOUND", "unknown command: vp " + key, nxt=["vp sys help"])
        out = {"command": "vp " + key, "command_class": s["kind"], "help": s["help"], "usage": s.get("usage", "")}
        t = tools.get(key)
        if t:
            req = set(t["inputSchema"].get("required", []))
            out.update(summary=t.get("description"), wraps=t.get("wraps"), codes=t.get("codes"),
                       args={("--" + k.replace("_", "-")): ("required " if k in req else "") + str(v.get("type", "")) + ": " + str(v.get("description", ""))[:120]
                             for k, v in t["inputSchema"]["properties"].items()})
        return out
    if what == "doctor":
        rows, miss = [], []
        for k, v in sorted(P.items()):
            if k in ("state_dir", "docs_router", "docs_router_alt", "docs_dir", "vp_mcp_session", "design_tools", "design_tools_alt"):
                continue
            okp = os.path.exists(v)
            rows.append({"cap": k, "status": "PASS" if okp else "FAIL", "path": v})
            if not okp:
                miss.append(k)
        for name, keys in (("docs_router", ("docs_router", "docs_router_alt")), ("design_tools", ("design_tools", "design_tools_alt"))):
            hit = [P[k] for k in keys if os.path.isfile(P[k])]
            rows.append({"cap": name, "status": "PASS" if hit else "FAIL", "path": hit[0] if hit else P[keys[0]]})
            if not hit:
                miss.append(name)
        tools = design_tools()
        mine = {"%s %s" % k for k in VERBS}
        cov = {"design": len(tools), "implemented": len(mine & set(tools)), "not_implemented": sorted(set(tools) - mine), "extra": sorted(mine - set(tools))} if tools else {}
        data = {"rows": rows, "missing": miss, "coverage": cov, "spooler": "newton-py" if os.path.isfile(P["npy"]) else "builtin"}
        if miss:
            raise Stop("DEPENDENCY", "%d dependencies missing: %s" % (len(miss), ", ".join(miss)), data, ["vp sys paths"])
        return data
    raise Stop("USAGE", "unknown sys verb")


