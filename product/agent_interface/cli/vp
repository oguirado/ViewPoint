_FOOT = re.compile(r"# \[newton sh: rc=(-?\d+) lines=(\d+) bytes=(\d+) sha256=([0-9a-f]{64}) spool_capped=(\d+) full=(\S+)")


def run_child(plan, o, env):
    """Run argv through newton-py `sh` (spool + bounded preview). Fallback: builtin spooler."""
    argv = plan["argv"]
    if os.path.isfile(P["npy"]) and not plan.get("raw"):
        cmd = [P["npy"], "sh", "--tail", str(o["tail"])] + (["--head", str(o["head"])] if o["head"] else []) + \
              ["--timeout-s", str(o["timeout_s"]), "--", *argv]
        try:
            r = subprocess.run(cmd, cwd=plan.get("cwd"), env=env, capture_output=True, text=True, errors="replace",
                               timeout=o["timeout_s"] + 15, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            return dict(rc=124, preview=[], spooler="newton-py")
        text = r.stdout + r.stderr
        m = None
        for m in _FOOT.finditer(text):
            pass
        if m:
            body = (text[:m.start()] + text[m.end():]).splitlines()
            body = [x for x in body if not x.startswith("| preview:") and x.strip()]
            body = [x for x in body if not re.match(r"^.*\| read: .*newton read .*\]$", x)]
            return dict(rc=int(m.group(1)), lines=int(m.group(2)), bytes=int(m.group(3)), sha256=m.group(4),
                        spool=m.group(6), preview=body, spooler="newton-py")
        return dict(rc=r.returncode, preview=text.splitlines()[-o["tail"]:], spooler="newton-py(no footer)")
    # builtin: raw newton-py verbs (already bounded) and the no-newton fallback
    os.makedirs(os.path.join(P["state_dir"], "spool"), mode=0o700, exist_ok=True)
    try:
        r = subprocess.run(argv, cwd=plan.get("cwd"), env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           timeout=o["timeout_s"], stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return dict(rc=124, preview=[], spooler="builtin")
    except OSError as e:
        raise Stop("NOT_FOUND", "cannot execute %s: %s" % (argv[0], e.strerror))
    out = r.stdout
    sha = hashlib.sha256(out).hexdigest()
    spool = os.path.join(P["state_dir"], "spool", "vp-%s.log" % sha[:16])
    with open(spool, "wb") as f:
        f.write(out)
    lines = out.decode("utf-8", "replace").splitlines()
    cap = 80 if plan.get("raw") else o["tail"]
    return dict(rc=r.returncode, lines=len(lines), bytes=len(out), sha256=sha, spool=spool,
                preview=lines[-cap:], spooler="newton-py(direct)" if plan.get("raw") else "builtin")


def child_json(res):
    """Last line of the child's output as JSON (from the spool, capped), else None."""
    src = None
    sp = res.get("spool")
    if sp and res.get("bytes", 0) <= 262144:
        try:
            with open(sp, errors="replace") as f:
                src = f.read()
        except OSError:
            src = None
    if src is None:
        src = "\n".join(res.get("preview") or [])
    for line in reversed(src.strip().splitlines()[-3:]):
        line = line.strip()
        if line.startswith("{") and line.endswith("}"):
            try:
                return json.loads(line)
            except ValueError:
                continue
    return None


def detach(plan, env):
    os.makedirs(os.path.join(P["state_dir"], "spool"), mode=0o700, exist_ok=True)
    log = os.path.join(P["state_dir"], "spool", "detached-%d-%d.log" % (int(time.time()), os.getpid()))
    with open(log, "wb") as f:
        p = subprocess.Popen(plan["argv"], cwd=plan.get("cwd"), env=env, stdout=f, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, start_new_session=True)
    ledger_add("pid", p.pid, argv=plan["argv"][:6], log=log, start=_pid_start(p.pid))
    return {"pid": p.pid, "log": log}


def parse(argv):
    o = dict(dry_run=False, confirm=None, impl="ref", tail=5, head=0, timeout_s=120, detach=False,
             allow_display=[], allow_hybrid=False, foreign_ok=[], json=False)
    rest, i = [], 0
    valued = {"--confirm": "confirm", "--impl": "impl", "--tail": "tail", "--head": "head", "--timeout-s": "timeout_s",
              "--allow-display": "allow_display", "--foreign-ok": "foreign_ok"}
    bools = {"--dry-run": "dry_run", "--detach": "detach", "--allow-hybrid": "allow_hybrid", "--json": "json"}
    while i < len(argv):
        a = argv[i]
        if a == "--":
            rest += argv[i + 1:]
            break
        k, eq, v = a.partition("=")
        if a in bools:
            o[bools[a]] = True
        elif k in valued:
            if not eq:
                i += 1
                if i >= len(argv):
                    raise Stop("USAGE", "%s needs a value" % k)
                v = argv[i]
            key = valued[k]
            if key in ("tail", "head", "timeout_s"):
                try:
                    n = int(float(v))
                except ValueError:
                    n = -1
                if n < 0 or (key != "timeout_s" and n > 1000) or (key == "timeout_s" and not 1 <= n <= 7200):
                    raise Stop("USAGE", "%s: integer in range (tail/head 0..1000, timeout-s 1..7200)" % k)
                o[key] = n
            elif isinstance(o[key], list):
                o[key].append(v)
            else:
                o[key] = v
        else:
            rest.append(a)
        i += 1
    o["impl"] = {"claude": "ref", "gemini": "swarm"}.get(o["impl"], o["impl"])
    if o["impl"] not in ("ref", "swarm"):
        raise Stop("USAGE", "--impl ref|swarm")
    return o, rest


def check_required(key, rest):
    t = design_tools().get(key)
    if not t:
        return
    pos = t.get("positional") or []
    npos = 0
    i = 0
    while i < len(rest):  # count leading positionals
        if rest[i].startswith("--"):
            break
        npos += 1
        i += 1
    miss = []
    for r in t["inputSchema"].get("required", []):
        if r == "confirm":
            continue
        f = "--" + r.replace("_", "-")
        if r in pos and pos.index(r) < npos:
            continue
        if not any(a == f or a.startswith(f + "=") for a in rest):
            miss.append(f)
    if miss:
        raise Stop("USAGE", "missing required: %s" % " ".join(miss), {"missing": miss}, ["vp sys help " + key])


def main(argv):
    if argv and argv[0] == "_mcpcall":
        return _mcpcall(*argv[1:4])
    if argv and argv[0] == "_enqueue":
        return _enqueue(*argv[1:4])
    JSON_ONLY[0] = "--json" in argv and "--" not in argv[:argv.index("--json")]
    if not argv or argv[0] in ("-h", "--help", "help"):
        nouns = sorted({n for n, _ in VERBS})
        return emit("OK", {"usage": "vp <noun> <verb> [positional...] [--flag value...] [--dry-run] [--confirm <id>] [--timeout-s S] [--json]",
                           "nouns": nouns, "commands": len(VERBS), "version": VERSION},
                    ["vp sys help", "vp sys help <noun> <verb>", "vp sys doctor", "vp docs card", "vp docs route '<intent>'"],
                    human=["vp %s (%d commands). nouns: %s" % (VERSION, len(VERBS), " ".join(nouns)), "index: vp sys help [noun [verb]]"])
    try:
        noun = argv[0]
        verb = argv[1] if len(argv) > 1 else ""
        spec = VERBS.get((noun, verb))
        if not spec:
            verbs = sorted(v for (a, v) in VERBS if a == noun)
            raise Stop("USAGE", "unknown command: vp %s %s" % (noun, verb),
                       {"noun": noun, "verbs": verbs, "nouns": [] if verbs else sorted({a for a, _ in VERBS})},
                       ["vp sys help " + noun if verbs else "vp sys help", "vp docs route %s" % _q((noun + " " + verb).strip())])
        key = "%s %s" % (noun, verb)
        o, rest = parse(argv[2:])
        guard(rest, o, spec)
        if not spec.get("novalidate") and key != "queue enqueue":
            check_required(key, rest)
        if spec.get("job"):
            job_guard(o, flag(rest, "--job"), *spec["job"])
        plan = spec["build"](o, rest)
        guard([a for a in plan["argv"][1:] if a != SELF], o, spec)
        base = {"cmd": key, "class": spec["kind"], "argv": plan["argv"]}
        if plan.get("steps"):
            base["steps"] = plan["steps"]
        if plan.get("cwd"):
            base["cwd"] = plan["cwd"]
        if plan.get("env"):
            base["env"] = sorted(plan["env"])  # names only, never values
        if spec.get("untrusted"):
            base["untrusted"] = True
        need = plan.get("need")
        missing = bool(need) and not os.path.exists(need)
        expected = spec["confirm"](o, rest) if spec["kind"] == DD else None
        again = ("vp %s %s" % (key, " ".join(_q(a) for a in rest))).strip()
        if o["dry_run"]:
            base.update(entry_point=need, entry_point_exists=not missing)
            if WOULD_REFUSE:
                base["would_refuse"] = sorted(set(WOULD_REFUSE))
            nxt = []
            if spec["kind"] == DD:
                base["confirm_id"] = expected
                nxt.append("%s --confirm %s" % (again, expected))
            return emit("DRY_RUN", base, nxt, human=["DRY_RUN vp %s -> %s" % (key, " ".join(plan["argv"])[:200])])
        if spec["kind"] == DD and (not expected or o["confirm"] != str(expected)):
            base.update(confirm_id=expected, given=o["confirm"])
            raise Stop("CONFIRM_REQUIRED", "vp %s is destructive: repeat with --confirm %s" % (key, expected), base,
                       ["%s --confirm %s" % (again, expected), again + " --dry-run"])
        if missing:
            dep = any(need == v or need.startswith(v.rstrip("/") + "/") for k_, v in P.items() if k_ != "state_dir")
            code = plan.get("need_code") or ("DEPENDENCY" if dep else "NOT_FOUND")
            base["missing"] = need
            raise Stop(code, "AUSENTE: %s not found: %s" % ("dependency" if code == "DEPENDENCY" else "target", need), base,
                       ["vp capsule start --dry-run"] if code == "NO_TAKE" else ["vp sys doctor"])
        pn = list(plan.get("nxt") or [])
        if plan.get("internal"):
            if noun == "sys":
                base.pop("argv", None)
            base.update(plan["internal"]())
            return emit("OK", base, pn, human=["OK vp " + key])
        env, scrubbed = child_env(spec, plan.get("env"))
        if scrubbed:
            base["env_scrubbed"] = scrubbed
        if o["detach"]:
            base.update(detach(plan, env))
            return emit("OK", base, ["vp out read %s" % base["log"], "vp record stop --pid %d --confirm %d" % (base["pid"], base["pid"]), "vp sys jobs"],
                        human=["OK detached pid %d, log %s" % (base["pid"], base["log"])])
        t0 = time.time()
        res = run_child(plan, o, env)
        base["ms"] = int((time.time() - t0) * 1000)
        prev = [redact(x)[:2000] for x in res.pop("preview", [])]
        if res.get("spool"):
            base["spool"] = {k: res.get(k) for k in ("lines", "bytes", "sha256")}
            base["spool"]["path"] = res["spool"]
        base["spooler"] = res.get("spooler")
        cj = child_json(res)
        if isinstance(cj, dict):
            cj = redact_obj(cj)
            if len(json.dumps(cj)) <= 6000:
                base["child"] = cj
            else:
                base["child_keys"] = sorted(cj)[:40]
                base["child_head"] = {k: cj[k] for k in ("ok", "code", "rc", "reason") if k in cj}
        else:
            cj = None
            base["preview"] = [x[:240] for x in prev[-20:]]
        nxt = []
        if res.get("spool") and (res.get("lines", 0) > len(prev) or "child" not in base):
            nxt.append("vp out read %s 1:60" % res["spool"])
        if cj and isinstance(cj.get("next"), list):
            nxt += [str(x) for x in cj["next"]][:5]
        nxt += pn
        human = [x[:240] for x in prev[-o["tail"]:]] if o["tail"] else []
        if res["rc"] == 124:
            base["child_stopped"] = True
            return emit("TIMEOUT", base, nxt, human + ["TIMEOUT vp %s after %ss" % (key, o["timeout_s"])])
        if res["rc"] != 0 or (cj and cj.get("ok") is False):
            base["upstream_rc"] = res["rc"]
            ccode = str(cj.get("code")) if cj and cj.get("code") else None
            if ccode:
                base["upstream_code"] = ccode
            if ccode and RC.get(ccode, 0) != 0:
                code = ccode
            elif res["rc"] == 1 and spec.get("fail_code"):
                code = spec["fail_code"]
            elif res["rc"] == 1 or (cj and cj.get("ok") is False):
                code = "FAIL"
            else:
                code = "UPSTREAM"
            return emit(code, base, nxt, human + ["%s vp %s upstream_rc=%s" % (code, key, res["rc"])])
        tr = plan.get("track")
        if tr == "pid_stdout":
            pids = [x.strip() for x in prev if x.strip().isdigit()]
            if pids:
                ledger_add("pid", pids[-1], argv=plan["argv"][:6], start=_pid_start(pids[-1]))
                base["pid"] = int(pids[-1])
                nxt.append("vp record stop --pid %s --confirm %s" % (pids[-1], pids[-1]))
        elif tr:
            ledger_add(tr[0], tr[1])
            nxt.append("vp vision look --job %s" % tr[1])
            nxt.append("vp vision stop --job %s --confirm %s" % (tr[1], tr[1]))
        return emit("OK", base, nxt, human + ["OK vp " + key])
    except Stop as s:
        d = dict(s.data)
        d["error"] = s.msg
        return emit(s.code, d, s.nxt, human=["%s: %s" % (s.code, s.msg)], rc=s.rc)
    except Exception as e:  # never a traceback on stdout
        return emit("UPSTREAM", {"error": "internal %s: %s" % (type(e).__name__, e)}, human=["UPSTREAM: internal error: %s" % e])


def _q(a):
    return a if re.match(r"^[A-Za-z0-9_./:=@%+,-]+$", a) else "'" + a.replace("'", "'\\''") + "'"


# ---------------------------------------------------------------- helpers run as children (spooled like any other)
def _mcpcall(server, tool, args_json):
    """One MCP tools/call over stdio against a line-delimited JSON-RPC server; prints the result."""
    p = subprocess.Popen(["python3", "-I", server], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    msgs = [
        {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2024-11-05", "capabilities": {},
                                                                        "clientInfo": {"name": "vp", "version": VERSION}}},
        {"jsonrpc": "2.0", "method": "notifications/initialized"},
        {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": tool, "arguments": json.loads(args_json)}},
    ]
    try:
        for m in msgs:
            p.stdin.write(json.dumps(m) + "\n")
            p.stdin.flush()
        for line in p.stdout:
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if r.get("id") == 2:
                if "error" in r:
                    print(json.dumps({"ok": False, "code": "MCP_ERROR", "error": r["error"]}))
                    return 1
                res = r.get("result", {})
                texts = [c.get("text", "") for c in res.get("content", []) if isinstance(c, dict)]
                for t in texts[:-1]:
                    print(t)
                last = texts[-1] if texts else ""
                bad = bool(res.get("isError"))
                try:
                    payload = json.loads(last)
                except ValueError:
                    payload = {"text": last}
                if not isinstance(payload, dict):
                    payload = {"result": payload}
                payload.setdefault("ok", not bad)
                if bad:
                    payload["ok"] = False
                print(json.dumps(payload))
                return 1 if bad else 0
        print(json.dumps({"ok": False, "code": "MCP_NO_REPLY", "error": "server closed without answering"}))
        return 1
    finally:
        try:
            p.stdin.close()
        except OSError:
            pass
        try:
            p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            p.terminate()


def _enqueue(rt, agent, path):
    """Contract write (ref_broker README): RT/intents/<agent_id>/<event_id>.json via tmp + rename."""
    def fail(msg):
        print(json.dumps({"ok": False, "code": "BAD_INTENT", "error": msg}))
        return 1
    if not re.match(r"^[A-Za-z0-9_.-]+$", agent):
        return fail("agent id must be [A-Za-z0-9_.-]+")
    try:
        if os.path.getsize(path) > 262144:
            return fail("intent over 256 KiB")
        with open(path) as f:
            intent = json.load(f)
    except (OSError, ValueError) as e:
        return fail("unreadable intent: %s" % e)
    if not isinstance(intent, dict):
        return fail("intent must be a JSON object")
    if intent.get("agent_id", agent) != agent:
        return fail("intent agent_id differs from --agent")
    eid = str(intent.get("event_id") or "")
    if not re.match(r"^[A-Za-z0-9_.-]+$", eid):
        return fail("intent needs event_id matching [A-Za-z0-9_.-]+")
    if not os.path.isdir(rt):
        return fail("RT does not exist: %s" % rt)
    d = os.path.join(rt, "intents", agent)
    os.makedirs(d, exist_ok=True)
    dst = os.path.join(d, eid + ".json")
    if os.path.exists(dst):
        return fail("intent already enqueued: %s" % dst)
    tmp = os.path.join(d, ".%s.tmp.%d" % (eid, os.getpid()))
    body = json.dumps(intent, sort_keys=True).encode()
    with open(tmp, "wb") as f:
        f.write(body)
        f.flush()
        os.fsync(f.fileno())
    os.rename(tmp, dst)
    print(json.dumps({"ok": True, "code": "OK", "path": dst, "sha256": hashlib.sha256(body).hexdigest(), "event_id": eid}))
    return 0


