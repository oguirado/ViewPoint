def mcp_tool(tool):
    """Call one tool of the ViewPoint MCP server over stdio (vp _mcpcall helper)."""
    def build(o, rest):
        args = {}
        rest = list(rest)
        raw = take(rest, "--args")
        if raw:
            try:
                args.update(json.loads(raw))
            except ValueError:
                raise Stop("USAGE", "--args must be a JSON object")
        i = 0
        while i < len(rest):
            a = rest[i]
            if not a.startswith("--"):
                raise Stop("USAGE", "tool arguments are --name value pairs or --args JSON", {"arg": a})
            k = a[2:].replace("-", "_")
            if "=" in k:
                k, v = k.split("=", 1)
                i += 1
            elif i + 1 < len(rest) and not rest[i + 1].startswith("--"):
                v = rest[i + 1]
                i += 2
            else:
                v, i = "true", i + 1
            try:
                args[k] = json.loads(v)
            except ValueError:
                args[k] = v
        return dict(argv=["python3", "-I", SELF, "_mcpcall", P["vp_mcp"], tool, json.dumps(args, sort_keys=True)],
                    env={"VP_MCP_SESSION": os.environ.get("VP_MCP_SESSION") or P["vp_mcp_session"]}, need=P["vp_mcp"])
    return build


