# ---------------------------------------------------------------- redaction
_SECRET_RES = [
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?(?:-----END [A-Z ]*PRIVATE KEY-----|$)", re.S),
    re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{5,}"),
    re.compile(r"\b(?:sk|pk|rk)-[A-Za-z0-9_-]{16,}"),
    re.compile(r"\bgh[pousr]_[A-Za-z0-9]{20,}"),
    re.compile(r"\bAIza[0-9A-Za-z_-]{30,}"),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"\bya29\.[0-9A-Za-z_.-]{20,}"),
    re.compile(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]{8,}"),
]
_KV_RE = re.compile(
    r"(?i)([A-Za-z0-9_.-]*(?:api[_-]?key|secret|token|passw(?:or)?d|authorization|cookie|credential)[A-Za-z0-9_-]*"
    r"\\?[\"']?\s*[:=]\s*\\?[\"']?)([^\s\"',;}\\]{4,})")
REDACTIONS = [0]


def redact(s):
    if not isinstance(s, str):
        return s

    def hit(_m):
        REDACTIONS[0] += 1
        return "[REDACTED]"

    def kv(m):
        if m.group(2).startswith("[REDACTED"):
            return m.group(0)
        REDACTIONS[0] += 1
        return m.group(1) + "[REDACTED]"

    for r in _SECRET_RES:
        s = r.sub(hit, s)
    return _KV_RE.sub(kv, s)


def redact_obj(o):
    if isinstance(o, str):
        return redact(o)
    if isinstance(o, list):
        return [redact_obj(x) for x in o]
    if isinstance(o, dict):
        out = {}
        for k, v in o.items():
            if isinstance(v, str) and re.search(r"(?i)api[_-]?key|secret|token|passw|authorization|cookie|credential", str(k)) and v:
                REDACTIONS[0] += 1
                out[k] = "[REDACTED]"
            else:
                out[k] = redact_obj(v)
        return out
    return o


# ---------------------------------------------------------------- receipt
class Stop(Exception):
    def __init__(self, code, msg, data=None, nxt=None, rc=None):
        self.code, self.msg, self.data, self.nxt, self.rc = code, msg, data or {}, nxt or [], rc


def emit(code, data, nxt=None, human=None, rc=None):
    rc = RC.get(code, 9) if rc is None else rc
    data = redact_obj(data)
    nxt = [redact(x) for x in (nxt or [])]
    if REDACTIONS[0]:
        data["redactions"] = REDACTIONS[0]
    rec = {"ok": rc == 0, "code": code, "rc": rc, "data": data, "next": nxt}
    line = json.dumps(rec, ensure_ascii=False, separators=(",", ":"))
    if len(line) > 12000:  # bounded receipt: drop the bulky parts, keep pointers
        for k in ("child", "preview", "verbs"):
            if k in data:
                data[k] = "[omitted: receipt over 12000 chars; page data.spool with `vp out read`]"
        line = json.dumps(rec, ensure_ascii=False, separators=(",", ":"))
    if human and not JSON_ONLY[0]:
        text = "".join(redact(h)[:240] + "\n" for h in human[-40:])
        sys.stdout.write(text[-4096:])
    sys.stdout.write(line + "\n")
    sys.stdout.flush()
    return rc


# ---------------------------------------------------------------- guards
_DISPLAY1 = re.compile(r"(?:^|[\s=])(:1(?:\.\d+)?)(?=$|\s)")
_HYBRID = "/dev/shm/vqa-cu/hybrid"
_SECRET_PATH = re.compile(
    r"(?i)(/\.gemini(/|$)|/\.ssh(/|$)|/\.aws(/|$)|/\.netrc$|(^|/)\.env(\.|$)|id_(rsa|ed25519|ecdsa)|"
    r"(^|/)[^/]*(credential|secret|token|apikey|api_key|oauth|cookies)[^/]*$|\.pem$|\.key$)")
_FORBIDDEN_FLAGS = {"--kill-all": "stop by PID only: use `vp job stop --pid N`",
                    "--dangerously-skip-permissions": "not passed through vp"}


def guard(args, o, spec):
    for a in args:
        m = _DISPLAY1.search(a)
        if m and m.group(1) not in o["allow_display"]:
            raise Stop("FORBIDDEN_DISPLAY", "display :1 is the operator's desktop; refused without --allow-display :1",
                       {"arg": a})
        if a in _FORBIDDEN_FLAGS:
            raise Stop("USAGE", _FORBIDDEN_FLAGS[a], {"arg": a})
        if _HYBRID in a and not o["allow_hybrid"]:
            raise Stop("FORBIDDEN_PATH", "%s belongs to the hybrid lane; refused without --allow-hybrid" % _HYBRID, {"arg": a})
        if not spec.get("secret_ok") and (a.startswith("/") or a.startswith("~") or a.startswith(".")) and _SECRET_PATH.search(a):
            raise Stop("SECRET_PATH", "credential-looking path refused; vp never reads tokens, keys or auth files", {"arg": a})


def child_env(spec, extra=None):
    env = dict(os.environ)
    scrubbed = []
    if not spec.get("operator_display") and _DISPLAY1.search(env.get("DISPLAY", "")):
        env.pop("DISPLAY")
        scrubbed.append("DISPLAY")
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    env.update(extra or {})
    return env, scrubbed


# ---------------------------------------------------------------- ledger (jobs started through vp)
def _ledger_path():
    return os.path.join(P["state_dir"], "jobs.json")  # JSON lines, append-only


def ledger_add(kind, ident, **kw):
    os.makedirs(P["state_dir"], mode=0o700, exist_ok=True)
    row = dict(kind=kind, id=str(ident), ts=int(time.time()), **kw)
    with open(_ledger_path(), "a") as f:
        f.write(json.dumps(row, sort_keys=True) + "\n")


def ledger_rows():
    try:
        with open(_ledger_path()) as f:
            return [json.loads(x) for x in f if x.strip()]
    except (OSError, ValueError):
        return []


def ledger_has(kind, ident):
    return any(r.get("kind") == kind and r.get("id") == str(ident) for r in ledger_rows())


def flag(rest, name, default=None):
    """Value of --name in the passthrough args (does not consume)."""
    for i, a in enumerate(rest):
        if a == name and i + 1 < len(rest):
            return rest[i + 1]
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return default


def take(rest, name, required=False, usage=""):
    """Consume --name VALUE from rest."""
    for i, a in enumerate(rest):
        if a == name and i + 1 < len(rest):
            v = rest[i + 1]
            del rest[i:i + 2]
            return v
        if a.startswith(name + "="):
            del rest[i]
            return a.split("=", 1)[1]
    if required:
        raise Stop("USAGE", "missing %s" % name, {"usage": usage})
    return None


