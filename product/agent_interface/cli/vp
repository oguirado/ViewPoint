def b_human(kind):
    def build(o, rest):
        r = list(rest)
        rt, room, by = take(r, "--rt", True), take(r, "--room", True), take(r, "--by", True)
        if kind == "handback":
            reason = take(r, "--reason", True)
            steps = [["queue", "control", "--rt", rt, "--op", "stop", "--by", by, "--reason", reason],
                     ["room", "post", "--room", room, "--agent", by, "--act", "handoff", "--text", reason]]
            nxt = ["vp capsule view", "vp human resume --rt %s --room %s --by %s --handoff-id <id from the room post>" % (rt, room, by)]
        else:
            take(r, "--handoff-id", True)
            steps = [["room", "status", "--room", room],
                     ["queue", "control", "--rt", rt, "--op", "reconcile", "--by", by],
                     ["queue", "control", "--rt", rt, "--op", "resume", "--by", by]]
            nxt = ["vp queue status --rt %s" % rt]

        def run():
            done = []
            for st in steps:
                p = subprocess.run(["python3", "-I", SELF, *st, "--json"], capture_output=True, text=True)
                try:
                    rec = json.loads(p.stdout.strip().splitlines()[-1])
                except (ValueError, IndexError):
                    rec = {"ok": False, "code": "UPSTREAM", "rc": 9}
                done.append({"step": "vp " + " ".join(st[:2]), "ok": rec.get("ok"), "code": rec.get("code"), "rc": rec.get("rc")})
                if not rec.get("ok"):
                    raise Stop(rec.get("code") or "UPSTREAM", "step failed: vp %s" % " ".join(st[:2]), {"steps": done}, rc=rec.get("rc"))
            return {"steps": done}
        return dict(internal=run, argv=["vp"] + steps[0], steps=[["vp"] + s for s in steps], nxt=nxt)
    return build


