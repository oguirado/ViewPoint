def b_record_stop(o, rest):
    rest = list(rest)
    pid = take(rest, "--pid", True, "vp record stop --pid N [--signal INT|TERM] --confirm N")
    sig = (take(rest, "--signal") or "INT").upper()
    if not pid.isdigit() or int(pid) < 2 or sig not in ("INT", "TERM"):
        raise Stop("USAGE", "--pid N (N>1) [--signal INT|TERM]")
    row = [r for r in ledger_rows() if r.get("kind") == "pid" and r.get("id") == pid]
    if not row and pid not in o["foreign_ok"]:
        raise Stop("FOREIGN_JOB", "pid %s was not started through vp; pass --foreign-ok %s to insist" % (pid, pid), {"pid": pid}, ["vp sys jobs"])
    return dict(internal=lambda: _kill(int(pid), row[-1].get("start") if row else None, sig), argv=["kill", "-" + sig, pid])


def _pid_start(pid):
    try:
        with open("/proc/%s/stat" % pid) as f:
            return f.read().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def _kill(pid, start, sig="INT"):
    now = _pid_start(pid)
    if now is None or (start and now != start):
        raise Stop("NOT_FOUND", "pid %d is not the recorded process any more" % pid, {"pid": pid})
    os.kill(pid, getattr(signal, "SIG" + sig))
    return {"pid": pid, "signal": sig}


def b_enqueue(o, rest):
    rest = list(rest)
    rt = take(rest, "--rt", True, "vp queue enqueue --rt RT --agent A --event-id E ...")
    if o["impl"] == "swarm":
        kind = take(rest, "--kind") or "script"
        if kind not in ("script", "gui"):
