    },
    {
     "volume": "rt",
     "subpath": "frames",
     "dst": "/rt/frames",
     "mode": "ro"
    },
    {
     "volume": "rt",
     "subpath": "events.jsonl",
     "dst": "/rt/events.jsonl",
     "mode": "ro"
