    {
     "volume": "rt",
     "subpath": "claims.json",
     "dst": "/rt/claims.json",
     "mode": "ro"
    },
    {
     "volume": "rt",
     "subpath": "bids/modeler-agent",
     "dst": "/rt/bids/modeler-agent",
     "mode": "rw"
    }
   ],
   "env": {
    "VP_SWARM_RT": "/rt",
    "VP_AGENT_ID": "modeler-agent"
   },
   "input": false,
   "health": {
    "kind": "heartbeat_file",
    "cmd": [
     "/opt/vp/health_heartbeat",
     "--file",
     "/tmp/heartbeat",
     "--max-age-ms",
     "30000"
    ],
    "interval_s": 10,
    "timeout_s": 5,
    "retries": 3,
    "start_period_s": 20
