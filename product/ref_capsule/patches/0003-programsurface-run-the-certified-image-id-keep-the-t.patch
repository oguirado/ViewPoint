diff --git a/src/programsurface/hardening_test.go b/src/programsurface/hardening_test.go
index bf81219..555b134 100644
--- a/src/programsurface/hardening_test.go
+++ b/src/programsurface/hardening_test.go
@@ -45,7 +45,38 @@ func TestContainerVectorHealthAndLogBounds(t *testing.T) {
 			t.Fatalf("missing %v in %q", want, got)
 		}
 	}
-	if got[len(got)-1] != p.Image {
-		t.Fatal("image must stay the last argument")
+	if last := got[len(got)-1]; last != p.Image && last != p.ImageID {
+		t.Fatal("the image reference must stay the last argument")
+	}
+}
+
+// A catalogued program runs the image CONTENT it was certified with: the vector carries the local
+// image ID, so re-tagging name:version to other bytes cannot change what starts.
+func TestContainerVectorRunsPinnedImageID(t *testing.T) {
+	largeHostProfile(t)
+	tiles := []Tile{{"w1", 0, 0, 640, 900}}
+	p, err := Lookup("notepad")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !imageIDRE.MatchString(p.ImageID) {
+		t.Fatalf("catalogued notepad has no pinned image id: %q", p.ImageID)
+	}
+	got := RunArgs("srf-pg-test", "/p", "/v", p, tiles, "")
+	if got[len(got)-1] != p.ImageID || !pairAt(got, "--label", "srf.image="+p.Image) {
+		t.Fatalf("vector must end with the image id and label the tag: %q", got)
+	}
+	// Negative controls: a malformed pin is refused, an unpinned program keeps the tag.
+	for _, bad := range []string{"sha256:abc", "6055ac9eefd5", "sha256:" + string(make([]byte, 64)), p.Image} {
+		q := p
+		q.ImageID = bad
+		if q.Validate() == nil || RunArgs("srf-pg-test", "/p", "/v", q, tiles, "") != nil {
+			t.Fatalf("malformed image id accepted: %q", bad)
+		}
+	}
+	q := p
+	q.ImageID = ""
+	if got := RunArgs("srf-pg-test", "/p", "/v", q, tiles, ""); got[len(got)-1] != p.Image {
+		t.Fatalf("unpinned program must run the tag: %q", got)
 	}
 }
diff --git a/src/programsurface/launch.go b/src/programsurface/launch.go
index 42bed3a..c5b35dc 100644
--- a/src/programsurface/launch.go
+++ b/src/programsurface/launch.go
@@ -86,6 +86,10 @@ func runArgs(container, profile, viewDir string, p Program, tiles []Tile, proxy
 	if p.A11y {
 		args = append(args, "--env", "NO_AT_BRIDGE=0")
 	}
+	if p.ImageID != "" {
+		// Content identity: the tag is kept as a label for operators, the runtime reference is the id.
+		return append(args, "--label", "srf.image="+p.Image, p.ImageID)
+	}
 	return append(args, p.Image)
 }
 
