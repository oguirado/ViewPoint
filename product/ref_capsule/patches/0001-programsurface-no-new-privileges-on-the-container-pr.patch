-			want := []string{"docker", "run", "-d", "--name", "srf-pg-test", "--user", "10001:10001", "--read-only", "--cap-drop", "ALL", "--network", string(network)}
+			want := []string{"docker", "run", "-d", "--name", "srf-pg-test", "--user", "10001:10001", "--read-only", "--cap-drop", "ALL", "--security-opt", "no-new-privileges", "--network", string(network)}
 			if network == NetProxy {
 				want[len(want)-1] = "srf-idnet"
 			}
