diff --git a/src/cubook/capture/runargs_bounds_test.go b/src/cubook/capture/runargs_bounds_test.go
new file mode 100644
index 0000000..4fc5859
--- /dev/null
+++ b/src/cubook/capture/runargs_bounds_test.go
@@ -0,0 +1,22 @@
+package capture
+
+import (
+	"strings"
+	"testing"
+)
+
+// The CU vector must bound swap and the /tmp tmpfs explicitly: `--memory 4g` alone lets the
+// container use as much swap again, and an unsized tmpfs defaults to half of host RAM.
+func TestRunArgsBoundsSwapAndTmp(t *testing.T) {
+	cfg := RunConfig{Slot: 3, Image: "opensuperficies-desktop-arm64:1.0.0", Iso: strings.Repeat("ab", 16), FBDir: "/dev/shm/vqa-ramws/opensuperficies/os-cu-0/r1/fb", Entrypoint: "/repo/docker/cu/entrypoint-cu.sh"}
+	joined := " " + strings.Join(RunArgs(cfg), " ") + " "
+	for _, want := range []string{" --memory 4g ", " --memory-swap 4g ", " --tmpfs /tmp:rw,nosuid,nodev,size=1g "} {
+		if !strings.Contains(joined, want) {
+			t.Fatalf("missing %q in%s", want, joined)
+		}
+	}
+	// Negative control: no unsized /tmp tmpfs survives.
+	if strings.Contains(joined, " /tmp:rw,nosuid,nodev ") {
+		t.Fatal("unsized /tmp tmpfs")
+	}
+}
