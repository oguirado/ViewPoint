+# @anchor:wa.act.actor.execute_fenced
+def execute_fenced(lock, lease, path, action, executor, budget_ns=0):
+    """Dispatch ``action`` on ``path`` through ``executor`` under a live lease.
+
+    Every executor call (CDP, AX, coordinates/X11) must enter here or through
+    ``LeasedActorLock.actuate``; a stale holder gets ``LeaseRefused`` instead.
+    """
+    if path not in PATHS:
+        raise ValueError("unknown action path %r" % (path,))
+    return lock.actuate(lease, executor, path, action, budget_ns=budget_ns)
